<%- include('partials/header', { title: 'Dashboard | D.E.T System', page: 'dashboard' }) %>

<style>
    :root {
        --det-border: rgba(176, 191, 150, 0.15);
    }

    .dashboard-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .quick-nav {
        background: var(--det-card);
        border: 1px solid var(--det-border);
        border-radius: 12px;
        padding: 8px 16px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .quick-nav-label {
        color: #94a3b8;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
        margin-right: 8px;
    }
    .quick-nav a {
        color: #cbd5e1;
        text-decoration: none;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid transparent;
    }
    .quick-nav a:hover {
        color: #fff;
        background: rgba(255,255,255,0.05);
        border-color: var(--det-border);
    }
    .quick-nav a.active-page {
        background: rgba(176, 191, 150, 0.15);
        color: var(--det-green);
        border-color: rgba(176, 191, 150, 0.3);
        font-weight: 600;
    }
    .quick-nav a i { font-size: 13px; }

    .welcome-hero {
        background: linear-gradient(135deg, var(--det-card) 0%, #241f1f 100%);
        border: 1px solid var(--det-border);
        border-radius: 16px;
        padding: 30px 35px;
        margin-bottom: 28px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0,0,0,0.2);
    }
    .welcome-hero::before {
        content: '';
        position: absolute;
        top: -50px;
        right: -50px;
        width: 200px;
        height: 200px;
        background: radial-gradient(circle, rgba(176,191,150,0.08) 0%, transparent 70%);
        border-radius: 50%;
    }
    .welcome-content {
        position: relative;
        z-index: 1;
    }
    .welcome-hero h1 {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 6px;
        letter-spacing: -0.5px;
    }
    .welcome-hero .subtitle {
        color: #94a3b8;
        font-size: 14px;
        margin-bottom: 0;
    }

    .status-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 28px;
    }
    .status-card {
        background: var(--det-card);
        border: 1px solid var(--det-border);
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        transition: all 0.2s;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .status-card:hover {
        transform: translateY(-2px);
        border-color: rgba(176, 191, 150, 0.3);
    }
    .status-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }
    .status-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #94a3b8;
        font-weight: 600;
        margin-bottom: 3px;
    }
    .status-value {
        font-size: 16px;
        font-weight: 700;
        color: #fff;
    }

    .profile-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 12px;
    }
    .profile-btn {
        background: rgba(255,255,255,0.05);
        border: 1px solid var(--det-border);
        color: #cbd5e1;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .profile-btn:hover {
        background: rgba(176,191,150,0.1);
        color: #fff;
        border-color: var(--det-green);
    }

    .integration-card {
        background: var(--det-card);
        border: 1px solid var(--det-border);
        border-radius: 14px;
        padding: 28px;
        margin-bottom: 28px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    }
    .key-display {
        background: var(--det-dark);
        border: 1px dashed var(--det-green);
        border-radius: 8px;
        padding: 14px 20px;
        font-family: 'Courier New', monospace;
        font-size: 20px;
        letter-spacing: 3px;
        color: var(--det-green);
        cursor: pointer;
        transition: all 0.3s;
        text-align: center;
    }
    .key-display.blurred {
        filter: blur(6px);
        border-color: #475569;
        color: #94a3b8;
        user-select: none;
    }
    .key-display:hover { border-style: solid; }

    .feed-card {
        background: var(--det-card);
        border: 1px solid var(--det-border);
        border-radius: 14px;
        padding: 28px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    }
    .metric-mini {
        background: var(--det-dark);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 10px;
        padding: 16px;
        text-align: center;
    }
    .metric-mini .label {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #94a3b8;
        font-weight: 600;
        margin-bottom: 6px;
    }
    .metric-mini .value {
        font-size: 20px;
        font-weight: 700;
        color: #fff;
    }
    .metric-mini .value.accent { color: var(--det-green); }

    .btn-det {
        background: var(--det-green);
        color: var(--det-dark);
        font-weight: 600;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        transition: all 0.2s;
        cursor: pointer;
    }
    .btn-det:hover {
        background: var(--det-green-hover);
        color: #000;
        transform: translateY(-1px);
    }
    .btn-outline-det {
        background: transparent;
        color: var(--det-green);
        border: 1px solid var(--det-green);
        font-weight: 600;
        padding: 10px 20px;
        border-radius: 8px;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-block;
        text-align: center;
    }
    .btn-outline-det:hover {
        background: rgba(176, 191, 150, 0.1);
        color: #fff;
        border-color: #fff;
    }

    .alert-custom {
        border-radius: 8px;
        padding: 14px 18px;
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* Modal styles */
    .modal-content {
        background-color: var(--det-card) !important;
        color: #fff !important;
        border: 1px solid var(--det-border);
        border-radius: 14px;
    }
    .modal-header { border-bottom: 1px solid rgba(255,255,255,0.05); }
    .modal-footer { border-top: 1px solid rgba(255,255,255,0.05); }
    .form-control, .form-select {
        background-color: rgba(0,0,0,0.2) !important;
        border: 1px solid rgba(255,255,255,0.1) !important;
        color: #fff !important;
        padding: 12px;
        border-radius: 6px;
    }
    .form-control:focus, .form-select:focus {
        border-color: var(--det-green) !important;
        box-shadow: 0 0 0 0.25rem rgba(176,191,150,0.15) !important;
    }
    .btn-close-white { filter: invert(1) grayscale(100%) brightness(200%); }

    .password-requirements {
        background: rgba(0,0,0,0.2);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 6px;
        padding: 12px 15px;
        margin-top: 8px;
        margin-bottom: 8px;
        font-size: 11px;
    }
    .password-requirements .req-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 3px 0;
        color: #64748b;
        transition: color 0.3s;
    }
    .password-requirements .req-item.met {
        color: #22c55e;
    }
    .password-requirements .req-item i { font-size: 14px; width: 16px; }

    @media (max-width: 768px) {
        .dashboard-container { padding: 0 12px; }
        .welcome-hero { padding: 22px 20px; }
        .welcome-hero h1 { font-size: 22px; }
        .quick-nav { gap: 4px; padding: 10px 12px; }
        .quick-nav a { padding: 5px 10px; font-size: 11px; }
    }
</style>

<div class="dashboard-container" style="margin-top: 30px; margin-bottom: 60px;">

    <!-- =========================================
         FLASH MESSAGES
    ========================================= -->
    <% if(success && success.length > 0) { %>
        <div class="alert-custom" style="background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.3); color: #22c55e;">
            <i class="bi bi-check-circle-fill"></i> <%= success %>
        </div>
    <% } %>
    <% if(error && error.length > 0) { %>
        <div class="alert-custom" style="background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #ef4444;">
            <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
        </div>
    <% } %>

    <!-- =========================================
         QUICK NAVIGATION BAR
    ========================================= -->
    <div class="quick-nav">
        <span class="quick-nav-label">Navigate:</span>
        <a href="/"><i class="bi bi-house"></i> Home</a>
        <a href="/dashboard" class="active-page"><i class="bi bi-speedometer2"></i> Dashboard</a>
        <a href="/pricing"><i class="bi bi-tags"></i> Pricing Plans</a>
        <a href="/training"><i class="bi bi-mortarboard"></i> Training</a>
        <a href="/affiliate"><i class="bi bi-diagram-3"></i> Affiliate</a>
        <a href="/logout" style="color: #ef4444; margin-left: auto;"><i class="bi bi-box-arrow-right"></i> Logout</a>
    </div>

    <!-- =========================================
         WELCOME HERO
    ========================================= -->
    <div class="welcome-hero">
        <div class="welcome-content">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <h1 style="color: #fff;">Welcome, <%= currentUser.username %></h1>
                    <p class="subtitle">Your D.E.T trading environment is ready. Monitor your license and live market data below.</p>
                    <div class="profile-actions">
                        <button class="profile-btn" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                            <i class="bi bi-person-badge"></i> Edit Profile
                        </button>
                        <button class="profile-btn" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
                            <i class="bi bi-shield-lock"></i> Change Password
                        </button>
                    </div>
                </div>
                <div style="display: flex; align-items: center; gap: 8px; background: rgba(176,191,150,0.1); border: 1px solid rgba(176,191,150,0.2); padding: 8px 18px; border-radius: 30px;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: #22c55e; display: inline-block;"></span>
                    <span style="color: var(--det-green); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Node Online</span>
                </div>
            </div>
        </div>
    </div>

    <!-- =========================================
         STATUS CARDS
    ========================================= -->
    <div class="status-grid">
        <div class="status-card">
            <div class="status-icon" style="background: rgba(176,191,150,0.12); color: var(--det-green);">
                <i class="bi bi-award"></i>
            </div>
            <div>
                <div class="status-label">D.E.T Plan</div>
                <div class="status-value"><%= currentUser.currentTier || 'None' %></div>
            </div>
        </div>
        <div class="status-card">
            <div class="status-icon" style="background: rgba(56,189,248,0.12); color: #38bdf8;">
                <i class="bi bi-calendar-check"></i>
            </div>
            <div>
                <div class="status-label">Days Remaining</div>
                <div class="status-value">
                    <% 
                        let daysLeft = 0;
                        if(currentUser.licenseExpiry) {
                            daysLeft = Math.ceil((new Date(currentUser.licenseExpiry) - new Date()) / (1000 * 60 * 60 * 24));
                            if(daysLeft < 0) daysLeft = 0;
                        }
                    %>
                    <%= daysLeft %> Days
                </div>
            </div>
        </div>
        <div class="status-card">
            <div class="status-icon" style="background: rgba(245,158,11,0.12); color: #f59e0b;">
                <i class="bi bi-shield-check"></i>
            </div>
            <div>
                <div class="status-label">Account Status</div>
                <div class="status-value">
                    <% if(currentUser.accountLocked) { %>
                        <span style="color: #ef4444;">Locked</span>
                    <% } else if(currentUser.isSuspended) { %>
                        <span style="color: #f59e0b;">Suspended</span>
                    <% } else if(currentUser.licenseKey && daysLeft > 0) { %>
                        <span style="color: #22c55e;">Active</span>
                    <% } else { %>
                        <span style="color: #94a3b8;">Inactive</span>
                    <% } %>
                </div>
            </div>
        </div>
        <div class="status-card">
            <div class="status-icon" style="background: rgba(167,139,250,0.12); color: #a78bfa;">
                <i class="bi bi-clock-history"></i>
            </div>
            <div>
                <div class="status-label">License Expires</div>
                <div class="status-value" style="font-size: 14px;">
                    <%= currentUser.licenseExpiry ? new Date(currentUser.licenseExpiry).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'N/A' %>
                </div>
            </div>
        </div>
    </div>

    <!-- =========================================
         INTEGRATION ID CARD
    ========================================= -->
    <div class="integration-card">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h5 class="fw-bold mb-1" style="color: #fff;">
                    <i class="bi bi-key" style="color: var(--det-green); margin-right: 8px;"></i>Integration ID
                </h5>
                <p style="color: #94a3b8; font-size: 13px; margin: 0;">Your unique 9‑digit key for the CornerStore EA.</p>
            </div>
            <div>
                <% if(currentUser.licenseKey && !currentUser.isSuspended && daysLeft > 0) { %>
                    <span style="background: rgba(176,191,150,0.12); color: var(--det-green); border: 1px solid rgba(176,191,150,0.25); padding: 6px 16px; border-radius: 20px; font-size: 12px; font-weight: 600;">
                        <i class="bi bi-check-circle-fill me-1"></i> Active Key
                    </span>
                <% } else { %>
                    <span style="background: rgba(239,68,68,0.12); color: #ef4444; border: 1px solid rgba(239,68,68,0.25); padding: 6px 16px; border-radius: 20px; font-size: 12px; font-weight: 600;">
                        <i class="bi bi-exclamation-circle-fill me-1"></i> No Active Key
                    </span>
                <% } %>
            </div>
        </div>

        <% if(currentUser.licenseKey && !currentUser.isSuspended && daysLeft > 0) { %>
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <div class="key-display blurred" id="licenseKeyBox" onclick="handleKeyClick()">
                        <%= currentUser.licenseKey %>
                    </div>
                    <small style="color: #94a3b8; display: block; text-align: center; margin-top: 8px;">
                        <i class="bi bi-info-circle me-1"></i> Click to reveal · Click again to copy
                    </small>
                </div>
                <div class="col-lg-5">
                    <div class="d-grid gap-2">
                        <a href="/det-client.zip" class="btn btn-det" style="text-decoration: none; display: block; text-align: center;">
                            <i class="bi bi-download me-2"></i> Download D.E.T
                        </a>
                        <a href="/pricing" class="btn-outline-det">
                            <i class="bi bi-arrow-up-circle me-2"></i> Upgrade Plan
                        </a>
                    </div>
                </div>
            </div>
        <% } else { %>
            <div style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2); border-radius: 10px; padding: 20px; text-align: center;">
                <i class="bi bi-lock-fill" style="font-size: 28px; color: #f59e0b; margin-bottom: 10px; display: block;"></i>
                <p style="color: #f59e0b; font-weight: 600; margin-bottom: 12px;">No active license key found.</p>
                <p style="color: #94a3b8; font-size: 13px; margin-bottom: 16px;">Subscribe to a D.E.T plan to receive your unique Integration ID.</p>
                <a href="/pricing" class="btn btn-det" style="text-decoration: none;">
                    <i class="bi bi-tags me-2"></i> View Plans
                </a>
            </div>
        <% } %>
    </div>

    <!-- =========================================
         LIVE MARKET FEED
    ========================================= -->
    <div class="feed-card">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h5 class="fw-bold mb-1" style="color: #fff;">
                    <i class="bi bi-activity" style="color: var(--det-green); margin-right: 8px;"></i>CornerStore Live Feed
                </h5>
                <p style="color: #94a3b8; font-size: 13px; margin: 0;">Real‑time data from the master trading node.</p>
            </div>
            <span style="background: rgba(176,191,150,0.12); color: var(--det-green); border: 1px solid rgba(176,191,150,0.25); padding: 6px 16px; border-radius: 20px; font-size: 11px; font-weight: 600;">
                <span style="width: 8px; height: 8px; border-radius: 50%; background: #22c55e; display: inline-block; margin-right: 6px;"></span> LIVE
            </span>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-3 col-6">
                <div class="metric-mini">
                    <div class="label">Active Asset</div>
                    <div class="value" id="ea-symbol">--</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="metric-mini">
                    <div class="label">Live Price</div>
                    <div class="value accent" id="ea-price">0.00</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="metric-mini">
                    <div class="label">A.I. Trend</div>
                    <div class="value" id="ea-trend" style="color: #fff;">--</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="metric-mini">
                    <div class="label">Open Trades</div>
                    <div class="value" id="ea-trades" style="color: #fff;">0</div>
                </div>
            </div>
        </div>

        <div>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span style="font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: #94a3b8; font-weight: 600;">Equity Curve (Master)</span>
                <span id="ea-action" style="font-size: 13px; font-weight: 600; color: var(--det-green);">Scanning...</span>
            </div>
            <div style="background: var(--det-dark); border: 1px solid rgba(255,255,255,0.05); border-radius: 10px; padding: 16px;">
                <canvas id="equityChart" style="max-height: 240px;"></canvas>
            </div>
        </div>
    </div>

</div>

<!-- =========================================
     EDIT PROFILE MODAL
========================================= -->
<div class="modal fade" id="editProfileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form action="/profile/update" method="POST">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-person-badge me-2" style="color: var(--det-green);"></i>Edit Profile</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold" style="font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--det-green);">Username</label>
                        <input type="text" class="form-control" value="<%= currentUser.username %>" disabled>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold" style="font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--det-green);">Email Address</label>
                        <input type="email" class="form-control" name="email" value="<%= currentUser.email || '' %>" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold" style="font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--det-green);">WhatsApp</label>
                        <input type="text" class="form-control" name="whatsapp" value="<%= currentUser.whatsapp || '' %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold" style="font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--det-green);">Country</label>
                        <input type="text" class="form-control" name="country" value="<%= currentUser.country || '' %>">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-det">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- =========================================
     CHANGE PASSWORD MODAL
========================================= -->
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form action="/profile/change-password" method="POST" id="changePasswordForm">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-shield-lock me-2" style="color: var(--det-green);"></i>Change Password</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold" style="font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--det-green);">Current Password</label>
                        <input type="password" class="form-control" name="currentPassword" id="currentPassword" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold" style="font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--det-green);">New Password</label>
                        <input type="password" class="form-control" name="newPassword" id="newPassword" minlength="8" required oninput="checkPasswordStrength()">
                        <div class="password-requirements" id="passwordReqs">
                            <div class="req-item" id="req-length"><i class="bi bi-circle"></i> At least 8 characters</div>
                            <div class="req-item" id="req-upperlower"><i class="bi bi-circle"></i> Upper and lowercase letters</div>
                            <div class="req-item" id="req-number"><i class="bi bi-circle"></i> At least one number</div>
                            <div class="req-item" id="req-symbol"><i class="bi bi-circle"></i> At least one symbol (!@#$%^&*)</div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold" style="font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--det-green);">Confirm New Password</label>
                        <input type="password" class="form-control" name="confirmPassword" id="confirmPassword" minlength="8" required>
                        <div id="confirmError" style="color: #ef4444; font-size: 11px; margin-top: 4px; display: none;">Passwords do not match.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-det" id="updatePasswordBtn">Update Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // =========================================
    // INTEGRATION KEY - REVEAL & COPY
    // =========================================
    let keyRevealed = false;
    function handleKeyClick() {
        const box = document.getElementById('licenseKeyBox');
        if (!keyRevealed) {
            box.classList.remove('blurred');
            keyRevealed = true;
        } else {
            navigator.clipboard.writeText(box.innerText.trim());
            const original = box.innerText;
            box.innerText = '✓ COPIED!';
            box.style.color = '#22c55e';
            box.style.borderColor = '#22c55e';
            setTimeout(() => {
                box.innerText = original;
                box.style.color = '';
                box.style.borderColor = '';
            }, 1800);
        }
    }

    // =========================================
    // PASSWORD STRENGTH CHECKER
    // =========================================
    function checkPasswordStrength() {
        const password = document.getElementById('newPassword').value;
        
        const reqs = {
            length: password.length >= 8,
            upperlower: /[a-z]/.test(password) && /[A-Z]/.test(password),
            number: /\d/.test(password),
            symbol: /[^a-zA-Z\d]/.test(password)
        };
        
        Object.keys(reqs).forEach(key => {
            const el = document.getElementById('req-' + key);
            if (el) {
                if (reqs[key]) {
                    el.classList.add('met');
                    el.querySelector('i').className = 'bi bi-check-circle-fill';
                } else {
                    el.classList.remove('met');
                    el.querySelector('i').className = 'bi bi-circle';
                }
            }
        });
    }

    // =========================================
    // CONFIRM PASSWORD MATCH
    // =========================================
    document.getElementById('confirmPassword').addEventListener('input', function() {
        const newPass = document.getElementById('newPassword').value;
        const confirmPass = this.value;
        const errorEl = document.getElementById('confirmError');
        
        if (confirmPass && newPass !== confirmPass) {
            errorEl.style.display = 'block';
        } else {
            errorEl.style.display = 'none';
        }
    });

    // =========================================
    // VALIDATE CHANGE PASSWORD FORM
    // =========================================
    document.getElementById('changePasswordForm').addEventListener('submit', function(e) {
        const newPass = document.getElementById('newPassword').value;
        const confirmPass = document.getElementById('confirmPassword').value;
        
        if (newPass !== confirmPass) {
            e.preventDefault();
            document.getElementById('confirmError').style.display = 'block';
            return;
        }
        
        const allMet = newPass.length >= 8 && 
            /[a-z]/.test(newPass) && /[A-Z]/.test(newPass) && 
            /\d/.test(newPass) && /[^a-zA-Z\d]/.test(newPass);
        
        if (!allMet) {
            e.preventDefault();
            alert('Please meet all password requirements before submitting.');
        }
    });

    // =========================================
    // LIVE EQUITY CHART
    // =========================================
    const ctx = document.getElementById('equityChart').getContext('2d');
    const equityChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: Array(50).fill(''),
            datasets: [{
                label: 'Master Equity',
                data: [],
                borderColor: '#B0BF96',
                backgroundColor: 'rgba(176, 191, 150, 0.08)',
                borderWidth: 2,
                fill: true,
                tension: 0.3,
                pointRadius: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                x: { display: false },
                y: {
                    display: true,
                    grid: { color: 'rgba(255,255,255,0.04)' },
                    ticks: { color: '#94a3b8', font: { size: 10 } }
                }
            },
            plugins: { legend: { display: false } },
            animation: { duration: 0 }
        }
    });

    // =========================================
    // FETCH LIVE MARKET DATA
    // =========================================
    async function fetchLiveData() {
        try {
            const res = await fetch('/api/public/ea-state');
            const data = await res.json();

            document.getElementById('ea-symbol').innerText = data.symbol || '--';
            document.getElementById('ea-price').innerText = data.price ? parseFloat(data.price).toFixed(4) : '0.00';
            document.getElementById('ea-trend').innerText = data.trend || '--';
            document.getElementById('ea-trades').innerText = data.openTrades || '0';
            document.getElementById('ea-action').innerText = data.action || 'Scanning';

            const actionEl = document.getElementById('ea-action');
            if (data.action?.includes('Buy')) actionEl.style.color = '#B0BF96';
            else if (data.action?.includes('Sell')) actionEl.style.color = '#ef4444';
            else actionEl.style.color = '#f59e0b';

            if (data.equityHistory?.length > 0) {
                equityChart.data.datasets[0].data = data.equityHistory;
                equityChart.update();
            }
        } catch (e) {
            console.error('Live feed error:', e);
        }
    }

    setInterval(fetchLiveData, 2500);
    fetchLiveData();
</script>

