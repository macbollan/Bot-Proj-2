<%- include('partials/header', { title: 'Dashboard | D.E.T System', page: 'dashboard' }) %>

<style>
    :root {
        --det-border: rgba(176, 191, 150, 0.15);
        --det-dark: #121010;
        --det-green: #B0BF96;
        --det-green-hover: #c2d1aa;
        --det-card: #1E1B1B;
    }

    .dashboard-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 20px;
    }

    /* Quick Nav */
    .quick-nav {
        background: var(--det-card);
        border: 1px solid var(--det-border);
        border-radius: 12px;
        padding: 8px 16px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .quick-nav-label {
        color: #94a3b8;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
        margin-right: 8px;
    }
    .quick-nav a {
        color: #cbd5e1;
        text-decoration: none;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid transparent;
    }
    .quick-nav a:hover {
        color: #fff;
        background: rgba(255,255,255,0.05);
        border-color: var(--det-border);
    }
    .quick-nav a.active-page {
        background: rgba(176, 191, 150, 0.15);
        color: var(--det-green);
        border-color: rgba(176, 191, 150, 0.3);
        font-weight: 600;
    }
    .quick-nav a i { font-size: 13px; }

    /* Welcome Hero */
    .welcome-hero {
        background: linear-gradient(135deg, var(--det-card) 0%, #241f1f 100%);
        border: 1px solid var(--det-border);
        border-radius: 16px;
        padding: 24px 30px;
        margin-bottom: 20px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0,0,0,0.2);
    }
    .welcome-hero::before {
        content: '';
        position: absolute;
        top: -50px;
        right: -50px;
        width: 200px;
        height: 200px;
        background: radial-gradient(circle, rgba(176,191,150,0.08) 0%, transparent 70%);
        border-radius: 50%;
    }
    .welcome-content {
        position: relative;
        z-index: 1;
    }
    .welcome-hero h1 {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 4px;
        letter-spacing: -0.5px;
        color: #fff;
    }
    .welcome-hero .subtitle {
        color: #94a3b8;
        font-size: 13px;
        margin-bottom: 0;
    }

    /* Status Grid */
    .status-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 12px;
        margin-bottom: 20px;
    }
    .status-card {
        background: var(--det-card);
        border: 1px solid var(--det-border);
        border-radius: 12px;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: all 0.2s;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .status-card:hover {
        transform: translateY(-2px);
        border-color: rgba(176, 191, 150, 0.3);
    }
    .status-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }
    .status-label {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #94a3b8;
        font-weight: 600;
        margin-bottom: 2px;
    }
    .status-value {
        font-size: 14px;
        font-weight: 700;
        color: #fff;
    }

    /* Integration Card */
    .integration-card {
        background: var(--det-card);
        border: 1px solid var(--det-border);
        border-radius: 14px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    }
    .key-display {
        background: var(--det-dark);
        border: 1px dashed var(--det-green);
        border-radius: 8px;
        padding: 12px 16px;
        font-family: 'Courier New', monospace;
        font-size: 18px;
        letter-spacing: 2px;
        color: var(--det-green);
        cursor: pointer;
        transition: all 0.3s;
        text-align: center;
    }
    .key-display.blurred {
        filter: blur(6px);
        border-color: #475569;
        color: #94a3b8;
        user-select: none;
    }
    .key-display:hover { border-style: solid; }

    /* =========================================
       NEW BOTTOM DASHBOARD UI/UX
    ========================================= */
    .panel-card {
        background: rgba(36, 31, 31, 0.6);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(176, 191, 150, 0.12);
        border-radius: 14px;
        padding: 20px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        transition: all 0.3s ease;
    }
    .panel-card:hover {
        border-color: rgba(176, 191, 150, 0.25);
        box-shadow: 0 12px 40px rgba(0,0,0,0.4);
    }
    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }
    .panel-title {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: #94a3b8;
        font-weight: 700;
    }
    .panel-badge {
        background: rgba(176, 191, 150, 0.1);
        color: var(--det-green);
        border: 1px solid rgba(176, 191, 150, 0.2);
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 600;
    }

    .scroll-list {
        max-height: 180px;
        overflow-y: auto;
        padding-right: 6px;
    }
    .scroll-list::-webkit-scrollbar { width: 4px; }
    .scroll-list::-webkit-scrollbar-track { background: rgba(255,255,255,0.02); border-radius: 4px; }
    .scroll-list::-webkit-scrollbar-thumb { background: rgba(176,191,150,0.3); border-radius: 4px; }
    .scroll-list::-webkit-scrollbar-thumb:hover { background: rgba(176,191,150,0.5); }

    .list-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        transition: background 0.2s;
    }
    .list-item:last-child { border-bottom: none; }
    .list-item:hover { background: rgba(255,255,255,0.02); border-radius: 6px; padding-left: 6px; padding-right: 6px; margin: 0 -6px; }
    .list-item .symbol {
        color: #cbd5e1;
        font-weight: 500;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .list-item .value {
        font-weight: 600;
        font-size: 13px;
        font-family: 'Courier New', monospace;
    }
    .value.positive { color: #22c55e; }
    .value.negative { color: #ef4444; }
    .value.neutral { color: #94a3b8; }

    /* Chart Tabs */
    .chart-tabs {
        display: flex;
        gap: 2px;
        background: rgba(0,0,0,0.3);
        padding: 3px;
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,0.05);
    }
    .chart-tab {
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 10px;
        font-weight: 600;
        color: #64748b;
        cursor: pointer;
        transition: all 0.2s;
        border: none;
        background: transparent;
    }
    .chart-tab:hover { color: #cbd5e1; }
    .chart-tab.active {
        background: rgba(176,191,150,0.15);
        color: var(--det-green);
        box-shadow: 0 2px 8px rgba(176,191,150,0.1);
    }

    /* Account OK Container */
    .status-ok-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 20px;
        background: rgba(176,191,150,0.02);
        border: 1px solid rgba(176,191,150,0.08);
        border-radius: 12px;
    }
    .status-ok-circle {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        border: 2px dashed rgba(176,191,150,0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        margin-bottom: 15px;
        animation: pulseGlow 3s infinite;
    }
    .status-ok-circle::before {
        content: '';
        position: absolute;
        inset: -6px;
        border-radius: 50%;
        border: 1px solid rgba(176,191,150,0.1);
    }
    .status-ok-circle .icon {
        font-size: 36px;
        color: #22c55e;
    }
    @keyframes pulseGlow {
        0% { box-shadow: 0 0 0 0 rgba(34,197,94,0.1); }
        50% { box-shadow: 0 0 20px 10px rgba(34,197,94,0.05); }
        100% { box-shadow: 0 0 0 0 rgba(34,197,94,0.1); }
    }

    /* Transparency List */
    .transparency-list {
        list-style: none;
        padding: 0;
        margin: 0;
        color: #cbd5e1;
        font-size: 13px;
        line-height: 2;
    }
    .transparency-list li {
        display: flex;
        align-items: center;
        gap: 10px;
        border-bottom: 1px solid rgba(255,255,255,0.03);
        padding-bottom: 6px;
        margin-bottom: 6px;
    }
    .transparency-list li:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
    .transparency-list li i {
        color: var(--det-green);
        font-size: 14px;
        background: rgba(176,191,150,0.1);
        padding: 3px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .transparency-note {
        color: #64748b;
        font-size: 11px;
        margin-top: 15px;
        line-height: 1.5;
        border-left: 2px solid var(--det-green);
        padding: 10px;
        background: rgba(176,191,150,0.02);
        border-radius: 0 8px 8px 0;
    }

    /* Metrics */
    .metric-mini {
        background: var(--det-dark);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 8px;
        padding: 12px;
        text-align: center;
    }
    .metric-mini .label {
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #94a3b8;
        font-weight: 600;
        margin-bottom: 4px;
    }
    .metric-mini .value {
        font-size: 16px;
        font-weight: 700;
        color: #fff;
    }
    .metric-mini .value.accent { color: var(--det-green); }

    /* Buttons */
    .btn-det {
        background: var(--det-green);
        color: var(--det-dark);
        font-weight: 600;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        transition: all 0.2s;
        cursor: pointer;
    }
    .btn-det:hover {
        background: var(--det-green-hover);
        color: #000;
        transform: translateY(-1px);
    }
    .btn-outline-det {
        background: transparent;
        color: var(--det-green);
        border: 1px solid var(--det-green);
        font-weight: 600;
        padding: 10px 20px;
        border-radius: 8px;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-block;
        text-align: center;
    }
    .btn-outline-det:hover {
        background: rgba(176, 191, 150, 0.1);
        color: #fff;
        border-color: #fff;
    }

    /* Alerts */
    .alert-custom {
        border-radius: 8px;
        padding: 14px 18px;
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* Modals */
    .modal-content {
        background-color: var(--det-card) !important;
        color: #fff !important;
        border: 1px solid var(--det-border);
        border-radius: 14px;
    }
    .modal-header { border-bottom: 1px solid rgba(255,255,255,0.05); }
    .modal-footer { border-top: 1px solid rgba(255,255,255,0.05); }
    .form-control, .form-select {
        background-color: rgba(0,0,0,0.2) !important;
        border: 1px solid rgba(255,255,255,0.1) !important;
        color: #fff !important;
        padding: 12px;
        border-radius: 6px;
    }
    .form-control:focus, .form-select:focus {
        border-color: var(--det-green) !important;
        box-shadow: 0 0 0 0.25rem rgba(176,191,150,0.15) !important;
    }
    .btn-close-white { filter: invert(1) grayscale(100%) brightness(200%); }
    .password-requirements {
        background: rgba(0,0,0,0.2);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 6px;
        padding: 12px 15px;
        margin-top: 8px;
        margin-bottom: 8px;
        font-size: 11px;
    }
    .password-requirements .req-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 3px 0;
        color: #64748b;
        transition: color 0.3s;
    }
    .password-requirements .req-item.met { color: #22c55e; }
    .password-requirements .req-item i { font-size: 14px; width: 16px; }

    @media (max-width: 768px) {
        .dashboard-container { padding: 0 12px; }
        .welcome-hero { padding: 20px 15px; }
        .quick-nav { gap: 4px; padding: 10px 12px; }
        .quick-nav a { padding: 5px 10px; font-size: 11px; }
        .status-grid { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); }
    }
</style>

<div class="dashboard-container" style="margin-top: 20px; margin-bottom: 40px;">

    <!-- FLASH MESSAGES -->
    <% if(success && success.length > 0) { %>
        <div class="alert-custom" style="background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.3); color: #22c55e;">
            <i class="bi bi-check-circle-fill"></i> <%= success %>
        </div>
    <% } %>
    <% if(error && error.length > 0) { %>
        <div class="alert-custom" style="background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #ef4444;">
            <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
        </div>
    <% } %>

    <!-- QUICK NAVIGATION -->
    <div class="quick-nav">
        <span class="quick-nav-label">Navigate:</span>
        <a href="/"><i class="bi bi-house"></i> Home</a>
        <a href="/dashboard" class="active-page"><i class="bi bi-speedometer2"></i> Dashboard</a>
        <a href="/pricing"><i class="bi bi-tags"></i> Pricing Plans</a>
        <a href="/training"><i class="bi bi-mortarboard"></i> Training</a>
        <a href="/affiliate"><i class="bi bi-diagram-3"></i> Affiliate</a>
        <a href="/logout" style="color: #ef4444; margin-left: auto;"><i class="bi bi-box-arrow-right"></i> Logout</a>
    </div>

    <!-- WELCOME HERO -->
    <div class="welcome-hero">
        <div class="welcome-content">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <h1>Welcome, <%= currentUser.username %></h1>
                    <p class="subtitle">Your D.E.T trading environment is ready. Monitor your license and live market data below.</p>
                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-outline-light btn-sm" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                            <i class="bi bi-person-badge"></i> Edit Profile
                        </button>
                        <button class="btn btn-outline-light btn-sm" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
                            <i class="bi bi-shield-lock"></i> Change Password
                        </button>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2" style="background: rgba(176,191,150,0.1); border: 1px solid rgba(176,191,150,0.2); padding: 6px 16px; border-radius: 30px;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: #22c55e; display: inline-block;"></span>
                    <span style="color: var(--det-green); font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Node Online</span>
                </div>
            </div>
        </div>
    </div>

    <!-- STATUS CARDS -->
    <div class="status-grid">
        <div class="status-card">
            <div class="status-icon" style="background: rgba(176,191,150,0.12); color: var(--det-green);">
                <i class="bi bi-award"></i>
            </div>
            <div>
                <div class="status-label">D.E.T Plan</div>
                <div class="status-value"><%= currentUser.currentTier || 'None' %></div>
            </div>
        </div>
        <div class="status-card">
            <div class="status-icon" style="background: rgba(56,189,248,0.12); color: #38bdf8;">
                <i class="bi bi-calendar-check"></i>
            </div>
            <div>
                <div class="status-label">Days Remaining</div>
                <div class="status-value">
                    <% 
                        let daysLeft = 0;
                        if(currentUser.licenseExpiry) {
                            daysLeft = Math.ceil((new Date(currentUser.licenseExpiry) - new Date()) / (1000 * 60 * 60 * 24));
                            if(daysLeft < 0) daysLeft = 0;
                        }
                    %>
                    <%= daysLeft %> Days
                </div>
            </div>
        </div>
        <div class="status-card">
            <div class="status-icon" style="background: rgba(245,158,11,0.12); color: #f59e0b;">
                <i class="bi bi-shield-check"></i>
            </div>
            <div>
                <div class="status-label">Account Status</div>
                <div class="status-value">
                    <% if(currentUser.accountLocked) { %>
                        <span style="color: #ef4444;">Locked</span>
                    <% } else if(currentUser.isSuspended) { %>
                        <span style="color: #f59e0b;">Suspended</span>
                    <% } else if(currentUser.licenseKey && daysLeft > 0) { %>
                        <span style="color: #22c55e;">Active</span>
                    <% } else { %>
                        <span style="color: #94a3b8;">Inactive</span>
                    <% } %>
                </div>
            </div>
        </div>
        <div class="status-card">
            <div class="status-icon" style="background: rgba(176,191,150,0.12); color: var(--det-green);">
                <i class="bi bi-wallet2"></i>
            </div>
            <div>
                <div class="status-label">Starting Capital</div>
                <div class="status-value">$<%= currentUser.startingBalance ? currentUser.startingBalance.toFixed(2) : '0.00' %></div>
            </div>
        </div>
        <div class="status-card">
            <div class="status-icon" style="background: rgba(34,197,94,0.12); color: #22c55e;">
                <i class="bi bi-graph-up"></i>
            </div>
            <div>
                <div class="status-label">Current Float</div>
                <div class="status-value" id="currentFloat" style="color: #22c55e;">$0.00</div>
            </div>
        </div>
        <div class="status-card">
            <div class="status-icon" style="background: rgba(239,68,68,0.12); color: #ef4444;">
                <i class="bi bi-shield-exclamation"></i>
            </div>
            <div>
                <div class="status-label">100% Double Gain - Logout At</div>
                <div class="status-value" style="color: #ef4444;">$<%= currentUser.targetBalance ? currentUser.targetBalance.toFixed(2) : '0.00' %></div>
            </div>
        </div>
    </div>

    <!-- INTEGRATION ID CARD -->
    <div class="integration-card">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
            <div>
                <h6 class="fw-bold mb-1" style="color: #fff; font-size: 15px;">
                    <i class="bi bi-key" style="color: var(--det-green); margin-right: 8px;"></i>Integration ID
                </h6>
                <p style="color: #94a3b8; font-size: 12px; margin: 0;">Your unique 9‑digit key for the CornerStore EA.</p>
            </div>
            <div>
                <% if(currentUser.licenseKey && !currentUser.isSuspended && daysLeft > 0) { %>
                    <span style="background: rgba(176,191,150,0.12); color: var(--det-green); border: 1px solid rgba(176,191,150,0.25); padding: 4px 14px; border-radius: 20px; font-size: 11px; font-weight: 600;">
                        <i class="bi bi-check-circle-fill me-1"></i> Active Key
                    </span>
                <% } else { %>
                    <span style="background: rgba(239,68,68,0.12); color: #ef4444; border: 1px solid rgba(239,68,68,0.25); padding: 4px 14px; border-radius: 20px; font-size: 11px; font-weight: 600;">
                        <i class="bi bi-exclamation-circle-fill me-1"></i> No Active Key
                    </span>
                <% } %>
            </div>
        </div>

        <% if(currentUser.licenseKey && !currentUser.isSuspended && daysLeft > 0) { %>
            <div class="row align-items-center g-3">
                <div class="col-lg-7">
                    <div class="key-display blurred" id="licenseKeyBox" onclick="handleKeyClick()">
                        <%= currentUser.licenseKey %>
                    </div>
                    <small style="color: #94a3b8; display: block; text-align: center; margin-top: 6px; font-size: 11px;">
                        <i class="bi bi-info-circle me-1"></i> Click to reveal · Click again to copy
                    </small>
                </div>
                <div class="col-lg-5">
                    <div class="d-grid gap-2">
                        <a href="/DET.rar" class="btn btn-det" style="text-decoration: none; display: block; text-align: center; font-size: 13px;">
                            <i class="bi bi-download me-2"></i> Download D.E.T
                        </a>
                        <a href="/pricing" class="btn-outline-det" style="font-size: 13px;">
                            <i class="bi bi-arrow-up-circle me-2"></i> Upgrade Plan
                        </a>
                    </div>
                </div>
            </div>
        <% } else { %>
            <div style="background: rgba(245,158,11,0.05); border: 1px solid rgba(245,158,11,0.15); border-radius: 10px; padding: 16px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 15px;">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-lock-fill" style="font-size: 24px; color: #f59e0b;"></i>
                    <div>
                        <p style="color: #f59e0b; font-weight: 600; margin-bottom: 2px; font-size: 14px;">No active license key found.</p>
                        <p style="color: #94a3b8; font-size: 12px; margin: 0;">Subscribe to a D.E.T plan to receive your unique Integration ID.</p>
                    </div>
                </div>
                <a href="/pricing" class="btn btn-det" style="text-decoration: none; font-size: 13px;">
                    <i class="bi bi-tags me-2"></i> View Plans
                </a>
            </div>
        <% } %>
    </div>

    <!-- =========================================
         MAIN DASHBOARD AREA (Balanced 8/4 Grid)
    ========================================= -->
    <div class="row g-4 align-items-start">
        
        <!-- LEFT COLUMN: Live Feed & Positions (8 Cols) -->
        <div class="col-lg-8">
            <div class="panel-card">
                <div class="panel-header">
                    <div>
                        <span class="panel-title"><i class="bi bi-activity" style="color: var(--det-green); margin-right: 6px;"></i>CornerStore Live Feed</span>
                        <p style="color: #64748b; font-size: 11px; margin: 2px 0 0 0;">Real‑time data from the master trading node.</p>
                    </div>
                    <span class="panel-badge"><span style="width: 6px; height: 6px; border-radius: 50%; background: #22c55e; display: inline-block; margin-right: 4px;"></span> LIVE</span>
                </div>
                
                <!-- Metrics Row -->
                <div class="row g-2 mb-4">
                    <div class="col-3">
                        <div class="metric-mini">
                            <div class="label">Active Asset</div>
                            <div class="value" id="ea-symbol">--</div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="metric-mini">
                            <div class="label">Live Price</div>
                            <div class="value accent" id="ea-price">0.00</div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="metric-mini">
                            <div class="label">A.I. Trend</div>
                            <div class="value" id="ea-trend" style="color: #fff;">--</div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="metric-mini">
                            <div class="label">Open Trades</div>
                            <div class="value" id="ea-trades" style="color: #fff;">0</div>
                        </div>
                    </div>
                </div>

                <!-- Markets Monitored List -->
                <div class="panel-header mb-2">
                    <span class="panel-title" style="font-size: 10px;">Markets Being Monitored</span>
                    <span class="panel-badge" id="marketsCount">0 Markets</span>
                </div>
                <div class="scroll-list mb-4" id="marketsList" style="max-height: 140px;">
                    <!-- Populated dynamically -->
                    <div class="list-item">
                        <span class="symbol"><i class="bi bi-circle-fill" style="color: var(--det-green); font-size: 8px;"></i> XAUUSD</span>
                        <span class="value neutral">Scanning...</span>
                    </div>
                </div>

                <!-- Open Positions List -->
                <div class="panel-header mb-2">
                    <span class="panel-title" style="font-size: 10px;">Open Positions</span>
                    <span class="panel-badge" id="positionsCount">0 Open</span>
                </div>
                <div class="scroll-list" id="positionsList" style="max-height: 140px;">
                    <!-- Populated dynamically -->
                    <div style="text-align: center; color: #64748b; padding: 20px; font-size: 12px;">No open positions currently</div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Account Growth, Status, Transparency (4 Cols) -->
        <div class="col-lg-4 d-flex flex-column gap-4">
            
            <!-- Account Growth Chart -->
            <div class="panel-card">
                <div class="panel-header mb-3">
                    <span class="panel-title" style="font-size: 10px;">Account Growth</span>
                    <div class="chart-tabs">
                        <button class="chart-tab active" onclick="setChartRange('today', this)">1D</button>
                        <button class="chart-tab" onclick="setChartRange('7days', this)">7D</button>
                        <button class="chart-tab" onclick="setChartRange('30days', this)">30D</button>
                    </div>
                </div>
                <div style="background: var(--det-dark); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px; padding: 10px;">
                    <canvas id="equityChart" style="max-height: 180px; width: 100%;"></canvas>
                </div>
            </div>

            <!-- Account OK Status -->
            <div class="panel-card">
                <div class="status-ok-container">
                    <div class="status-ok-circle">
                        <i class="bi bi-check-lg icon"></i>
                    </div>
                    <h6 style="color: #fff; font-weight: 700; margin-bottom: 2px; font-size: 12px; letter-spacing: 0.5px;">IS MY D.E.T ACCOUNT OKAY?</h6>
                    <h2 style="color: #22c55e; font-weight: 800; margin: 0; font-size: 28px;">YES</h2>
                    <p style="color: #94a3b8; font-size: 11px; margin-top: 5px; font-style: italic;">Relax. We've got you.</p>
                </div>
            </div>

            <!-- Transparency Matters -->
            <div class="panel-card">
                <div class="panel-header mb-2">
                    <span class="panel-title" style="font-size: 10px;">Transparency Matters</span>
                </div>
                <ul class="transparency-list">
                    <li><i class="bi bi-check2"></i> No hidden charges.</li>
                    <li><i class="bi bi-check2"></i> No profit sharing.</li>
                    <li><i class="bi bi-check2"></i> No access to your trading account.</li>
                    <li><i class="bi bi-check2"></i> No access to your money.</li>
                    <li><i class="bi bi-check2"></i> No access to your login credentials.</li>
                </ul>
                <div class="transparency-note">
                    Your trading capital always remains under your custody. You remain in complete control throughout your trading journey.
                </div>
            </div>

        </div>
    </div>

</div>

