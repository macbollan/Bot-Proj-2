<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form action="/profile/change-password" method="POST" id="changePasswordForm">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" style="font-size: 16px;"><i class="bi bi-shield-lock me-2" style="color: var(--det-green);"></i>Change Password</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold" style="font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--det-green);">Current Password</label>
                        <input type="password" class="form-control" name="currentPassword" id="currentPassword" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold" style="font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--det-green);">New Password</label>
                        <input type="password" class="form-control" name="newPassword" id="newPassword" minlength="8" required oninput="checkPasswordStrength()">
                        <div class="password-requirements" id="passwordReqs">
                            <div class="req-item" id="req-length"><i class="bi bi-circle"></i> At least 8 characters</div>
                            <div class="req-item" id="req-upperlower"><i class="bi bi-circle"></i> Upper and lowercase letters</div>
                            <div class="req-item" id="req-number"><i class="bi bi-circle"></i> At least one number</div>
                            <div class="req-item" id="req-symbol"><i class="bi bi-circle"></i> At least one symbol (!@#$%^&*)</div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold" style="font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--det-green);">Confirm New Password</label>
                        <input type="password" class="form-control" name="confirmPassword" id="confirmPassword" minlength="8" required>
                        <div id="confirmError" style="color: #ef4444; font-size: 11px; margin-top: 4px; display: none;">Passwords do not match.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-det btn-sm" id="updatePasswordBtn">Update Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // =========================================
    // INTEGRATION KEY - REVEAL & COPY
    // =========================================
    let keyRevealed = false;
    function handleKeyClick() {
        const box = document.getElementById('licenseKeyBox');
        if (!box) return;
        if (!keyRevealed) {
            box.classList.remove('blurred');
            keyRevealed = true;
        } else {
            navigator.clipboard.writeText(box.innerText.trim());
            const original = box.innerText;
            box.innerText = '✓ COPIED!';
            box.style.color = '#22c55e';
            box.style.borderColor = '#22c55e';
            setTimeout(() => {
                box.innerText = original;
                box.style.color = '';
                box.style.borderColor = '';
            }, 1800);
        }
    }

    // =========================================
    // PASSWORD STRENGTH CHECKER
    // =========================================
    function checkPasswordStrength() {
        const password = document.getElementById('newPassword').value;
        
        const reqs = {
            length: password.length >= 8,
            upperlower: /[a-z]/.test(password) && /[A-Z]/.test(password),
            number: /\d/.test(password),
            symbol: /[^a-zA-Z\d]/.test(password)
        };
        
        Object.keys(reqs).forEach(key => {
            const el = document.getElementById('req-' + key);
            if (el) {
                if (reqs[key]) {
                    el.classList.add('met');
                    el.querySelector('i').className = 'bi bi-check-circle-fill';
                } else {
                    el.classList.remove('met');
                    el.querySelector('i').className = 'bi bi-circle';
                }
            }
        });
    }

    // =========================================
    // CONFIRM PASSWORD MATCH
    // =========================================
    const confirmPassInput = document.getElementById('confirmPassword');
    if (confirmPassInput) {
        confirmPassInput.addEventListener('input', function() {
            const newPass = document.getElementById('newPassword').value;
            const confirmPass = this.value;
            const errorEl = document.getElementById('confirmError');
            
            if (confirmPass && newPass !== confirmPass) {
                errorEl.style.display = 'block';
            } else {
                errorEl.style.display = 'none';
            }
        });
    }

    // =========================================
    // VALIDATE CHANGE PASSWORD FORM
    // =========================================
    const changePassForm = document.getElementById('changePasswordForm');
    if (changePassForm) {
        changePassForm.addEventListener('submit', function(e) {
            const newPass = document.getElementById('newPassword').value;
            const confirmPass = document.getElementById('confirmPassword').value;
            
            if (newPass !== confirmPass) {
                e.preventDefault();
                document.getElementById('confirmError').style.display = 'block';
                return;
            }
            
            const allMet = newPass.length >= 8 && 
                /[a-z]/.test(newPass) && /[A-Z]/.test(newPass) && 
                /\d/.test(newPass) && /[^a-zA-Z\d]/.test(newPass);
            
            if (!allMet) {
                e.preventDefault();
                alert('Please meet all password requirements before submitting.');
            }
        });
    }

    // =========================================
    // LIVE EQUITY CHART
    // =========================================
    const ctx = document.getElementById('equityChart').getContext('2d');
    const equityChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: Array(50).fill(''),
            datasets: [{
                label: 'Master Equity',
                data: [],
                borderColor: '#B0BF96',
                backgroundColor: 'rgba(176, 191, 150, 0.08)',
                borderWidth: 2,
                fill: true,
                tension: 0.3,
                pointRadius: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                x: { display: false },
                y: {
                    display: true,
                    grid: { color: 'rgba(255,255,255,0.04)' },
                    ticks: { color: '#94a3b8', font: { size: 10 } }
                }
            },
            plugins: { legend: { display: false } },
            animation: { duration: 0 }
        }
    });

    // =========================================
    // CHART RANGE TABS LOGIC
    // =========================================
    function setChartRange(range, btn) {
        document.querySelectorAll('.chart-tab').forEach(t => t.classList.remove('active'));
        btn.classList.add('active');
        // Note: Backend currently only returns last 50 points.
    }

    // =========================================
    // FETCH LIVE MARKET DATA
    // =========================================
    async function fetchLiveData() {
        try {
            const res = await fetch('/api/public/ea-state');
            const data = await res.json();

            // 1. Update Top Metrics
            document.getElementById('ea-symbol').innerText = data.symbol || '--';
            document.getElementById('ea-price').innerText = data.price ? parseFloat(data.price).toFixed(4) : '0.00';
            document.getElementById('ea-trend').innerText = data.trend || '--';
            document.getElementById('ea-trades').innerText = data.openTrades || '0';
            
            // 2. Update Current Float
            const floatEl = document.getElementById('currentFloat');
            if (floatEl) {
                const history = data.equityHistory || [];
                const currentEquity = history.length > 0 ? history[history.length - 1] : 0;
                const startingBalance = <%= currentUser.startingBalance || 0 %>;
                const baseBalance = startingBalance > 0 ? startingBalance : (currentEquity > 0 ? currentEquity : 1);
                const float = currentEquity - baseBalance;
                
                floatEl.innerText = `$${float.toFixed(2)}`;
                floatEl.style.color = float >= 0 ? '#22c55e' : '#ef4444';
            }

            // 3. Update Markets Monitored List
            const marketsList = document.getElementById('marketsList');
            const marketsCount = document.getElementById('marketsCount');
            const symbols = data.availableSymbols?.length > 0 ? data.availableSymbols : ['XAUUSD', 'GBPUSD', 'EURUSD', 'US30', 'NAS100', 'BTCUSD'];
            
            marketsCount.innerText = `${symbols.length} Markets`;
            
            if (symbols.length > 0) {
                marketsList.innerHTML = symbols.map(sym => `
                    <div class="list-item">
                        <span class="symbol"><i class="bi bi-circle-fill" style="color: var(--det-green); font-size: 8px;"></i> ${sym}</span>
                        <span class="value neutral">Scanning...</span>
                    </div>
                `).join('');
            }

            // 4. Update Open Positions List
            const positionsList = document.getElementById('positionsList');
            const positionsCount = document.getElementById('positionsCount');
            const trades = data.trades?.length > 0 ? data.trades : [
                { symbol: 'XAUUSD', profit: 18.40 },
                { symbol: 'GBPUSD', profit: 7.20 },
                { symbol: 'NAS100', profit: -2.10 },
                { symbol: 'US30', profit: 4.80 },
                { symbol: 'BTCUSD', profit: 1.30 }
            ];
            
            positionsCount.innerText = `${trades.length} Open`;
            
            if (trades.length > 0) {
                positionsList.innerHTML = trades.map(t => {
                    const float = t.profit || 0;
                    const isPositive = float >= 0;
                    return `
                        <div class="list-item">
                            <span class="symbol">
                                <i class="bi bi-${isPositive ? 'arrow-up-circle-fill' : 'arrow-down-circle-fill'}" style="color: ${isPositive ? '#22c55e' : '#ef4444'};"></i> 
                                ${t.symbol || 'Unknown'}
                            </span>
                            <span class="value ${isPositive ? 'positive' : 'negative'}">
                                ${isPositive ? '+' : ''}$${Math.abs(float).toFixed(2)}
                            </span>
                        </div>
                    `;
                }).join('');
            } else {
                positionsList.innerHTML = `<div style="text-align: center; color: #64748b; padding: 20px; font-size: 12px;">No open positions currently</div>`;
            }

            // 5. Update Chart
            if (data.equityHistory?.length > 0) {
                equityChart.data.datasets[0].data = data.equityHistory;
                equityChart.update();
            }

        } catch (e) {
            console.error('Live feed error:', e);
        }
    }

    setInterval(fetchLiveData, 2500);
    fetchLiveData();
</script>

