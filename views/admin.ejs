<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>D.E.T System | Master Node Console</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <style>
        :root {
            --det-green: #B0BF96;
            --det-green-hover: #96a67c;
            --det-dark: #1a1818;
            --det-card: #322C2C;
            --det-border: rgba(176, 191, 150, 0.25);
            --det-red: #ef4444;
            --det-amber: #f59e0b;
            --det-blue: #38bdf8;
            --det-purple: #a78bfa;
            --sidebar-width: 268px;
        }

        body { 
            background-color: var(--det-dark); 
            color: #f8fafc; 
            font-family: 'Poppins', sans-serif; 
            overflow-x: hidden; 
            margin: 0;
        }

        /* =========================================
           NUCLEAR HIGH-CONTRAST OVERRIDES
        ========================================= */
        p, span, div, h1, h2, h3, h4, h5, h6, label { color: #f8fafc; }
        .text-muted { color: #cbd5e1 !important; } 
        .text-secondary { color: #e2e8f0 !important; }

        /* =========================================
           INSTITUTIONAL SIDEBAR
        ========================================= */
        .sidebar {
            position: fixed; top: 0; left: 0; height: 100vh; width: var(--sidebar-width);
            background-color: var(--det-card); border-right: 1px solid var(--det-border);
            z-index: 1050; display: flex; flex-direction: column; transition: transform 0.3s ease;
        }
        .sidebar-header { padding: 25px 20px; border-bottom: 1px solid var(--det-border); }
        .text-logo { color: var(--det-green) !important; font-size: 22px; font-weight: 800; text-decoration: none; letter-spacing: 1px; }
        .text-logo span { color: #ffffff !important; font-weight: 300; }
        
        .sidebar-nav { padding: 20px 10px; flex-grow: 1; overflow-y: auto; }
        .nav-item { margin-bottom: 5px; }
        .nav-link {
            display: flex; align-items: center; padding: 11px 15px; color: #cbd5e1 !important;
            text-decoration: none; border-radius: 8px; font-weight: 500; font-size: 13.5px; transition: all 0.2s;
        }
        .nav-link i { margin-right: 12px; font-size: 17px; width: 18px; text-align: center; }
        .nav-link:hover { color: #fff !important; background: rgba(255,255,255,0.05); }
        .nav-link.active { color: var(--det-dark) !important; background: var(--det-green); font-weight: 600; }
        .nav-link .badge { font-size: 9px; }

        .sidebar-nav::-webkit-scrollbar { width: 4px; }
        .sidebar-nav::-webkit-scrollbar-thumb { background: var(--det-border); border-radius: 4px; }
        .sidebar-footer { padding: 20px; border-top: 1px solid var(--det-border); font-size: 12px; color: #cbd5e1; }

        /* =========================================
           MAIN CONTENT AREA
        ========================================= */
        .main-content { margin-left: var(--sidebar-width); min-height: 100vh; display: flex; flex-direction: column; transition: margin-left 0.3s ease; }

        .top-bar {
            background-color: var(--det-dark); padding: 15px 30px; border-bottom: 1px solid var(--det-border);
            display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 1040;
        }
        .mobile-toggle { display: none; color: var(--det-green); font-size: 24px; cursor: pointer; background: none; border: none; }

        .dashboard-wrapper { padding: 30px; max-width: 1680px; width: 100%; margin: 0 auto; }
        .glass-card { background: var(--det-card); border: 1px solid var(--det-border); border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); padding: 25px; height: 100%; }

        .section-heading {
            display: flex; justify-content: between; align-items: center; justify-content: space-between;
            margin: 38px 0 16px;
        }
        .section-heading h6 {
            font-size: 12px; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700;
            color: #94a3b8 !important; margin: 0; display: flex; align-items: center; gap: 8px;
        }
        .section-heading h6 i { color: var(--det-green); }
        .section-heading:first-of-type { margin-top: 4px; }

        /* KPI Strip */
        .kpi-card {
            background: var(--det-card); border: 1px solid var(--det-border); border-radius: 12px;
            padding: 20px; display: flex; align-items: center; gap: 14px; height: 100%;
            box-shadow: 0 6px 18px rgba(0,0,0,0.18); transition: transform 0.2s, border-color 0.2s;
        }
        .kpi-card:hover { transform: translateY(-2px); border-color: rgba(176, 191, 150, 0.45); }
        .kpi-icon {
            width: 46px; height: 46px; min-width: 46px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center; font-size: 20px;
        }
        .kpi-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.6px; color: #94a3b8 !important; font-weight: 600; margin-bottom: 3px; }
        .kpi-value { font-size: 22px; font-weight: 800; color: #fff !important; line-height: 1.1; }
        .kpi-sub { font-size: 11px; color: #94a3b8 !important; margin-top: 2px; }

        .metric-box { background: var(--det-dark); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px; padding: 15px; }
        .metric-title { font-size: 11px; color: #cbd5e1 !important; text-transform: uppercase; font-weight: 600; letter-spacing: 1px; margin-bottom: 8px; }
        .metric-value { font-size: 24px; font-weight: 800; color: #fff !important; margin: 0; }
        .metric-value.accent { color: var(--det-green) !important; }

        canvas { max-height: 260px; width: 100%; }
        .chart-wrap { position: relative; height: 260px; }
        .chart-wrap.short { height: 210px; }

        /* Empty states for panels without data yet */
        .empty-state {
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            text-align: center; padding: 34px 20px; color: #94a3b8;
        }
        .empty-state i { font-size: 30px; color: var(--det-border); margin-bottom: 10px; }
        .empty-state strong { color: #cbd5e1; font-size: 14px; display: block; margin-bottom: 4px; }
        .empty-state span { font-size: 12.5px; max-width: 320px; }

        /* Mini list rows: Top Earners / Negative Logouts */
        .mini-row {
            display: flex; align-items: center; justify-content: space-between; gap: 12px;
            padding: 12px 14px; border-radius: 8px; background: var(--det-dark);
            border: 1px solid rgba(255,255,255,0.05); margin-bottom: 8px;
        }
        .mini-row:last-child { margin-bottom: 0; }
        .rank-badge {
            width: 26px; height: 26px; border-radius: 6px; display: flex; align-items: center; justify-content: center;
            font-size: 11px; font-weight: 800; background: rgba(176,191,150,0.12); color: var(--det-green);
            flex-shrink: 0;
        }
        .rank-badge.rank-1 { background: rgba(176,191,150,0.9); color: var(--det-dark); }

        /* =========================================
           Institutional Table Styling (Ledger)
        ========================================= */
        .table-responsive-wrapper { border-radius: 8px; border: 1px solid var(--det-border); overflow: hidden; }
        .table-responsive {
            overflow-x: auto; overflow-y: hidden; -webkit-overflow-scrolling: touch;
            scrollbar-width: thin; scrollbar-color: var(--det-green) transparent;
        }
        .table-responsive::-webkit-scrollbar { height: 6px; }
        .table-responsive::-webkit-scrollbar-thumb { background: var(--det-border); border-radius: 4px; }
        .table-responsive::-webkit-scrollbar-thumb:hover { background: var(--det-green); }

        .table { margin-bottom: 0; color: #fff !important; min-width: 760px; }
        .table-dark-custom { background-color: var(--det-dark); }
        .table thead th { 
            background-color: #111; color: #cbd5e1 !important; font-weight: 600; font-size: 12px; 
            text-transform: uppercase; letter-spacing: 1px; border-bottom: 2px solid var(--det-border); padding: 15px;
            white-space: nowrap;
        }
        .table tbody td { padding: 15px; border-bottom: 1px solid rgba(255,255,255,0.05); vertical-align: middle; background-color: transparent; color: #fff !important; }
        .table tbody tr:hover td { background-color: rgba(176, 191, 150, 0.05); }
        .table tbody tr.row-hidden { display: none; }

        .swipe-hint { display: none; align-items: center; gap: 6px; font-size: 11px; color: #cbd5e1; margin-bottom: 10px; letter-spacing: 0.5px; }
        .swipe-hint i { color: var(--det-green); animation: swipeMove 1.4s ease-in-out infinite; }
        @keyframes swipeMove { 0%, 100% { transform: translateX(0); opacity: 0.6; } 50% { transform: translateX(6px); opacity: 1; } }
        @media (max-width: 767px) { .swipe-hint { display: flex; } }
        
        .code-pill { background: #1a1818; border: 1px solid var(--det-border); color: var(--det-green) !important; padding: 4px 10px; border-radius: 6px; font-family: monospace; font-size: 13px; font-weight: 600; }
        
        .btn-det { background: var(--det-green); color: var(--det-dark) !important; font-weight: 600; transition: all 0.3s; border: none; }
        .btn-det:hover { background: var(--det-green-hover); color: #000 !important; }

        .ledger-search {
            background: var(--det-dark) !important; border: 1px solid var(--det-border) !important; color: #fff !important;
            padding: 9px 14px 9px 38px; border-radius: 8px; font-size: 14px; max-width: 320px;
        }
        .ledger-search:focus { border-color: var(--det-green) !important; box-shadow: 0 0 0 0.2rem rgba(176,191,150,0.15) !important; }
        .search-wrap { position: relative; }
        .search-wrap i { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: #94a3b8; }

        .status-badge { padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
        .bg-det-green { background: rgba(176, 191, 150, 0.15); color: var(--det-green) !important; border: 1px solid rgba(176, 191, 150, 0.3); }
        .bg-det-red { background: rgba(239, 68, 68, 0.15); color: #ef4444 !important; border: 1px solid rgba(239, 68, 68, 0.3); }
        .bg-det-warn { background: rgba(245, 158, 11, 0.15); color: #f59e0b !important; border: 1px solid rgba(245, 158, 11, 0.3); }

        .action-btn {
            width: 34px; height: 34px; border-radius: 8px; border: 1px solid var(--det-border); background: var(--det-dark);
            color: #cbd5e1; display: inline-flex; align-items: center; justify-content: center; transition: all 0.2s; cursor: pointer;
        }
        .btn-manage:hover { border-color: var(--det-green); color: var(--det-green); }
        .btn-ban:hover { border-color: var(--det-amber); color: var(--det-amber); }
        .btn-delete:hover { border-color: var(--det-red); color: var(--det-red); background: rgba(239,68,68,0.08); }

        /* Modal Overrides to Kill Invisible Text */
        .modal-content { background-color: var(--det-card) !important; color: #fff !important; border: 1px solid var(--det-border); border-radius: 12px; }
        .modal-header { border-bottom: 1px solid rgba(255,255,255,0.05); }
        .modal-footer { border-top: 1px solid rgba(255,255,255,0.05); }
        .form-control, .form-select { background-color: var(--det-dark) !important; border: 1px solid var(--det-border) !important; color: #fff !important; padding: 12px; }
        .form-control:focus, .form-select:focus { border-color: var(--det-green) !important; box-shadow: 0 0 0 0.25rem rgba(176, 191, 150, 0.25) !important; color: #fff !important;}
        .btn-close-white { filter: invert(1) grayscale(100%) brightness(200%); }

        @media (max-width: 991px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.show { transform: translateX(0); }
            .main-content { margin-left: 0; }
            .mobile-toggle { display: block; }
            .dashboard-wrapper { padding: 20px 15px; }
        }
    </style>
</head>
<body>

    <nav class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <a href="/admin" class="text-logo">D.E.T <span>ADMIN</span></a>
        </div>
        <div class="sidebar-nav">
            <small class="text-uppercase fw-bold ms-3 mb-2 d-block" style="font-size: 11px; color: #cbd5e1;">Core Systems</small>
            <div class="nav-item">
                <a href="#overview" class="nav-link active"><i class="bi bi-cpu"></i> Master Node Console</a>
            </div>
            <div class="nav-item">
                <a href="#analytics" class="nav-link"><i class="bi bi-graph-up-arrow"></i> Network Analytics</a>
            </div>
            <div class="nav-item">
                <a href="#live-feed" class="nav-link"><i class="bi bi-broadcast"></i> Live S.M.A.R.T Feed</a>
            </div>
            <div class="nav-item">
                <a href="#negative-logouts" class="nav-link"><i class="bi bi-shield-lock-fill"></i> Negative Account Logouts</a>
            </div>
            <div class="nav-item">
                <a href="#top-earners" class="nav-link"><i class="bi bi-trophy"></i> Top Earners</a>
            </div>
            <div class="nav-item">
                <a href="#ledger" class="nav-link"><i class="bi bi-people"></i> Participant Ledger</a>
            </div>

            <small class="text-uppercase fw-bold ms-3 mt-4 mb-2 d-block" style="font-size: 11px; color: #cbd5e1;">Network Engines (v2.0)</small>
            <div class="nav-item">
                <a href="#affiliates" class="nav-link"><i class="bi bi-diagram-3"></i> Affiliate Network <span class="badge ms-auto text-dark" style="background: #cbd5e1 !important;">BETA</span></a>
            </div>
            <div class="nav-item">
                <a href="#" class="nav-link"><i class="bi bi-globe"></i> Geo-Block Config <span class="badge ms-auto text-dark" style="background: #cbd5e1 !important;">LOCKED</span></a>
            </div>
            <div class="nav-item">
                <a href="#" class="nav-link"><i class="bi bi-shield-lock"></i> Pilot Access Wall <span class="badge ms-auto text-dark" style="background: #cbd5e1 !important;">LOCKED</span></a>
            </div>

            <small class="text-uppercase fw-bold ms-3 mt-4 mb-2 d-block" style="font-size: 11px; color: #cbd5e1;">System</small>
            <div class="nav-item">
                <a href="/logout" class="nav-link text-danger"><i class="bi bi-power"></i> Kill Session</a>
            </div>
        </div>
        <div class="sidebar-footer d-flex justify-content-between align-items-center">
            <div><span class="spinner-grow spinner-grow-sm text-success me-2" style="width: 8px; height: 8px;"></span>Node Routing</div>
            <span>v1.2</span>
        </div>
    </nav>

    <main class="main-content">
        
        <header class="top-bar">
            <div class="d-flex align-items-center gap-3">
                <button class="mobile-toggle" id="sidebarToggle"><i class="bi bi-list"></i></button>
                <h5 class="mb-0 fw-bold d-none d-md-block text-white">Central Command Hub</h5>
            </div>
            
            <div class="d-flex align-items-center gap-4">
                <div class="d-none d-lg-flex align-items-center gap-2 px-3 py-1 rounded" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3);">
                    <span class="spinner-grow spinner-grow-sm text-danger" style="width: 10px; height: 10px;"></span>
                    <small class="text-danger fw-bold" style="font-size: 12px; letter-spacing: 0.5px;">Global Kill Switch: ARMED</small>
                </div>
                <div class="text-end d-none d-sm-block">
                    <small class="d-block" style="font-size: 11px; line-height: 1; color: #cbd5e1;">Administrator</small>
                    <span class="fw-bold" style="font-size: 14px; color: var(--det-green) !important;"><%= currentUser.username.toUpperCase() %></span>
                </div>
            </div>
        </header>

        <div class="dashboard-wrapper">
            
            <% if(success && success.length > 0) { %> 
                <div class="alert bg-success bg-opacity-10 border-success text-success fw-bold" style="border-radius: 8px;"><i class="bi bi-check-circle me-2"></i><%= success %></div> 
            <% } %>
            <% if(error && error.length > 0) { %> 
                <div class="alert bg-danger bg-opacity-10 border-danger text-danger fw-bold" style="border-radius: 8px;"><i class="bi bi-exclamation-triangle me-2"></i><%= error %></div> 
            <% } %>

            <!-- =========================================
                 OVERVIEW — KPI STRIP
            ========================================= -->
            <div id="overview"></div>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-5 g-3 mb-2">
                <div class="col">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background: rgba(176,191,150,0.12); color: var(--det-green);"><i class="bi bi-people-fill"></i></div>
                        <div>
                            <div class="kpi-label">Total Accounts</div>
                            <div class="kpi-value"><%= stats.total %></div>
                            <div class="kpi-sub">Registered participants</div>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background: rgba(56,189,248,0.12); color: var(--det-blue);"><i class="bi bi-shield-check"></i></div>
                        <div>
                            <div class="kpi-label">Active Licenses</div>
                            <div class="kpi-value"><%= stats.active %></div>
                            <div class="kpi-sub"><%= stats.total > 0 ? Math.round((stats.active / stats.total) * 100) : 0 %>% of network</div>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background: rgba(239,68,68,0.12); color: var(--det-red);"><i class="bi bi-shield-lock-fill"></i></div>
                        <div>
                            <div class="kpi-label">Negative Account Logouts</div>
                            <div class="kpi-value"><%= stats.locked %></div>
                            <div class="kpi-sub">Zero-Hedge forced closures</div>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background: rgba(176,191,150,0.12); color: var(--det-green);"><i class="bi bi-cash-stack"></i></div>
                        <div>
                            <div class="kpi-label">Total Revenue</div>
                            <div class="kpi-value">$<%= stats.totalRevenue.toLocaleString() %></div>
                            <div class="kpi-sub">Verified Paynow receipts</div>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background: rgba(245,158,11,0.12); color: var(--det-amber);"><i class="bi bi-hourglass-split"></i></div>
                        <div>
                            <div class="kpi-label">Unlicensed / Pending</div>
                            <div class="kpi-value"><%= stats.unlicensed %></div>
                            <div class="kpi-sub"><%= stats.suspended %> banned &middot; <%= stats.expired %> expired</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- =========================================
                 ANALYTICS — CHARTS
            ========================================= -->
            <div id="analytics"></div>
            <div class="section-heading">
                <h6><i class="bi bi-graph-up-arrow"></i> Network Analytics</h6>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-xl-8">
                    <div class="glass-card">
                        <h6 class="fw-bold mb-1 text-white">Registrations — Last 30 Days</h6>
                        <p class="text-secondary small mb-3">New accounts created per day, network-wide.</p>
                        <div class="chart-wrap">
                            <canvas id="registrationChart"></canvas>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4">
                    <div class="glass-card">
                        <h6 class="fw-bold mb-1 text-white">Account Status Breakdown</h6>
                        <p class="text-secondary small mb-3">Live standing across every participant.</p>
                        <div class="chart-wrap">
                            <canvas id="statusChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-xl-6">
                    <div class="glass-card">
                        <h6 class="fw-bold mb-1 text-white">Revenue by D.E.T Plan</h6>
                        <p class="text-secondary small mb-3">Verified Paynow revenue attributed to each tier.</p>
                        <% if(revenueByTier && revenueByTier.length > 0) { %>
                            <div class="chart-wrap">
                                <canvas id="revenueChart"></canvas>
                            </div>
                        <% } else { %>
                            <div class="empty-state">
                                <i class="bi bi-bar-chart"></i>
                                <strong>No verified sales yet</strong>
                                <span>This chart activates automatically the moment a Paynow payment is confirmed for any tier.</span>
                            </div>
                        <% } %>
                    </div>
                </div>
                <div class="col-xl-6">
                    <div class="glass-card">
                        <h6 class="fw-bold mb-1 text-white">Accounts by Region</h6>
                        <p class="text-secondary small mb-3">Where your participant base is registered from.</p>
                        <% if(accountsByRegion && accountsByRegion.length > 0) { %>
                            <div class="chart-wrap">
                                <canvas id="regionChart"></canvas>
                            </div>
                        <% } else { %>
                            <div class="empty-state">
                                <i class="bi bi-globe-americas"></i>
                                <strong>No region data yet</strong>
                                <span>Populates automatically once participants register with a country set.</span>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- =========================================
                 LIVE FEED + NEGATIVE ACCOUNT LOGOUTS
            ========================================= -->
            <div id="live-feed"></div>
            <div class="row g-4 mb-4">
                <div class="col-xl-8 col-lg-7">
                    <div class="glass-card">
                        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3" style="border-color: var(--det-border) !important;">
                            <h5 class="fw-bold m-0 text-white"><i class="bi bi-broadcast text-accent me-2"></i>S.M.A.R.T Master Feed</h5>
                            <span class="status-badge bg-det-green"><span class="spinner-grow spinner-grow-sm me-2" style="width: 0.5rem; height: 0.5rem;"></span>Transmitting</span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-3 col-6">
                                <div class="metric-box h-100">
                                    <small class="metric-title">Active Asset</small>
                                    <h5 id="ea-symbol" class="fw-bold text-white mt-1 mb-0">--</h5>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="metric-box h-100">
                                    <small class="metric-title">Live Price</small>
                                    <h5 id="ea-price" class="text-accent fw-bold mt-1 mb-0">0.00</h5>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="metric-box h-100">
                                    <small class="metric-title">A.I. Trend</small>
                                    <h5 id="ea-trend" class="fw-bold mt-1 mb-0 text-white">--</h5>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="metric-box h-100">
                                    <small class="metric-title">Open Trades</small>
                                    <h5 id="ea-trades" class="text-white fw-bold mt-1 mb-0">0</h5>
                                </div>
                            </div>
                        </div>

                        <div>
                            <small class="metric-title d-block mb-2">Live Equity Curve (Master Account)</small>
                            <div class="metric-box">
                                <canvas id="equityChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-4 col-lg-5">
                    <div class="glass-card" id="negative-logouts">
                        <h5 class="fw-bold mb-1 text-white"><i class="bi bi-shield-lock-fill text-danger me-2"></i>Negative Account Logouts</h5>
                        <p class="text-secondary small mb-3">Accounts force-closed after doubling their starting balance (Zero-Hedge Lock).</p>

                        <% if(negativeLogouts && negativeLogouts.length > 0) { %>
                            <div style="max-height: 380px; overflow-y: auto;">
                                <% negativeLogouts.forEach(acc => { %>
                                    <div class="mini-row">
                                        <div>
                                            <div class="fw-bold text-white" style="font-size: 13.5px;"><%= acc.username %></div>
                                            <small style="color: #94a3b8;"><%= acc.tier %> &middot; $<%= acc.startingBalance.toLocaleString() %> &rarr; $<%= acc.targetBalance.toLocaleString() %></small>
                                        </div>
                                        <span class="status-badge bg-det-red">Locked</span>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="empty-state">
                                <i class="bi bi-shield-check"></i>
                                <strong>No forced closures</strong>
                                <span>No participant has triggered a Zero-Hedge lock yet. This list updates in real time.</span>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- =========================================
                 TOP EARNERS + TOP AFFILIATES
            ========================================= -->
            <div class="row g-4 mb-4">
                <div class="col-xl-6" id="top-earners">
                    <div class="glass-card">
                        <h5 class="fw-bold mb-1 text-white"><i class="bi bi-trophy text-accent me-2"></i>Top Earners</h5>
                        <p class="text-secondary small mb-3">Highest verified revenue per licensed account.</p>

                        <% if(topEarners && topEarners.length > 0) { %>
                            <div>
                                <% topEarners.forEach((earner, i) => { %>
                                    <div class="mini-row">
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="rank-badge <%= i === 0 ? 'rank-1' : '' %>">#<%= i + 1 %></span>
                                            <div>
                                                <div class="fw-bold text-white" style="font-size: 13.5px;"><%= earner.username %></div>
                                                <small style="color: #94a3b8;"><%= earner.tier %> &middot; <%= earner.country %></small>
                                            </div>
                                        </div>
                                        <span class="fw-bold text-accent">$<%= earner.revenue.toLocaleString() %></span>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="empty-state">
                                <i class="bi bi-trophy"></i>
                                <strong>No revenue-generating accounts yet</strong>
                                <span>The leaderboard fills in automatically as Paynow payments are confirmed.</span>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="col-xl-6" id="affiliates">
                    <div class="glass-card">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <h5 class="fw-bold m-0 text-white"><i class="bi bi-diagram-3 text-accent me-2"></i>Top Affiliates</h5>
                            <span class="badge text-dark" style="background: #cbd5e1 !important; font-size: 10px;">ENGINE v2</span>
                        </div>
                        <p class="text-secondary small mb-3">Referral performance, once the affiliate program goes live.</p>

                        <% if(topAffiliates && topAffiliates.length > 0) { %>
                            <div>
                                <% topAffiliates.forEach((aff, i) => { %>
                                    <div class="mini-row">
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="rank-badge <%= i === 0 ? 'rank-1' : '' %>">#<%= i + 1 %></span>
                                            <div>
                                                <div class="fw-bold text-white" style="font-size: 13.5px;"><%= aff.username %></div>
                                                <small style="color: #94a3b8;"><%= aff.referrals %> referrals</small>
                                            </div>
                                        </div>
                                        <span class="fw-bold text-accent">$<%= aff.commission.toLocaleString() %></span>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="empty-state">
                                <i class="bi bi-diagram-3"></i>
                                <strong>Affiliate Architecture Pending Deployment</strong>
                                <span>This panel is wired for live data and will populate the moment referral tracking is enabled network-wide.</span>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- =========================================
                 PARTICIPANT LEDGER
            ========================================= -->
            <div class="row" id="ledger">
                <div class="col-12">
                    <div class="glass-card">
                        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 border-bottom pb-3" style="border-color: var(--det-border) !important;">
                            <h5 class="fw-bold m-0 text-white"><i class="bi bi-database text-accent me-2"></i>Participant Ledger</h5>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <div class="search-wrap">
                                    <i class="bi bi-search"></i>
                                    <input type="text" id="ledgerSearch" class="ledger-search" placeholder="Search username or email...">
                                </div>
                                <button id="exportCsvBtn" class="btn btn-sm btn-outline-light text-white" style="border-color: var(--det-border);">
                                    <i class="bi bi-download me-1"></i> Export CSV
                                </button>
                            </div>
                        </div>

                        <div class="swipe-hint">
                            <i class="bi bi-arrow-left-right"></i> Swipe table to see more
                        </div>
                        
                        <div class="table-responsive-wrapper">
                            <div class="table-responsive">
                                <table class="table align-middle mb-0" id="participantTable">
                                    <thead class="table-dark-custom">
                                        <tr>
                                            <th>Participant</th>
                                            <th>Status</th>
                                            <th>Integration ID</th>
                                            <th>D.E.T Plan</th>
                                            <th>Cycle Expires</th>
                                            <th class="text-end">Command Controls</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% users.forEach(client => { %>
                                            <tr data-search="<%= (client.username + ' ' + (client.email || '')).toLowerCase() %>">
                                                <td>
                                                    <div class="fw-bold text-white fs-6"><%= client.username %></div>
                                                    <small style="color: #cbd5e1 !important;"><%= client.email %></small>
                                                </td>
                                                <td>
                                                    <% if(client.accountLocked) { %> 
                                                        <span class="status-badge" style="background: rgba(239, 68, 68, 0.2); color: #ef4444 !important;">ZERO-HEDGE LOCK</span>
                                                    <% } else if(client.isSuspended) { %> 
                                                        <span class="status-badge" style="background: rgba(245, 158, 11, 0.2); color: #f59e0b !important;">BANNED</span>
                                                    <% } else if(new Date() > new Date(client.licenseExpiry)) { %> 
                                                        <span class="status-badge" style="background: rgba(100, 116, 139, 0.3); color: #cbd5e1 !important;">EXPIRED</span>
                                                    <% } else if(client.licenseKey) { %> 
                                                        <span class="status-badge" style="background: rgba(176, 191, 150, 0.2); color: var(--det-green) !important;">ACTIVE</span>
                                                    <% } else { %> 
                                                        <span class="status-badge" style="background: #475569; color: #fff !important;">UNLICENSED</span> 
                                                    <% } %>
                                                </td>
                                                <td><span class="code-pill"><%= client.licenseKey || '---' %></span></td>
                                                <td><span class="badge border text-white fs-6" style="background: var(--det-dark); border-color: var(--det-border) !important;"><%= client.currentTier || 'None' %></span></td>
                                                <td class="fw-semibold <%= new Date() > new Date(client.licenseExpiry) ? 'text-danger' : 'text-white' %>">
                                                    <%= client.licenseExpiry ? new Date(client.licenseExpiry).toLocaleDateString() : 'N/A' %>
                                                </td>
                                                <td class="text-end">
                                                    <div class="d-flex justify-content-end gap-2">
                                                        
                                                        <button class="action-btn btn-manage" data-bs-toggle="modal" data-bs-target="#manageModal<%= client._id %>" title="Manage License">
                                                            <i class="bi bi-key-fill"></i>
                                                        </button>

                                                        <% if(client.licenseKey) { %>
                                                            <form action="/admin/suspend-license/<%= client._id %>" method="POST" class="d-inline">
                                                                <button type="submit" class="action-btn btn-ban" title="<%= client.isSuspended ? 'Unban Account' : 'Ban Account' %>">
                                                                    <i class="bi <%= client.isSuspended ? 'bi-shield-check' : 'bi-shield-lock-fill' %>"></i>
                                                                </button>
                                                            </form>
                                                        <% } %>

                                                        <button class="action-btn btn-delete" data-bs-toggle="modal" data-bs-target="#deleteModal<%= client._id %>" title="Delete Participant">
                                                            <i class="bi bi-trash3-fill"></i>
                                                        </button>

                                                    </div>
                                                </td>
                                            </tr>

                                            <div class="modal fade" id="manageModal<%= client._id %>" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title fw-bold text-white">Manage D.E.T Access</h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <form action="/admin/generate-license/<%= client._id %>" method="POST">
                                                            <div class="modal-body">
                                                                <p class="mb-4" style="color: #cbd5e1; font-size: 14px;">You are generating a new secure key for <strong class="text-white"><%= client.username %></strong>. This will override their current access.</p>
                                                                
                                                                <div class="mb-3 text-start">
                                                                    <label class="form-label fw-bold small text-uppercase" style="color: var(--det-green) !important;">Select Trading Level</label>
                                                                    <select class="form-select" name="tierLevel" required>
                                                                        <option value="Amber" <%= client.currentTier == 'Amber' ? 'selected' : '' %>>Amber (No Trading)</option>
                                                                        <option value="Amethyst" <%= client.currentTier == 'Amethyst' ? 'selected' : '' %>>Amethyst ($50 - $199)</option>
                                                                        <option value="Topaz" <%= client.currentTier == 'Topaz' ? 'selected' : '' %>>Topaz ($200 - $1K)</option>
                                                                        <option value="Tanzanite" <%= client.currentTier == 'Tanzanite' ? 'selected' : '' %>>Tanzanite ($1K - $10K)</option>
                                                                        <option value="Sapphire" <%= client.currentTier == 'Sapphire' ? 'selected' : '' %>>Sapphire ($10K - $100K)</option>
                                                                        <option value="Emerald" <%= client.currentTier == 'Emerald' ? 'selected' : '' %>>Emerald ($100K - $1M)</option>
                                                                    </select>
                                                                </div>

                                                                <div class="mb-3 text-start">
                                                                    <label class="form-label fw-bold small text-uppercase" style="color: var(--det-green) !important;">Duration (Days)</label>
                                                                    <input type="number" name="durationDays" class="form-control" value="30" required>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-outline-light text-white" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-det"><i class="bi bi-lightning-charge-fill me-1"></i> Issue Key</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="modal fade" id="deleteModal<%= client._id %>" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content" style="border-color: #ef4444;">
                                                        <div class="modal-header" style="border-bottom-color: rgba(239, 68, 68, 0.2);">
                                                            <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Deletion</h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body text-start">
                                                            <p style="color: #cbd5e1; font-size: 14px;">Are you sure you want to completely delete <strong class="text-white"><%= client.username %></strong> from the network?</p>
                                                            <p class="text-danger small mb-0 fw-bold">This action cannot be undone, and their EA will immediately disconnect.</p>
                                                        </div>
                                                        <div class="modal-footer" style="border-top-color: rgba(239, 68, 68, 0.2);">
                                                            <button type="button" class="btn btn-outline-light text-white" data-bs-dismiss="modal">Cancel</button>
                                                            <form action="/admin/delete-user/<%= client._id %>" method="POST">
                                                                <button type="submit" class="btn btn-danger">Yes, Nuke Account</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div id="noResultsMsg" class="empty-state" style="display: none;">
                            <i class="bi bi-search"></i>
                            <strong>No matches found</strong>
                            <span>Try a different username or email.</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Sidebar Toggle
        document.getElementById('sidebarToggle').addEventListener('click', function() {
            document.getElementById('sidebar').classList.toggle('show');
        });

        // ==========================================
        // LEDGER SEARCH / FILTER
        // ==========================================
        const ledgerSearchInput = document.getElementById('ledgerSearch');
        const ledgerRows = Array.from(document.querySelectorAll('#participantTable tbody tr[data-search]'));
        const noResultsMsg = document.getElementById('noResultsMsg');

        ledgerSearchInput.addEventListener('input', function() {
            const term = this.value.trim().toLowerCase();
            let visibleCount = 0;
            ledgerRows.forEach(row => {
                const matches = row.getAttribute('data-search').includes(term);
                row.classList.toggle('row-hidden', !matches);
                if (matches) visibleCount++;
            });
            noResultsMsg.style.display = (term.length > 0 && visibleCount === 0) ? 'flex' : 'none';
        });

        // CSV Export Function
        document.getElementById('exportCsvBtn').addEventListener('click', function() {
            let csv = [];
            let rows = document.querySelectorAll("#participantTable tr");
            for (let i = 0; i < rows.length; i++) {
                if (rows[i].classList.contains('row-hidden')) continue;
                let row = [], cols = rows[i].querySelectorAll("td, th");
                for (let j = 0; j < cols.length - 1; j++) { 
                    let data = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, " ").trim();
                    row.push('"' + data.replace(/"/g, '""') + '"');
                }
                csv.push(row.join(","));
            }
            let csvFile = new Blob([csv.join("\n")], {type: "text/csv"});
            let downloadLink = document.createElement("a");
            downloadLink.download = "DET_Participant_Ledger.csv";
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = "none";
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        });

        // ==========================================
        // CHART.JS GLOBAL DEFAULTS (dark theme)
        // ==========================================
        Chart.defaults.color = '#94a3b8';
        Chart.defaults.font.family = "'Poppins', sans-serif";

        // ==========================================
        // SERVER-DERIVED DATA (100% dynamic, computed in /admin route)
        // ==========================================
        const registrationTrend = <%- JSON.stringify(registrationTrend) %>;
        const revenueByTier = <%- JSON.stringify(revenueByTier) %>;
        const accountsByRegion = <%- JSON.stringify(accountsByRegion) %>;
        const statusBreakdown = [
            { label: 'Active', value: <%= stats.active %>, color: '#B0BF96' },
            { label: 'Banned', value: <%= stats.suspended %>, color: '#f59e0b' },
            { label: 'Zero-Hedge Locked', value: <%= stats.locked %>, color: '#ef4444' },
            { label: 'Expired', value: <%= stats.expired %>, color: '#94a3b8' },
            { label: 'Unlicensed', value: <%= stats.unlicensed %>, color: '#38bdf8' }
        ];

        // --- Registration Trend (Line) ---
        new Chart(document.getElementById('registrationChart').getContext('2d'), {
            type: 'line',
            data: {
                labels: registrationTrend.map(d => new Date(d.date + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' })),
                datasets: [{
                    label: 'New Accounts',
                    data: registrationTrend.map(d => d.count),
                    borderColor: '#B0BF96',
                    backgroundColor: 'rgba(176, 191, 150, 0.12)',
                    borderWidth: 2, fill: true, tension: 0.35, pointRadius: 0
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                scales: {
                    x: { grid: { display: false }, ticks: { maxRotation: 0, autoSkip: true, maxTicksLimit: 8 } },
                    y: { beginAtZero: true, grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { precision: 0 } }
                },
                plugins: { legend: { display: false } }
            }
        });

        // --- Account Status Breakdown (Doughnut) ---
        new Chart(document.getElementById('statusChart').getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: statusBreakdown.map(d => d.label),
                datasets: [{
                    data: statusBreakdown.map(d => d.value),
                    backgroundColor: statusBreakdown.map(d => d.color),
                    borderColor: '#322C2C', borderWidth: 3
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false, cutout: '68%',
                plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, padding: 14, font: { size: 11 } } } }
            }
        });

        // --- Revenue by Tier (Bar) ---
        <% if(revenueByTier && revenueByTier.length > 0) { %>
        new Chart(document.getElementById('revenueChart').getContext('2d'), {
            type: 'bar',
            data: {
                labels: revenueByTier.map(t => t.tier),
                datasets: [{
                    label: 'Revenue (USD)',
                    data: revenueByTier.map(t => t.revenue),
                    backgroundColor: 'rgba(176, 191, 150, 0.75)',
                    borderRadius: 6, maxBarThickness: 42
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true, grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { callback: v => '$' + v.toLocaleString() } }
                },
                plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => '$' + ctx.parsed.y.toLocaleString() } } }
            }
        });
        <% } %>

        // --- Accounts by Region (Horizontal Bar) ---
        <% if(accountsByRegion && accountsByRegion.length > 0) { %>
        new Chart(document.getElementById('regionChart').getContext('2d'), {
            type: 'bar',
            data: {
                labels: accountsByRegion.map(r => r.region),
                datasets: [{
                    label: 'Accounts',
                    data: accountsByRegion.map(r => r.count),
                    backgroundColor: ['#B0BF96', '#38bdf8', '#f59e0b', '#a78bfa', '#94a3b8', '#ef4444', '#96a67c'],
                    borderRadius: 6, maxBarThickness: 26
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true, maintainAspectRatio: false,
                scales: {
                    x: { beginAtZero: true, grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { precision: 0 } },
                    y: { grid: { display: false } }
                },
                plugins: { legend: { display: false } }
            }
        });
        <% } %>

        // --- Live Equity Curve ---
        const equityChart = new Chart(document.getElementById('equityChart').getContext('2d'), {
            type: 'line',
            data: { 
                labels: Array(50).fill(''), 
                datasets: [{ 
                    label: 'Master Equity', data: [], borderColor: '#B0BF96', backgroundColor: 'rgba(176, 191, 150, 0.1)', 
                    borderWidth: 2, fill: true, tension: 0.3, pointRadius: 0 
                }] 
            },
            options: { 
                responsive: true, maintainAspectRatio: false,
                scales: { 
                    x: { display: false }, 
                    y: { display: true, grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#94a3b8' } } 
                }, 
                plugins: { legend: { display: false } }, animation: { duration: 0 } 
            }
        });

        // Live Poll Data
        async function fetchAdminEAData() {
            try {
                const res = await fetch('/api/public/ea-state');
                const data = await res.json();
                
                document.getElementById('ea-symbol').innerText = data.symbol || '--';
                document.getElementById('ea-price').innerText = data.price ? parseFloat(data.price).toFixed(4) : "0.00";
                document.getElementById('ea-trend').innerText = data.trend || '--';
                document.getElementById('ea-trades').innerText = data.openTrades || 0;
                
                const trendEl = document.getElementById('ea-trend');
                if(data.action && data.action.includes("Buy")) trendEl.style.color = "#B0BF96"; 
                else if(data.action && data.action.includes("Sell")) trendEl.style.color = "#ef4444"; 
                else trendEl.style.color = "#fff";

                if(data.equityHistory && data.equityHistory.length > 0) {
                    equityChart.data.datasets[0].data = data.equityHistory;
                    equityChart.update();
                }
            } catch (e) { console.error("Error fetching Master Data"); }
        }
        setInterval(fetchAdminEAData, 2000);
        fetchAdminEAData(); 
    </script>
</body>
</html>
