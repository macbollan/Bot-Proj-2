            <span style="color: var(--det-green);">v2.0.1</span>
        </div>
    </nav>

    <main class="main-content">
        
        <header class="top-bar">
            <div class="d-flex align-items-center gap-3">
                <button class="mobile-toggle" id="sidebarToggle"><i class="bi bi-list"></i></button>
                <div>
                    <h5 class="mb-0 fw-bold text-white d-none d-md-block">Central Command Hub</h5>
                    <small class="d-none d-md-block" style="color: #64748b; font-size: 11px;">Real-time network monitoring & control</small>
                </div>
            </div>
            
            <div class="d-flex align-items-center gap-3">
                <a href="/" target="_blank" class="nav-quick-btn d-none d-lg-inline-flex">
                    <i class="bi bi-house"></i> <span>Site</span>
                </a>
                <a href="/pricing" target="_blank" class="nav-quick-btn d-none d-lg-inline-flex">
                    <i class="bi bi-tags"></i> <span>Pricing</span>
                </a>
                <a href="/dashboard" target="_blank" class="nav-quick-btn d-none d-lg-inline-flex">
                    <i class="bi bi-speedometer2"></i> <span>Dashboard</span>
                </a>
                <div class="vr d-none d-sm-block" style="height: 24px; background: var(--det-border);"></div>
                <div class="text-end d-none d-sm-block">
                    <small class="d-block" style="font-size: 10px; line-height: 1; color: #64748b; letter-spacing: 1px; text-transform: uppercase;">Administrator</small>
                    <span class="fw-bold" style="font-size: 14px; color: var(--det-green) !important;"><%= currentUser.username.toUpperCase() %></span>
                </div>
            </div>
        </header>

        <div class="dashboard-wrapper">
            
            <% if(success && success.length > 0) { %> 
                <div class="alert bg-success bg-opacity-10 border-success text-success fw-medium mb-4" style="border-radius: 10px; border-left: 3px solid #22c55e;">
                    <i class="bi bi-check-circle-fill me-2"></i><%= success %>
                </div> 
            <% } %>
            <% if(error && error.length > 0) { %> 
                <div class="alert bg-danger bg-opacity-10 border-danger text-danger fw-medium mb-4" style="border-radius: 10px; border-left: 3px solid #ef4444;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
                </div> 
            <% } %>

            <!-- KPI GRID -->
            <div id="overview"></div>
            <div class="kpi-grid">
                <div class="kpi-card">
                    <div class="kpi-icon" style="background: rgba(176,191,150,0.1); color: var(--det-green);">
                        <i class="bi bi-eye-fill"></i>
                    </div>
                    <div class="kpi-content">
                        <div class="kpi-label">Total Visitors</div>
                        <div class="kpi-value"><%= stats.totalVisitors.toLocaleString() %></div>
                        <div class="kpi-sub">All-time site visits</div>
                    </div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-icon" style="background: rgba(56,189,248,0.1); color: var(--det-blue);">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div class="kpi-content">
                        <div class="kpi-label">Total Accounts</div>
                        <div class="kpi-value"><%= stats.total %></div>
                        <div class="kpi-sub">Registered participants</div>
                    </div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-icon" style="background: rgba(16,185,129,0.1); color: var(--det-emerald);">
                        <i class="bi bi-shield-check-fill"></i>
                    </div>
                    <div class="kpi-content">
                        <div class="kpi-label">Active Licenses</div>
                        <div class="kpi-value"><%= stats.active %></div>
                        <div class="kpi-sub"><%= stats.total > 0 ? Math.round((stats.active / stats.total) * 100) : 0 %>% of network</div>
                    </div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-icon" style="background: rgba(239,68,68,0.1); color: var(--det-red);">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <div class="kpi-content">
                        <div class="kpi-label">Negative Logouts</div>
                        <div class="kpi-value"><%= stats.locked %></div>
                        <div class="kpi-sub">Zero-Hedge closures</div>
                    </div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-icon" style="background: rgba(16,185,129,0.1); color: var(--det-emerald);">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <div class="kpi-content">
                        <div class="kpi-label">Positive Logouts</div>
                        <div class="kpi-value"><%= stats.locked %></div>
                        <div class="kpi-sub">100% gain achieved</div>
                    </div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-icon" style="background: rgba(176,191,150,0.1); color: var(--det-green);">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <div class="kpi-content">
                        <div class="kpi-label">Total Revenue</div>
                        <div class="kpi-value">$<%= stats.totalRevenue.toLocaleString() %></div>
                        <div class="kpi-sub">Payouts: $<%= stats.totalAffiliatePayouts.toLocaleString() %></div>
                    </div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-icon" style="background: rgba(245,158,11,0.1); color: var(--det-amber);">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div class="kpi-content">
                        <div class="kpi-label">Unlicensed / Pending</div>
                        <div class="kpi-value"><%= stats.unlicensed %></div>
                        <div class="kpi-sub"><%= stats.suspended %> banned · <%= stats.expired %> expired</div>
                    </div>
                </div>
            </div>

            <!-- ANALYTICS CHARTS -->
            <div id="analytics"></div>
            <div class="section-heading">
                <h6><i class="bi bi-graph-up-arrow"></i> Network Analytics</h6>
                <span style="font-size: 10px; color: #64748b; letter-spacing: 1px;">UPDATED LIVE</span>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-xl-8">
                    <div class="glass-card">
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div>
                                <h6 class="fw-bold mb-1 text-white">Registrations — Last 30 Days</h6>
                                <p class="text-secondary small mb-0">New accounts created per day, network-wide</p>
                            </div>
                            <span class="status-badge bg-det-green"><span class="status-dot" style="background: #10b981;"></span>Live</span>
                        </div>
                        <div class="chart-wrap">
                            <canvas id="registrationChart"></canvas>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4">
                    <div class="glass-card">
                        <h6 class="fw-bold mb-1 text-white">Account Status</h6>
                        <p class="text-secondary small mb-3">Real-time breakdown</p>
                        <div class="chart-wrap">
                            <canvas id="statusChart"></canvas>
                        </div>
                        <div class="mt-3">
                            <% 
                            const statusLabels = ['Active', 'Banned', 'Locked', 'Expired', 'Unlicensed'];
                            const statusValues = [stats.active, stats.suspended, stats.locked, stats.expired, stats.unlicensed];
                            const statusColors = ['#B0BF96', '#f59e0b', '#ef4444', '#94a3b8', '#38bdf8'];
                            for(let i = 0; i < statusLabels.length; i++) { %>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span style="font-size: 11px; color: #94a3b8;"><span style="color: <%= statusColors[i] %>;">●</span> <%= statusLabels[i] %></span>
                                    <span class="fw-bold text-white" style="font-size: 13px;"><%= statusValues[i] %></span>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-xl-6">
                    <div class="glass-card">
                        <h6 class="fw-bold mb-1 text-white">Revenue by D.E.T Plan</h6>
                        <p class="text-secondary small mb-3">Verified revenue per tier</p>
                        <div class="chart-wrap">
                            <canvas id="revenueChart"></canvas>
                        </div>
                    </div>
                </div>
                <div class="col-xl-6">
                    <div class="glass-card">
                        <h6 class="fw-bold mb-1 text-white">Top Accounts by Region</h6>
                        <p class="text-secondary small mb-3">Geographic distribution</p>
                        <div class="chart-wrap">
                            <canvas id="regionChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- LIVE FEED + LOGOUTS -->
            <div id="live-feed"></div>
            <div id="logouts"></div>
            <div class="row g-4 mb-4">
                <div class="col-xl-8">
                    <div class="glass-card">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <h5 class="fw-bold m-0 text-white"><i class="bi bi-broadcast me-2" style="color: var(--det-green);"></i>S.M.A.R.T Master Feed</h5>
                                <small style="color: #64748b;">Real-time trading signals</small>
                            </div>
                            <span class="status-badge bg-det-green">
                                <span class="spinner-grow spinner-grow-sm me-1" style="width: 6px; height: 6px;"></span>Transmitting
                            </span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-3 col-6">
                                <div style="background: #0a0a0a; border: 1px solid rgba(255,255,255,0.05); border-radius: 10px; padding: 16px;">
                                    <small style="color: #64748b; font-size: 10px; text-transform: uppercase; letter-spacing: 1px;">Active Asset</small>
                                    <h5 id="ea-symbol" class="fw-bold text-white mt-1 mb-0" style="font-size: 18px;">--</h5>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div style="background: #0a0a0a; border: 1px solid rgba(255,255,255,0.05); border-radius: 10px; padding: 16px;">
                                    <small style="color: #64748b; font-size: 10px; text-transform: uppercase; letter-spacing: 1px;">Live Price</small>
                                    <h5 id="ea-price" class="fw-bold mt-1 mb-0" style="font-size: 18px; color: var(--det-green);">0.00</h5>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div style="background: #0a0a0a; border: 1px solid rgba(255,255,255,0.05); border-radius: 10px; padding: 16px;">
                                    <small style="color: #64748b; font-size: 10px; text-transform: uppercase; letter-spacing: 1px;">A.I. Trend</small>
                                    <h5 id="ea-trend" class="fw-bold mt-1 mb-0 text-white" style="font-size: 18px;">--</h5>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div style="background: #0a0a0a; border: 1px solid rgba(255,255,255,0.05); border-radius: 10px; padding: 16px;">
                                    <small style="color: #64748b; font-size: 10px; text-transform: uppercase; letter-spacing: 1px;">Open Trades</small>
                                    <h5 id="ea-trades" class="text-white fw-bold mt-1 mb-0" style="font-size: 18px;">0</h5>
                                </div>
                            </div>
                        </div>

                        <div>
                            <small style="color: #64748b; font-size: 10px; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 8px;">Live Equity Curve</small>
                            <div style="background: #0a0a0a; border: 1px solid rgba(255,255,255,0.05); border-radius: 10px; padding: 16px;">
                                <canvas id="equityChart" style="max-height: 200px;"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-4">
                    <div class="glass-card mb-4">
                        <h5 class="fw-bold mb-1 text-white"><i class="bi bi-shield-lock-fill me-2" style="color: #ef4444;"></i>Negative Account Logouts</h5>
                        <p class="text-secondary small mb-3">Zero-Hedge forced closures</p>

                        <% if(negativeLogouts && negativeLogouts.length > 0) { %>
                            <div style="max-height: 250px; overflow-y: auto;">
                                <% negativeLogouts.forEach(acc => { %>
                                    <div class="mini-row">
                                        <div>
                                            <div class="fw-bold text-white" style="font-size: 13px;"><%= acc.username %></div>
                                            <small style="color: #64748b;"><%= acc.tier %> · $<%= acc.startingBalance.toLocaleString() %></small>
                                        </div>
                                        <span class="status-badge bg-det-red">Locked</span>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="empty-state" style="padding: 24px;">
                                <i class="bi bi-shield-check"></i>
                                <strong>No Forced Closures</strong>
                                <span>No participant has triggered a Zero-Hedge lock yet.</span>
                            </div>
                        <% } %>

                        <button class="btn btn-warning btn-sm w-100 mt-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#negativeOfferModal" style="border-radius: 10px;">
                            <i class="bi bi-gift-fill me-1"></i> Issue Free Week Pass
                        </button>
                    </div>

                    <div class="glass-card">
                        <h5 class="fw-bold mb-1 text-white"><i class="bi bi-graph-up-arrow me-2" style="color: #10b981;"></i>Positive Logouts</h5>
                        <p class="text-secondary small mb-3">Profitable completions (100% gain)</p>

                        <% if(positiveLogouts && positiveLogouts.length > 0) { %>
                            <div style="max-height: 250px; overflow-y: auto;">
                                <% positiveLogouts.forEach(acc => { %>
                                    <div class="mini-row">
                                        <div>
                                            <div class="fw-bold text-white" style="font-size: 13px;"><%= acc.username %></div>
                                            <small style="color: #64748b;"><%= acc.tier %> · +$<%= acc.profit.toLocaleString() %></small>
                                        </div>
                                        <span class="status-badge" style="background: rgba(16,185,129,0.12); color: #10b981 !important; border: 1px solid rgba(16,185,129,0.25);">
                                            +$<%= acc.profit.toLocaleString() %>
                                        </span>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="empty-state" style="padding: 24px;">
                                <i class="bi bi-emoji-smile"></i>
                                <strong>No Profitable Completions Yet</strong>
                                <span>Accounts that successfully double will appear here.</span>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- TOP EARNERS + AFFILIATES -->
            <div id="top-earners"></div>
            <div class="row g-4 mb-4">
                <div class="col-xl-6">
                    <div class="glass-card">
                        <h5 class="fw-bold mb-1 text-white"><i class="bi bi-trophy-fill me-2" style="color: #f59e0b;"></i>Top Earners Awards</h5>
                        <p class="text-secondary small mb-3">Highest verified revenue per licensed account</p>

                        <% if(topEarners && topEarners.length > 0) { %>
                            <div>
                                <% topEarners.forEach((earner, i) => { %>
                                    <div class="mini-row">
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="rank-badge <%= i < 3 ? 'rank-' + (i+1) : '' %>">#<%= i + 1 %></span>
                                            <div>
                                                <div class="fw-bold text-white" style="font-size: 13px;"><%= earner.username %></div>
                                                <small style="color: #64748b;"><%= earner.tier %> · <%= earner.country %></small>
                                            </div>
                                        </div>
                                        <span class="fw-bold" style="color: var(--det-green);">$<%= earner.revenue.toLocaleString() %></span>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="empty-state">
                                <i class="bi bi-trophy"></i>
                                <strong>Leaderboard Empty</strong>
                                <span>Fills automatically as payments are confirmed.</span>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="col-xl-6" id="affiliates">
                    <div class="glass-card">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <h5 class="fw-bold m-0 text-white"><i class="bi bi-diagram-3-fill me-2" style="color: var(--det-purple);"></i>Top Affiliates</h5>
                            <span class="badge badge-beta">ENGINE v2</span>
                        </div>
                        <p class="text-secondary small mb-3">Referral performance & total payouts</p>

                        <% if(topAffiliates && topAffiliates.length > 0) { %>
                            <div>
                                <% topAffiliates.forEach((aff, i) => { %>
                                    <div class="mini-row">
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="rank-badge <%= i < 3 ? 'rank-' + (i+1) : '' %>">#<%= i + 1 %></span>
                                            <div>
                                                <div class="fw-bold text-white" style="font-size: 13px;"><%= aff.username %></div>
                                                <small style="color: #64748b;"><%= aff.referrals %> referrals</small>
                                            </div>
                                        </div>
                                        <span class="fw-bold" style="color: var(--det-green);">$<%= aff.commission.toLocaleString() %></span>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="empty-state">
                                <i class="bi bi-diagram-3"></i>
                                <strong>Affiliate Engine Pending</strong>
                                <span>Wired for live data — activates on first referral.</span>
                            </div>
                        <% } %>

                        <div class="mt-3 pt-3 border-top" style="border-color: var(--det-border) !important;">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-secondary small">Total Payouts:</span>
                                <span class="fw-bold" style="color: var(--det-green);">$<%= stats.totalAffiliatePayouts.toLocaleString() %></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PARTICIPANT LEDGER WITH PAGINATION -->
            <div class="row" id="ledger">
                <div class="col-12">
                    <div class="glass-card">
                        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                            <div>
                                <h5 class="fw-bold m-0 text-white"><i class="bi bi-database me-2" style="color: var(--det-green);"></i>Participant Ledger</h5>
                                <small style="color: #64748b; font-size: 11px;">Complete network registry</small>
                            </div>
                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                <div class="search-box">
                                    <i class="bi bi-search"></i>
                                    <input type="text" id="ledgerSearch" class="search-input" placeholder="Search by username or email...">
                                </div>
                                <button id="exportCsvBtn" class="btn btn-sm" style="background: var(--det-card); border: 1px solid var(--det-border); color: #94a3b8; border-radius: 10px; padding: 10px 16px; font-weight: 500; transition: all var(--transition-speed);">
                                    <i class="bi bi-download me-1"></i> Export CSV
                                </button>
                            </div>
                        </div>

                        <div class="table-container">
                            <div class="table-responsive">
                                <table class="table align-middle mb-0" id="participantTable">
                                    <thead>
                                        <tr>
                                            <th>Participant</th>
                                            <th>Status</th>
                                            <th>Terminal</th>
                                            <th>Integration ID</th>
                                            <th>D.E.T Plan</th>
                                            <th>Cycle Expires</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="ledgerTableBody">
                                        <% users.forEach(client => { %>
                                            <%
                                                let isTerminalActive = false;
                                                if (client.licenseKey && !client.isSuspended && !client.accountLocked) {
                                                    const now = new Date();
                                                    const expiry = new Date(client.licenseExpiry);
                                                    if (expiry > now) isTerminalActive = true;
                                                }
                                                
                                                let statusClass = 'bg-det-slate';
                                                let statusText = 'UNLICENSED';
                                                if(client.accountLocked) { statusClass = 'bg-det-red'; statusText = 'ZERO-HEDGE LOCK'; }
                                                else if(client.isSuspended) { statusClass = 'bg-det-warn'; statusText = 'BANNED'; }
                                                else if(new Date() > new Date(client.licenseExpiry) && client.licenseKey) { statusClass = 'bg-det-slate'; statusText = 'EXPIRED'; }
                                                else if(client.licenseKey) { statusClass = 'bg-det-green'; statusText = 'ACTIVE'; }
                                            %>
                                            <tr data-search="<%= (client.username + ' ' + (client.email || '')).toLowerCase() %>" data-status="<%= statusText.toLowerCase() %>">
                                                <td>
                                                    <div class="fw-bold text-white" style="font-size: 14px;"><%= client.username %></div>
                                                    <small style="color: #64748b;"><%= client.email || 'N/A' %></small>
                                                </td>
                                                <td>
                                                    <span class="status-badge <%= statusClass %>">
                                                        <span class="status-dot" style="background: currentColor;"></span><%= statusText %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <% if(isTerminalActive) { %>
                                                        <span class="terminal-active"><i class="bi bi-circle-fill me-1" style="font-size: 6px;"></i> Active</span>
                                                    <% } else { %>
                                                        <span class="terminal-inactive"><i class="bi bi-circle me-1" style="font-size: 6px;"></i> Offline</span>
                                                    <% } %>
                                                </td>
                                                <td><span class="code-pill"><%= client.licenseKey || '---' %></span></td>
                                                <td><span class="badge border text-white" style="background: #0a0a0a; border-color: var(--det-border) !important; padding: 6px 12px; font-size: 12px; font-weight: 500; border-radius: 8px;"><%= client.currentTier || 'None' %></span></td>
                                                <td class="fw-semibold <%= new Date() > new Date(client.licenseExpiry) && client.licenseKey ? 'text-danger' : 'text-white' %>" style="font-size: 13px;">
                                                    <%= client.licenseExpiry ? new Date(client.licenseExpiry).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'N/A' %>
                                                </td>
                                                <td class="text-end">
                                                    <div class="action-group">
                                                        <button class="action-btn btn-details" title="View Details" data-bs-toggle="modal" data-bs-target="#detailModal<%= client._id %>">
                                                            <i class="bi bi-info-circle-fill"></i>
                                                        </button>
                                                        <button class="action-btn btn-manage" title="Manage License" data-bs-toggle="modal" data-bs-target="#manageModal<%= client._id %>">
                                                            <i class="bi bi-key-fill"></i>
                                                        </button>
                                                        <% if(client.licenseKey) { %>
                                                            <form action="/admin/suspend-license/<%= client._id %>" method="POST" class="d-inline">
                                                                <button type="submit" class="action-btn btn-ban" title="<%= client.isSuspended ? 'Unban' : 'Ban' %> Account">
                                                                    <i class="bi <%= client.isSuspended ? 'bi-shield-check' : 'bi-shield-lock-fill' %>"></i>
                                                                </button>
                                                            </form>
                                                        <% } %>
                                                        <button class="action-btn btn-delete" title="Delete" data-bs-toggle="modal" data-bs-target="#deleteModal<%= client._id %>">
                                                            <i class="bi bi-trash3-fill"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>

                                            <!-- Detail Modal -->
                                            <div class="modal fade" id="detailModal<%= client._id %>" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered modal-lg">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title fw-bold text-white"><i class="bi bi-person-badge me-2"></i><%= client.username %> — Dossier</h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="row g-4">
                                                                <div class="col-md-6">
                                                                    <h6 class="fw-bold text-white mb-3" style="font-size: 12px; text-transform: uppercase; letter-spacing: 1.5px; color: #64748b;">Account Information</h6>
                                                                    <div class="detail-row"><span class="detail-label">Username</span><span class="detail-value"><%= client.username %></span></div>
                                                                    <div class="detail-row"><span class="detail-label">Email</span><span class="detail-value"><%= client.email || 'N/A' %></span></div>
                                                                    <div class="detail-row"><span class="detail-label">WhatsApp</span><span class="detail-value"><%= client.whatsapp || 'N/A' %></span></div>
                                                                    <div class="detail-row"><span class="detail-label">Country</span><span class="detail-value"><%= (client.country && client.country.trim()) || 'Unknown' %></span></div>
                                                                    <div class="detail-row"><span class="detail-label">D.E.T Plan</span><span class="detail-value"><%= client.currentTier || 'None' %></span></div>
                                                                    <div class="detail-row"><span class="detail-label">Integration ID</span><span class="detail-value"><%= client.licenseKey || 'Not Issued' %></span></div>
                                                                    <div class="detail-row"><span class="detail-label">License Expiry</span><span class="detail-value <%= new Date() > new Date(client.licenseExpiry) && client.licenseKey ? 'text-danger' : '' %>"><%= client.licenseExpiry ? new Date(client.licenseExpiry).toLocaleDateString() : 'N/A' %></span></div>
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <h6 class="fw-bold text-white mb-3" style="font-size: 12px; text-transform: uppercase; letter-spacing: 1.5px; color: #64748b;">Equity & Trading</h6>
                                                                    <div class="detail-row"><span class="detail-label">Starting Balance</span><span class="detail-value">$<%= (Number(client.startingBalance) || 0).toLocaleString() %></span></div>
                                                                    <div class="detail-row"><span class="detail-label">Target Balance</span><span class="detail-value">$<%= (Number(client.targetBalance) || 0).toLocaleString() %></span></div>
                                                                    <div class="detail-row"><span class="detail-label">Prepayment</span><span class="detail-value">$<%= (Number(client.prepaymentAmount) || 0).toLocaleString() %></span></div>
                                                                    <div class="detail-row"><span class="detail-label">Account Locked</span><span class="detail-value <%= client.accountLocked ? 'text-danger' : 'text-success' %>"><%= client.accountLocked ? 'YES' : 'No' %></span></div>
                                                                    <div class="detail-row"><span class="detail-label">Suspended</span><span class="detail-value <%= client.isSuspended ? 'text-warning' : 'text-success' %>"><%= client.isSuspended ? 'BANNED' : 'Clear' %></span></div>
                                                                    <div class="detail-row"><span class="detail-label">Terminal</span><span class="detail-value <%= isTerminalActive ? 'text-success' : '' %>"><%= isTerminalActive ? 'Active' : 'Offline' %></span></div>
                                                                    <div class="detail-row"><span class="detail-label">Registered</span><span class="detail-value"><%= client._id.getTimestamp().toLocaleDateString() %></span></div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal" style="border-radius: 10px;">Close</button>
                                                            <button type="button" class="btn-det" data-bs-toggle="modal" data-bs-target="#manageModal<%= client._id %>" data-bs-dismiss="modal">
                                                                <i class="bi bi-key-fill me-1"></i> Manage License
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Manage License Modal -->
                                            <div class="modal fade" id="manageModal<%= client._id %>" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title fw-bold text-white">Manage D.E.T Access</h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <form action="/admin/generate-license/<%= client._id %>" method="POST">
                                                            <div class="modal-body">
                                                                <p style="color: #94a3b8; font-size: 13px; margin-bottom: 20px;">Generating a new key for <strong class="text-white"><%= client.username %></strong>.</p>
                                                                <div class="mb-3">
                                                                    <label class="form-label fw-bold small" style="color: var(--det-green) !important; text-transform: uppercase; letter-spacing: 1px;">Trading Level</label>
                                                                    <select class="form-select" name="tierLevel" required>
                                                                        <% ['Amber', 'Amethyst', 'Topaz', 'Tanzanite', 'Sapphire', 'Emerald'].forEach(tier => { %>
                                                                            <option value="<%= tier %>" <%= client.currentTier == tier ? 'selected' : '' %>><%= tier %></option>
                                                                        <% }) %>
                                                                    </select>
                                                                </div>
                                                                <div class="mb-3">
                                                                    <label class="form-label fw-bold small" style="color: var(--det-green) !important; text-transform: uppercase; letter-spacing: 1px;">Duration (Days)</label>
                                                                    <input type="number" name="durationDays" class="form-control" value="30" required>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal" style="border-radius: 10px;">Cancel</button>
                                                                <button type="submit" class="btn-det"><i class="bi bi-lightning-charge-fill me-1"></i> Issue Key</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Delete Modal -->
                                            <div class="modal fade" id="deleteModal<%= client._id %>" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content" style="border-color: rgba(239,68,68,0.3);">
                                                        <div class="modal-header" style="border-bottom-color: rgba(239,68,68,0.1);">
                                                            <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Deletion</h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <p style="color: #94a3b8; font-size: 14px;">Delete <strong class="text-white"><%= client.username %></strong> permanently?</p>
                                                            <p class="text-danger small mb-0 fw-bold">This is irreversible. Their EA will disconnect immediately.</p>
                                                        </div>
                                                        <div class="modal-footer" style="border-top-color: rgba(239,68,68,0.1);">
                                                            <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal" style="border-radius: 10px;">Cancel</button>
                                                            <form action="/admin/delete-user/<%= client._id %>" method="POST">
                                                                <button type="submit" class="btn btn-danger" style="border-radius: 10px;">Nuke Account</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                            
                            <!-- Pagination -->
                            <div class="pagination-container" id="paginationContainer">
                                <div class="pagination-info">
                                    Showing <span id="showingStart">0</span>-<span id="showingEnd">0</span> of <span id="totalRecords">0</span> participants
                                </div>
                                <div class="pagination-controls">
                                    <select class="page-size-select" id="pageSizeSelect">
                                        <option value="10">10 per page</option>
                                        <option value="25">25 per page</option>
                                        <option value="50">50 per page</option>
                                        <option value="100">100 per page</option>
                                    </select>
                                    <div class="pagination" id="pagination"></div>
                                </div>
                            </div>
                        </div>
                        
                        <div id="noResultsMsg" class="empty-state" style="display: none;">
                            <i class="bi bi-search"></i>
                            <strong>No matches found</strong>
                            <span>Try a different search term.</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <!-- Negative Account Offer Modal -->
    <div class="modal fade" id="negativeOfferModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-white"><i class="bi bi-gift-fill me-2" style="color: var(--det-amber);"></i>Negative Account Offer Service</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p style="color: #94a3b8; font-size: 13px; margin-bottom: 24px;">Accounts locked by Zero-Hedge protocol. Grant 1-week free access to continue trading.</p>
                    
                    <% 
                    let blownAccounts = users.filter(c => c.accountLocked);
                    if(blownAccounts.length > 0) { 
                    %>
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead style="background: #0a0a0a;">
                                    <tr>
                                        <th style="color: #64748b; font-size: 10px; text-transform: uppercase; letter-spacing: 1px;">Participant</th>
                                        <th style="color: #64748b; font-size: 10px; text-transform: uppercase; letter-spacing: 1px;">Tier</th>
                                        <th style="color: #64748b; font-size: 10px; text-transform: uppercase; letter-spacing: 1px;">Balance Range</th>
                                        <th style="color: #64748b; font-size: 10px; text-transform: uppercase; letter-spacing: 1px;">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% blownAccounts.forEach(acc => { %>
                                        <tr>
                                            <td>
                                                <div class="fw-bold text-white"><%= acc.username %></div>
                                                <small style="color: #64748b;"><%= acc.email %></small>
                                            </td>
                                            <td><span class="badge border text-white" style="background: #0a0a0a; border-color: var(--det-border) !important;"><%= acc.currentTier || 'None' %></span></td>
                                            <td style="color: #e2e8f0;">$<%= (Number(acc.startingBalance) || 0).toLocaleString() %> → $<%= (Number(acc.targetBalance) || 0).toLocaleString() %></td>
                                            <td>
                                                <form action="/admin/offer-free-week/<%= acc._id %>" method="POST">
                                                    <button type="submit" class="btn btn-warning btn-sm fw-semibold" style="border-radius: 8px;">
                                                        <i class="bi bi-gift me-1"></i> Grant Free Week
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="empty-state">
                            <i class="bi bi-shield-check"></i>
                            <strong>No Blown Accounts</strong>
                            <span>Locked accounts will appear here automatically.</span>
                        </div>
                    <% } %>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal" style="border-radius: 10px;">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ==========================================
        // SAFE DATA PARSING - Ensures data exists even if server doesn't send it
        // ==========================================
        const registrationTrend = <%- JSON.stringify(registrationTrend || []) %>;
        const revenueByTier = <%- JSON.stringify(revenueByTier || []) %>;
        const topAccountsByRegion = <%- JSON.stringify(topAccountsByRegion || []) %>;
        const statusBreakdown = [
            { label: 'Active', value: <%= stats.active || 0 %>, color: '#B0BF96' },
            { label: 'Banned', value: <%= stats.suspended || 0 %>, color: '#f59e0b' },
            { label: 'Locked', value: <%= stats.locked || 0 %>, color: '#ef4444' },
            { label: 'Expired', value: <%= stats.expired || 0 %>, color: '#94a3b8' },
            { label: 'Unlicensed', value: <%= stats.unlicensed || 0 %>, color: '#38bdf8' }
        ];

        // ==========================================
        // SIDEBAR TOGGLE
        // ==========================================
        const sidebar = document.getElementById('sidebar');
        const sidebarToggle = document.getElementById('sidebarToggle');
        const backdrop = document.createElement('div');
        backdrop.className = 'sidebar-backdrop';
        document.body.appendChild(backdrop);

        function openSidebar() { sidebar.classList.add('show'); backdrop.classList.add('show'); }
        function closeSidebar() { sidebar.classList.remove('show'); backdrop.classList.remove('show'); }
        sidebarToggle.addEventListener('click', () => sidebar.classList.contains('show') ? closeSidebar() : openSidebar());
        backdrop.addEventListener('click', closeSidebar);
        document.querySelectorAll('.sidebar .nav-link').forEach(link => link.addEventListener('click', closeSidebar));

        // ==========================================
        // CHARTS INITIALIZATION
        // ==========================================
        document.addEventListener('DOMContentLoaded', function() {
            // Registration Trend Chart
            const regCtx = document.getElementById('registrationChart');
            if (regCtx && registrationTrend.length > 0) {
                new Chart(regCtx.getContext('2d'), {
                    type: 'line',
                    data: {
                        labels: registrationTrend.map(d => {
                            try {
                                return new Date(d.date + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                            } catch(e) {
                                return d.date || '';
                            }
                        }),
                        datasets: [{
                            label: 'New Accounts',
                            data: registrationTrend.map(d => d.count || 0),
                            borderColor: '#B0BF96',
                            backgroundColor: 'rgba(176, 191, 150, 0.1)',
                            borderWidth: 2.5,
                            fill: true,
                            tension: 0.4,
                            pointRadius: 0,
                            pointHoverRadius: 6,
                            pointHoverBackgroundColor: '#B0BF96'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { intersect: false, mode: 'index' },
                        scales: {
                            x: { 
                                grid: { display: false }, 
                                ticks: { maxRotation: 0, autoSkip: true, maxTicksLimit: 10, font: { size: 11 } } 
                            },
                            y: { 
                                beginAtZero: true, 
                                grid: { color: 'rgba(255,255,255,0.03)' }, 
                                ticks: { precision: 0, font: { size: 11 } } 
                            }
                        },
                        plugins: { legend: { display: false } }
                    }
                });
            }

            // Status Breakdown Chart
            const statusCtx = document.getElementById('statusChart');
            if (statusCtx) {
                new Chart(statusCtx.getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        labels: statusBreakdown.map(d => d.label),
                        datasets: [{
                            data: statusBreakdown.map(d => d.value),
                            backgroundColor: statusBreakdown.map(d => d.color),
                            borderColor: '#141414',
                            borderWidth: 4,
                            hoverBorderColor: '#141414',
                            hoverBorderWidth: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: { 
                            legend: { display: false },
                            tooltip: { 
                                callbacks: { 
                                    label: function(ctx) {
                                        return ' ' + ctx.label + ': ' + ctx.parsed + ' accounts';
                                    } 
                                } 
                            }
                        }
                    }
                });
            }

            // Revenue Chart
            const revCtx = document.getElementById('revenueChart');
            if (revCtx && revenueByTier.length > 0) {
                const colors = ['rgba(176,191,150,0.9)', 'rgba(56,189,248,0.8)', 'rgba(245,158,11,0.8)', 'rgba(167,139,250,0.8)', 'rgba(16,185,129,0.8)', 'rgba(239,68,68,0.7)'];
                new Chart(revCtx.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: revenueByTier.map(t => t.tier),
                        datasets: [{
                            label: 'Revenue (USD)',
                            data: revenueByTier.map(t => t.revenue),
                            backgroundColor: revenueByTier.map((_, i) => colors[i % colors.length]),
                            borderRadius: 8,
                            maxBarThickness: 48,
                            borderSkipped: false
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: { grid: { display: false }, ticks: { font: { size: 10 } } },
                            y: { 
                                beginAtZero: true, 
                                grid: { color: 'rgba(255,255,255,0.03)' }, 
                                ticks: { 
                                    callback: function(v) { return '$' + v.toLocaleString(); }, 
                                    font: { size: 11 } 
                                } 
                            }
                        },
                        plugins: { 
                            legend: { display: false }, 
                            tooltip: { 
                                callbacks: { 
                                    label: function(ctx) { return '$' + ctx.parsed.y.toLocaleString(); } 
                                } 
                            } 
                        }
                    }
                });
            }

            // Region Chart
            const regionCtx = document.getElementById('regionChart');
            if (regionCtx && topAccountsByRegion.length > 0) {
                new Chart(regionCtx.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: topAccountsByRegion.map(r => r.region),
                        datasets: [{
                            label: 'Accounts',
                            data: topAccountsByRegion.map(r => r.count),
                            backgroundColor: ['#B0BF96', '#38bdf8', '#f59e0b', '#a78bfa', '#94a3b8', '#10b981', '#ef4444'],
                            borderRadius: 8,
                            maxBarThickness: 32,
                            borderSkipped: false
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: { 
                                beginAtZero: true, 
                                grid: { color: 'rgba(255,255,255,0.03)' }, 
                                ticks: { precision: 0, font: { size: 11 } } 
                            },
                            y: { 
                                grid: { display: false }, 
                                ticks: { font: { size: 11 } } 
                            }
                        },
                        plugins: { legend: { display: false } }
                    }
                });
            }

            // Live Equity Curve
            const equityCtx = document.getElementById('equityChart');
            if (equityCtx) {
                window.equityChart = new Chart(equityCtx.getContext('2d'), {
                    type: 'line',
                    data: { 
                        labels: Array(50).fill(''), 
                        datasets: [{ 
                            label: 'Master Equity', 
                            data: Array(50).fill(0), 
                            borderColor: '#B0BF96', 
                            backgroundColor: 'rgba(176, 191, 150, 0.1)',
                            borderWidth: 2, 
                            fill: true, 
                            tension: 0.3, 
                            pointRadius: 0 
                        }] 
                    },
                    options: { 
                        responsive: true, 
                        maintainAspectRatio: false,
                        interaction: { intersect: false, mode: 'index' },
                        scales: { 
                            x: { display: false }, 
                            y: { 
                                display: true, 
                                grid: { color: 'rgba(255,255,255,0.03)' }, 
                                ticks: { color: '#94a3b8', font: { size: 10 } } 
                            } 
                        }, 
                        plugins: { legend: { display: false } }, 
                        animation: { duration: 0 } 
                    }
                });
            }
        });

        // ==========================================
        // LEDGER PAGINATION SYSTEM
        // ==========================================
        const ledgerSearchInput = document.getElementById('ledgerSearch');
        const ledgerTableBody = document.getElementById('ledgerTableBody');
        const noResultsMsg = document.getElementById('noResultsMsg');
        const pageSizeSelect = document.getElementById('pageSizeSelect');
        const paginationDiv = document.getElementById('pagination');
        const showingStart = document.getElementById('showingStart');
        const showingEnd = document.getElementById('showingEnd');
        const totalRecords = document.getElementById('totalRecords');

        let currentPage = 1;
        let pageSize = 10;
        let allRows = [];
        let filteredRows = [];

        // Initialize: grab all rows from the table
        if (ledgerTableBody) {
            allRows = Array.from(ledgerTableBody.querySelectorAll('tr[data-search]'));
            filteredRows = [...allRows];
        }

        function updatePagination() {
            const total = filteredRows.length;
            const totalPages = Math.ceil(total / pageSize);
            const start = total === 0 ? 0 : (currentPage - 1) * pageSize + 1;
            const end = Math.min(currentPage * pageSize, total);

            // Update info text
            if (showingStart) showingStart.textContent = start;
            if (showingEnd) showingEnd.textContent = end;
            if (totalRecords) totalRecords.textContent = total;

            // Show/hide rows
            allRows.forEach(row => row.classList.add('row-hidden'));
            filteredRows.forEach((row, i) => {
                if (i >= (currentPage - 1) * pageSize && i < currentPage * pageSize) {
                    row.classList.remove('row-hidden');
                }
            });

            // Build pagination buttons
            if (paginationDiv) {
                paginationDiv.innerHTML = '';
                
                // Previous button
                const prevBtn = document.createElement('button');
                prevBtn.className = 'page-btn';
                prevBtn.innerHTML = '<i class="bi bi-chevron-left"></i>';
                prevBtn.disabled = currentPage === 1;
                prevBtn.addEventListener('click', () => {
                    if (currentPage > 1) {
                        currentPage--;
                        updatePagination();
                    }
                });
                paginationDiv.appendChild(prevBtn);

                // Page numbers
                const maxVisible = 5;
                let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
                let endPage = Math.min(totalPages, startPage + maxVisible - 1);
                if (endPage - startPage < maxVisible - 1) {
                    startPage = Math.max(1, endPage - maxVisible + 1);
                }

                if (startPage > 1) {
                    const firstBtn = document.createElement('button');
                    firstBtn.className = 'page-btn';
                    firstBtn.textContent = '1';
                    firstBtn.addEventListener('click', () => {
                        currentPage = 1;
                        updatePagination();
                    });
                    paginationDiv.appendChild(firstBtn);
                    
                    if (startPage > 2) {
                        const dots = document.createElement('span');
                        dots.className = 'page-btn';
                        dots.textContent = '...';
                        dots.style.cursor = 'default';
                        dots.style.pointerEvents = 'none';
                        paginationDiv.appendChild(dots);
                    }
                }

                for (let i = startPage; i <= endPage; i++) {
                    const pageBtn = document.createElement('button');
                    pageBtn.className = 'page-btn' + (i === currentPage ? ' active' : '');
                    pageBtn.textContent = i;
                    pageBtn.addEventListener('click', () => {
                        currentPage = i;
                        updatePagination();
                    });
                    paginationDiv.appendChild(pageBtn);
                }

                if (endPage < totalPages) {
                    if (endPage < totalPages - 1) {
                        const dots = document.createElement('span');
                        dots.className = 'page-btn';
                        dots.textContent = '...';
                        dots.style.cursor = 'default';
                        dots.style.pointerEvents = 'none';
                        paginationDiv.appendChild(dots);
                    }
                    
                    const lastBtn = document.createElement('button');
                    lastBtn.className = 'page-btn';
                    lastBtn.textContent = totalPages;
                    lastBtn.addEventListener('click', () => {
                        currentPage = totalPages;
                        updatePagination();
                    });
                    paginationDiv.appendChild(lastBtn);
                }

                // Next button
                const nextBtn = document.createElement('button');
                nextBtn.className = 'page-btn';
                nextBtn.innerHTML = '<i class="bi bi-chevron-right"></i>';
                nextBtn.disabled = currentPage === totalPages || totalPages === 0;
                nextBtn.addEventListener('click', () => {
                    if (currentPage < totalPages) {
                        currentPage++;
                        updatePagination();
                    }
                });
                paginationDiv.appendChild(nextBtn);
            }

            // Show/hide no results message
            if (noResultsMsg) {
                const searchTerm = ledgerSearchInput ? ledgerSearchInput.value.trim() : '';
                noResultsMsg.style.display = (filteredRows.length === 0 && searchTerm.length > 0) ? 'flex' : 'none';
            }
        }

        // Search handler
        if (ledgerSearchInput) {
            ledgerSearchInput.addEventListener('input', function() {
                const term = this.value.trim().toLowerCase();
                filteredRows = allRows.filter(row => {
                    const searchData = row.getAttribute('data-search') || '';
                    return searchData.includes(term);
                });
                currentPage = 1;
                updatePagination();
            });
        }

        // Page size change handler
        if (pageSizeSelect) {
            pageSizeSelect.addEventListener('change', function() {
                pageSize = parseInt(this.value);
                currentPage = 1;
                updatePagination();
            });
        }

        // Initial pagination
        updatePagination();

        // ==========================================
        // CSV EXPORT
        // ==========================================
        const exportBtn = document.getElementById('exportCsvBtn');
        if (exportBtn) {
            exportBtn.addEventListener('click', function() {
                let csv = [];
                const table = document.getElementById('participantTable');
                if (!table) return;
                
                const rows = table.querySelectorAll('tr');
                for (let i = 0; i < rows.length; i++) {
                    if (rows[i].classList.contains('row-hidden')) continue;
                    let row = [];
                    const cols = rows[i].querySelectorAll('td, th');
                    // Skip the last column (Actions)
                    for (let j = 0; j < cols.length - 1; j++) { 
                        let data = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, " ").trim();
                        row.push('"' + data.replace(/"/g, '""') + '"');
                    }
                    csv.push(row.join(','));
                }
                
                if (csv.length === 0) return;
                
                const csvFile = new Blob([csv.join('\n')], {type: 'text/csv'});
                const downloadLink = document.createElement('a');
                downloadLink.download = 'DET_Participant_Ledger.csv';
                downloadLink.href = window.URL.createObjectURL(csvFile);
                downloadLink.style.display = 'none';
                document.body.appendChild(downloadLink);
                downloadLink.click();
                document.body.removeChild(downloadLink);
            });
        }

        // ==========================================
        // LIVE DATA POLLING
        // ==========================================
        async function fetchAdminEAData() {
            try {
                const res = await fetch('/api/public/ea-state');
                const data = await res.json();
                
                const symbolEl = document.getElementById('ea-symbol');
                const priceEl = document.getElementById('ea-price');
                const trendEl = document.getElementById('ea-trend');
                const tradesEl = document.getElementById('ea-trades');
                
                if (symbolEl) symbolEl.innerText = data.symbol || '--';
                if (priceEl) priceEl.innerText = data.price ? parseFloat(data.price).toFixed(5) : '0.00000';
                if (trendEl) {
                    trendEl.innerText = data.trend || '--';
                    if (data.action && data.action.includes('Buy')) trendEl.style.color = '#10b981';
                    else if (data.action && data.action.includes('Sell')) trendEl.style.color = '#ef4444';
                    else trendEl.style.color = '#e2e8f0';
                }
                if (tradesEl) tradesEl.innerText = data.openTrades || 0;

                if (window.equityChart && data.equityHistory && data.equityHistory.length > 0) {
                    window.equityChart.data.datasets[0].data = data.equityHistory;
                    window.equityChart.update('none');
                }
            } catch (e) {
                console.error('Live feed error:', e);
            }
        }
        setInterval(fetchAdminEAData, 2000);
        fetchAdminEAData();

        console.log('%c🛡️ D.E.T Master Node Console v2.0.1 %c| %cSecure Session Active',
            'color: #B0BF96; font-weight: bold; font-size: 14px;',
            '',
            'color: #94a3b8; font-size: 11px;');
    </script>
</body>
</html>