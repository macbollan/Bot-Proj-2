<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>D.E.T System | Master Node Console</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <style>
        :root {
            --det-green: #B0BF96;
            --det-green-hover: #96a67c;
            --det-dark: #1a1818;
            --det-card: #322C2C;
            --det-border: rgba(176, 191, 150, 0.25);
            --det-red: #ef4444;
            --det-amber: #f59e0b;
            --det-blue: #38bdf8;
            --det-purple: #a78bfa;
            --sidebar-width: 268px;
        }

        body { 
            background-color: var(--det-dark); 
            color: #f8fafc; 
            font-family: 'Poppins', sans-serif; 
            overflow-x: hidden; 
            margin: 0;
        }

        p, span, div, h1, h2, h3, h4, h5, h6, label { color: #f8fafc; }
        .text-muted { color: #cbd5e1 !important; } 
        .text-secondary { color: #e2e8f0 !important; }

        /* =========================================
           INSTITUTIONAL SIDEBAR
        ========================================= */
        .sidebar {
            position: fixed; top: 0; left: 0; height: 100vh; width: var(--sidebar-width);
            background-color: var(--det-card); border-right: 1px solid var(--det-border);
            z-index: 1050; display: flex; flex-direction: column; transition: transform 0.3s ease;
        }
        .sidebar-header { padding: 25px 20px; border-bottom: 1px solid var(--det-border); }
        .text-logo { color: var(--det-green) !important; font-size: 22px; font-weight: 800; text-decoration: none; letter-spacing: 1px; }
        .text-logo span { color: #ffffff !important; font-weight: 300; }
        
        .sidebar-nav { padding: 20px 10px; flex-grow: 1; overflow-y: auto; }
        .nav-item { margin-bottom: 5px; }
        .nav-link {
            display: flex; align-items: center; padding: 11px 15px; color: #cbd5e1 !important;
            text-decoration: none; border-radius: 8px; font-weight: 500; font-size: 13.5px; transition: all 0.2s;
        }
        .nav-link i { margin-right: 12px; font-size: 17px; width: 18px; text-align: center; }
        .nav-link:hover { color: #fff !important; background: rgba(255,255,255,0.05); }
        .nav-link.active { color: var(--det-dark) !important; background: var(--det-green); font-weight: 600; }
        .nav-link .badge { font-size: 9px; }

        .sidebar-nav::-webkit-scrollbar { width: 4px; }
        .sidebar-nav::-webkit-scrollbar-thumb { background: var(--det-border); border-radius: 4px; }
        .sidebar-footer { padding: 20px; border-top: 1px solid var(--det-border); font-size: 12px; color: #cbd5e1; }

        /* =========================================
           MAIN CONTENT AREA
        ========================================= */
        .main-content { margin-left: var(--sidebar-width); min-height: 100vh; display: flex; flex-direction: column; transition: margin-left 0.3s ease; }

        .top-bar {
            background-color: var(--det-dark); padding: 15px 30px; border-bottom: 1px solid var(--det-border);
            display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 1040;
        }
        .mobile-toggle { display: none; color: var(--det-green); font-size: 24px; cursor: pointer; background: none; border: none; }
        
        /* Navigation buttons in top bar */
        .nav-quick-btn {
            background: var(--det-card); border: 1px solid var(--det-border); color: var(--det-green);
            padding: 8px 16px; border-radius: 8px; font-size: 12px; font-weight: 600;
            text-decoration: none; transition: all 0.2s; display: inline-flex; align-items: center; gap: 6px;
        }
        .nav-quick-btn:hover { background: var(--det-green); color: var(--det-dark); border-color: var(--det-green); }

        .dashboard-wrapper { padding: 30px; max-width: 1680px; width: 100%; margin: 0 auto; }
        .glass-card { background: var(--det-card); border: 1px solid var(--det-border); border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); padding: 25px; height: 100%; }

        .section-heading {
            display: flex; justify-content: between; align-items: center; justify-content: space-between;
            margin: 38px 0 16px;
        }
        .section-heading h6 {
            font-size: 12px; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700;
            color: #94a3b8 !important; margin: 0; display: flex; align-items: center; gap: 8px;
        }
        .section-heading h6 i { color: var(--det-green); }
        .section-heading:first-of-type { margin-top: 4px; }

        /* KPI Strip */
        .kpi-card {
            background: var(--det-card); border: 1px solid var(--det-border); border-radius: 12px;
            padding: 20px; display: flex; align-items: center; gap: 14px; height: 100%;
            box-shadow: 0 6px 18px rgba(0,0,0,0.18); transition: transform 0.2s, border-color 0.2s;
        }
        .kpi-card:hover { transform: translateY(-2px); border-color: rgba(176, 191, 150, 0.45); }
        .kpi-icon {
            width: 46px; height: 46px; min-width: 46px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center; font-size: 20px;
        }
        .kpi-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.6px; color: #94a3b8 !important; font-weight: 600; margin-bottom: 3px; }
        .kpi-value { font-size: 22px; font-weight: 800; color: #fff !important; line-height: 1.1; }
        .kpi-sub { font-size: 11px; color: #94a3b8 !important; margin-top: 2px; }

        .metric-box { background: var(--det-dark); border: 1px solid rgba(255,255,255,0.05); border-radius: 8px; padding: 15px; }
        .metric-title { font-size: 11px; color: #cbd5e1 !important; text-transform: uppercase; font-weight: 600; letter-spacing: 1px; margin-bottom: 8px; }
        .metric-value { font-size: 24px; font-weight: 800; color: #fff !important; margin: 0; }
        .metric-value.accent { color: var(--det-green) !important; }

        canvas { max-height: 260px; width: 100%; }
        .chart-wrap { position: relative; height: 260px; }
        .chart-wrap.short { height: 210px; }

        /* Empty states */
        .empty-state {
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            text-align: center; padding: 34px 20px; color: #94a3b8;
        }
        .empty-state i { font-size: 30px; color: var(--det-border); margin-bottom: 10px; }
        .empty-state strong { color: #cbd5e1; font-size: 14px; display: block; margin-bottom: 4px; }
        .empty-state span { font-size: 12.5px; max-width: 320px; }

        /* Mini list rows */
        .mini-row {
            display: flex; align-items: center; justify-content: space-between; gap: 12px;
            padding: 12px 14px; border-radius: 8px; background: var(--det-dark);
            border: 1px solid rgba(255,255,255,0.05); margin-bottom: 8px;
        }
        .mini-row:last-child { margin-bottom: 0; }
        .rank-badge {
            width: 26px; height: 26px; border-radius: 6px; display: flex; align-items: center; justify-content: center;
            font-size: 11px; font-weight: 800; background: rgba(176,191,150,0.12); color: var(--det-green);
            flex-shrink: 0;
        }
        .rank-badge.rank-1 { background: rgba(176,191,150,0.9); color: var(--det-dark); }

        /* =========================================
           Institutional Table Styling (Ledger)
        ========================================= */
        .table-responsive-wrapper { border-radius: 8px; border: 1px solid var(--det-border); overflow: hidden; }
        .table-responsive {
            overflow-x: auto; overflow-y: hidden; -webkit-overflow-scrolling: touch;
            scrollbar-width: thin; scrollbar-color: var(--det-green) transparent;
        }
        .table-responsive::-webkit-scrollbar { height: 6px; }
        .table-responsive::-webkit-scrollbar-thumb { background: var(--det-border); border-radius: 4px; }
        .table-responsive::-webkit-scrollbar-thumb:hover { background: var(--det-green); }

        .table { margin-bottom: 0; color: #fff !important; min-width: 900px; }
        .table-dark-custom { background-color: var(--det-dark); }
        .table thead th { 
            background-color: #111; color: #cbd5e1 !important; font-weight: 600; font-size: 12px; 
            text-transform: uppercase; letter-spacing: 1px; border-bottom: 2px solid var(--det-border); padding: 15px;
            white-space: nowrap;
        }
        .table tbody td { padding: 15px; border-bottom: 1px solid rgba(255,255,255,0.05); vertical-align: middle; background-color: transparent; color: #fff !important; }
        .table tbody tr:hover td { background-color: rgba(176, 191, 150, 0.05); }
        .table tbody tr.row-hidden { display: none; }

        .swipe-hint { display: none; align-items: center; gap: 6px; font-size: 11px; color: #cbd5e1; margin-bottom: 10px; letter-spacing: 0.5px; }
        .swipe-hint i { color: var(--det-green); animation: swipeMove 1.4s ease-in-out infinite; }
        @keyframes swipeMove { 0%, 100% { transform: translateX(0); opacity: 0.6; } 50% { transform: translateX(6px); opacity: 1; } }
        @media (max-width: 767px) { .swipe-hint { display: flex; } }
        
        .code-pill { background: #1a1818; border: 1px solid var(--det-border); color: var(--det-green) !important; padding: 4px 10px; border-radius: 6px; font-family: monospace; font-size: 13px; font-weight: 600; }
        
        .btn-det { background: var(--det-green); color: var(--det-dark) !important; font-weight: 600; transition: all 0.3s; border: none; }
        .btn-det:hover { background: var(--det-green-hover); color: #000 !important; }

        .ledger-search {
            background: var(--det-dark) !important; border: 1px solid var(--det-border) !important; color: #fff !important;
            padding: 9px 14px 9px 38px; border-radius: 8px; font-size: 14px; max-width: 320px;
        }
        .ledger-search:focus { border-color: var(--det-green) !important; box-shadow: 0 0 0 0.2rem rgba(176,191,150,0.15) !important; }
        .search-wrap { position: relative; }
        .search-wrap i { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: #94a3b8; }

        .status-badge { padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; }
        .bg-det-green { background: rgba(176, 191, 150, 0.15); color: var(--det-green) !important; border: 1px solid rgba(176, 191, 150, 0.3); }
        .bg-det-red { background: rgba(239, 68, 68, 0.15); color: #ef4444 !important; border: 1px solid rgba(239, 68, 68, 0.3); }
        .bg-det-warn { background: rgba(245, 158, 11, 0.15); color: #f59e0b !important; border: 1px solid rgba(245, 158, 11, 0.3); }

        .action-btn {
            width: 34px; height: 34px; border-radius: 8px; border: 1px solid var(--det-border); background: var(--det-dark);
            color: #cbd5e1; display: inline-flex; align-items: center; justify-content: center; transition: all 0.2s; cursor: pointer;
        }
        .btn-manage:hover { border-color: var(--det-green); color: var(--det-green); }
        .btn-ban:hover { border-color: var(--det-amber); color: var(--det-amber); }
        .btn-delete:hover { border-color: var(--det-red); color: var(--det-red); background: rgba(239,68,68,0.08); }
        .btn-details:hover { border-color: var(--det-blue); color: var(--det-blue); }

        /* Active terminal indicator */
        .terminal-active { color: #22c55e !important; }
        .terminal-inactive { color: #94a3b8 !important; }

        /* Modal Overrides */
        .modal-content { background-color: var(--det-card) !important; color: #fff !important; border: 1px solid var(--det-border); border-radius: 12px; }
        .modal-header { border-bottom: 1px solid rgba(255,255,255,0.05); }
        .modal-footer { border-top: 1px solid rgba(255,255,255,0.05); }
        .form-control, .form-select { background-color: var(--det-dark) !important; border: 1px solid var(--det-border) !important; color: #fff !important; padding: 12px; }
        .form-control:focus, .form-select:focus { border-color: var(--det-green) !important; box-shadow: 0 0 0 0.25rem rgba(176, 191, 150, 0.25) !important; color: #fff !important;}
        .btn-close-white { filter: invert(1) grayscale(100%) brightness(200%); }

        /* Detail modal specs */
        .detail-row {
            display: flex; justify-content: space-between; padding: 10px 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }
        .detail-row:last-child { border-bottom: none; }
        .detail-label { color: #94a3b8; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; }
        .detail-value { color: #fff; font-weight: 600; font-size: 14px; }

        @media (max-width: 991px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.show { transform: translateX(0); }
            .main-content { margin-left: 0; }
            .mobile-toggle { display: block; }
            .dashboard-wrapper { padding: 20px 15px; }
        }

                .sidebar-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 1049;
        }
        .sidebar-backdrop.show {
            display: block;
        }
    </style>
</head>
<body>

    <nav class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <a href="/admin" class="text-logo">D.E.T <span>ADMIN</span></a>
        </div>
        <div class="sidebar-nav">
            <small class="text-uppercase fw-bold ms-3 mb-2 d-block" style="font-size: 11px; color: #cbd5e1;">Core Systems</small>
            <div class="nav-item">
                <a href="#overview" class="nav-link active"><i class="bi bi-cpu"></i> Master Node Console</a>
            </div>
            <div class="nav-item">
                <a href="#analytics" class="nav-link"><i class="bi bi-graph-up-arrow"></i> Network Analytics</a>
            </div>
            <div class="nav-item">
                <a href="#live-feed" class="nav-link"><i class="bi bi-broadcast"></i> Live S.M.A.R.T Feed</a>
            </div>
            <div class="nav-item">
                <a href="#negative-logouts" class="nav-link"><i class="bi bi-shield-lock-fill"></i> Negative Account Logouts</a>
            </div>
            <div class="nav-item">
                <a href="#top-earners" class="nav-link"><i class="bi bi-trophy"></i> Top Earners Awards</a>
            </div>
            <div class="nav-item">
                <a href="#ledger" class="nav-link"><i class="bi bi-people"></i> Participant Ledger</a>
            </div>

            <small class="text-uppercase fw-bold ms-3 mt-4 mb-2 d-block" style="font-size: 11px; color: #cbd5e1;">Network Engines (v2.0)</small>
            <div class="nav-item">
                <a href="#affiliates" class="nav-link"><i class="bi bi-diagram-3"></i> Affiliate Network <span class="badge ms-auto text-dark" style="background: #cbd5e1 !important;">BETA</span></a>
            </div>
            <div class="nav-item">
                <a href="#" class="nav-link"><i class="bi bi-globe"></i> Geo-Block Config <span class="badge ms-auto text-dark" style="background: #cbd5e1 !important;">LOCKED</span></a>
            </div>
            <div class="nav-item">
                <a href="#" class="nav-link"><i class="bi bi-shield-lock"></i> Pilot Access Wall <span class="badge ms-auto text-dark" style="background: #cbd5e1 !important;">LOCKED</span></a>
            </div>

            <small class="text-uppercase fw-bold ms-3 mt-4 mb-2 d-block" style="font-size: 11px; color: #cbd5e1;">Quick Navigate</small>
            <div class="nav-item">
                <a href="/" class="nav-link" target="_blank"><i class="bi bi-house"></i> Public Homepage</a>
            </div>
            <div class="nav-item">
                <a href="/pricing" class="nav-link" target="_blank"><i class="bi bi-tags"></i> Pricing Page</a>
            </div>
            <div class="nav-item">
                <a href="/training" class="nav-link" target="_blank"><i class="bi bi-mortarboard"></i> Training Portal</a>
            </div>
            <div class="nav-item">
                <a href="/affiliate" class="nav-link" target="_blank"><i class="bi bi-diagram-3"></i> Affiliate Page</a>
            </div>
            <div class="nav-item">
                <a href="/dashboard" class="nav-link" target="_blank"><i class="bi bi-speedometer2"></i> User Dashboard</a>
            </div>

            <small class="text-uppercase fw-bold ms-3 mt-4 mb-2 d-block" style="font-size: 11px; color: #cbd5e1;">System</small>
            <div class="nav-item">
                <a href="/logout" class="nav-link text-danger"><i class="bi bi-power"></i> Kill Session</a>
            </div>
        </div>
        <div class="sidebar-footer d-flex justify-content-between align-items-center">
            <div><span class="spinner-grow spinner-grow-sm text-success me-2" style="width: 8px; height: 8px;"></span>Node Routing</div>
            <span>v2.0</span>
        </div>
    </nav>

    <main class="main-content">
        
        <header class="top-bar">
            <div class="d-flex align-items-center gap-3">
                <button class="mobile-toggle" id="sidebarToggle"><i class="bi bi-list"></i></button>
                <h5 class="mb-0 fw-bold d-none d-md-block text-white">Central Command Hub</h5>
            </div>
            
            <div class="d-flex align-items-center gap-3">
                <!-- Quick Navigation Buttons -->
                <a href="/" target="_blank" class="nav-quick-btn d-none d-lg-inline-flex" title="Public Homepage">
                    <i class="bi bi-house"></i> <span>Site</span>
                </a>
                <a href="/pricing" target="_blank" class="nav-quick-btn d-none d-lg-inline-flex" title="Pricing">
                    <i class="bi bi-tags"></i> <span>Pricing</span>
                </a>
                <a href="/training" target="_blank" class="nav-quick-btn d-none d-lg-inline-flex" title="Training">
                    <i class="bi bi-mortarboard"></i> <span>Training</span>
                </a>
                <a href="/dashboard" target="_blank" class="nav-quick-btn d-none d-lg-inline-flex" title="User Dashboard">
                    <i class="bi bi-speedometer2"></i> <span>Dashboard</span>
                </a>
                <div class="text-end d-none d-sm-block">
                    <small class="d-block" style="font-size: 11px; line-height: 1; color: #cbd5e1;">Administrator</small>
                    <span class="fw-bold" style="font-size: 14px; color: var(--det-green) !important;"><%= currentUser.username.toUpperCase() %></span>
                </div>
            </div>
        </header>

        <div class="dashboard-wrapper">
            
            <% if(success && success.length > 0) { %> 
                <div class="alert bg-success bg-opacity-10 border-success text-success fw-bold" style="border-radius: 8px;"><i class="bi bi-check-circle me-2"></i><%= success %></div> 
            <% } %>
            <% if(error && error.length > 0) { %> 
                <div class="alert bg-danger bg-opacity-10 border-danger text-danger fw-bold" style="border-radius: 8px;"><i class="bi bi-exclamation-triangle me-2"></i><%= error %></div> 
            <% } %>

            <!-- =========================================
                 OVERVIEW — KPI STRIP (with total visitors)
            ========================================= -->
            <div id="overview"></div>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-6 g-3 mb-2">
                <div class="col">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background: rgba(176,191,150,0.12); color: var(--det-green);"><i class="bi bi-people-fill"></i></div>
                        <div>
                            <div class="kpi-label">Total Visitors</div>
                            <div class="kpi-value"><%= stats.totalVisitors.toLocaleString() %></div>
                            <div class="kpi-sub">All-time site visits</div>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background: rgba(56,189,248,0.12); color: var(--det-blue);"><i class="bi bi-person-check"></i></div>
                        <div>
                            <div class="kpi-label">Total Accounts</div>
                            <div class="kpi-value"><%= stats.total %></div>
                            <div class="kpi-sub">Registered participants</div>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background: rgba(56,189,248,0.12); color: var(--det-blue);"><i class="bi bi-shield-check"></i></div>
                        <div>
                            <div class="kpi-label">Active Licenses</div>
                            <div class="kpi-value"><%= stats.active %></div>
                            <div class="kpi-sub"><%= stats.total > 0 ? Math.round((stats.active / stats.total) * 100) : 0 %>% of network</div>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background: rgba(239,68,68,0.12); color: var(--det-red);"><i class="bi bi-shield-lock-fill"></i></div>
                        <div>
                            <div class="kpi-label">Negative Logouts</div>
                            <div class="kpi-value"><%= stats.locked %></div>
                            <div class="kpi-sub">Zero-Hedge closures</div>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background: rgba(34, 197, 94, 0.12); color: #22c55e;"><i class="bi bi-graph-up-arrow"></i></div>
                        <div>
                            <div class="kpi-label">Positive Logouts</div>
                            <div class="kpi-value"><%= stats.locked %></div>
                            <div class="kpi-sub">100% gain achieved</div>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background: rgba(176,191,150,0.12); color: var(--det-green);"><i class="bi bi-cash-stack"></i></div>
                        <div>
                            <div class="kpi-label">Total Revenue</div>
                            <div class="kpi-value">$<%= stats.totalRevenue.toLocaleString() %></div>
                            <div class="kpi-sub">Payouts to affiliates: $<%= stats.totalAffiliatePayouts.toLocaleString() %></div>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background: rgba(245,158,11,0.12); color: var(--det-amber);"><i class="bi bi-hourglass-split"></i></div>
                        <div>
                            <div class="kpi-label">Unlicensed / Pending</div>
                            <div class="kpi-value"><%= stats.unlicensed %></div>
                            <div class="kpi-sub"><%= stats.suspended %> banned · <%= stats.expired %> expired</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- =========================================
                 ANALYTICS — CHARTS
            ========================================= -->
            <div id="analytics"></div>
            <div class="section-heading">
                <h6><i class="bi bi-graph-up-arrow"></i> Network Analytics</h6>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-xl-8">
                    <div class="glass-card">
                        <h6 class="fw-bold mb-1 text-white">Registrations — Last 30 Days</h6>
                        <p class="text-secondary small mb-3">New accounts created per day, network-wide.</p>
