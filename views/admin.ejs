                            <div class="chart-wrap">
                                <canvas id="revenueChart"></canvas>
                            </div>
                        <% } else { %>
                            <div class="empty-state">
                                <i class="bi bi-bar-chart"></i>
                                <strong>No verified sales yet</strong>
                                <span>This chart activates automatically the moment a Paynow payment is confirmed for any tier.</span>
                            </div>
                        <% } %>
                    </div>
                </div>
                <div class="col-xl-6">
