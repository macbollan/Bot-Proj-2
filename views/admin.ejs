<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>D.E.T System | Master Node Console</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    
    <style>
        :root {
            --det-green: #B0BF96;
            --det-green-hover: #96a67c;
            --det-dark: #0a0a0a;
            --det-card: #141414;
            --det-card-hover: #1a1a1a;
            --det-border: rgba(176, 191, 150, 0.15);
            --det-border-active: rgba(176, 191, 150, 0.35);
            --det-red: #ef4444;
            --det-amber: #f59e0b;
            --det-blue: #38bdf8;
            --det-purple: #a78bfa;
            --det-emerald: #10b981;
            --sidebar-width: 280px;
            --transition-speed: 0.25s;
        }

        * { scrollbar-width: thin; scrollbar-color: var(--det-border) transparent; }
        *::-webkit-scrollbar { width: 6px; height: 6px; }
        *::-webkit-scrollbar-thumb { background: var(--det-border); border-radius: 3px; }
        *::-webkit-scrollbar-thumb:hover { background: var(--det-green); }

        body { 
            background-color: var(--det-dark); 
            color: #e2e8f0; 
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; 
            overflow-x: hidden; 
            margin: 0;
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
        }

        /* =========================================
           PREMIUM SIDEBAR
        ========================================= */
        .sidebar {
            position: fixed; top: 0; left: 0; height: 100vh; width: var(--sidebar-width);
            background: linear-gradient(180deg, #0f0f0f 0%, #0a0a0a 100%);
            border-right: 1px solid var(--det-border);
            z-index: 1050; display: flex; flex-direction: column; 
            transition: transform var(--transition-speed) cubic-bezier(0.4, 0, 0.2, 1);
            backdrop-filter: blur(10px);
        }
        .sidebar-header { 
            padding: 28px 24px; 
            border-bottom: 1px solid var(--det-border);
            background: linear-gradient(135deg, rgba(176,191,150,0.05) 0%, transparent 100%);
        }
        .text-logo { 
            color: var(--det-green) !important; 
            font-size: 24px; 
            font-weight: 800; 
            text-decoration: none; 
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .text-logo span { 
            color: #ffffff !important; 
            font-weight: 400;
            font-size: 16px;
            background: rgba(176,191,150,0.1);
            padding: 4px 12px;
            border-radius: 6px;
            letter-spacing: 2px;
        }
        
        .sidebar-nav { 
            padding: 20px 12px; 
            flex-grow: 1; 
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }
        .nav-section {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 700;
            color: #64748b !important;
            padding: 16px 16px 8px;
            margin-top: 8px;
        }
        .nav-section:first-child { margin-top: 0; }
        
        .nav-link {
            display: flex; align-items: center; padding: 12px 16px; 
            color: #94a3b8 !important;
            text-decoration: none; border-radius: 10px; font-weight: 500; 
            font-size: 13.5px; transition: all var(--transition-speed); position: relative;
            margin: 1px 0;
        }
        .nav-link i { margin-right: 12px; font-size: 18px; width: 20px; text-align: center; opacity: 0.7; transition: all var(--transition-speed); }
        .nav-link:hover { 
            color: #fff !important; 
            background: rgba(255,255,255,0.04); 
            transform: translateX(2px);
        }
        .nav-link:hover i { opacity: 1; }
        .nav-link.active { 
            color: var(--det-dark) !important; 
            background: linear-gradient(135deg, var(--det-green) 0%, var(--det-green-hover) 100%);
            font-weight: 600; 
            box-shadow: 0 4px 12px rgba(176,191,150,0.25);
        }
        .nav-link.active i { opacity: 1; color: var(--det-dark); }
        .nav-link .badge { 
            font-size: 9px; 
            padding: 3px 8px; 
            border-radius: 12px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }
        .badge-beta { background: rgba(245,158,11,0.15); color: #f59e0b; }
        .badge-locked { background: rgba(100,116,139,0.2); color: #94a3b8; }

        .sidebar-footer { 
            padding: 20px 24px; 
            border-top: 1px solid var(--det-border); 
            font-size: 12px; 
            color: #64748b;
            background: rgba(0,0,0,0.3);
        }

        /* =========================================
           MAIN CONTENT AREA
        ========================================= */
        .main-content { 
            margin-left: var(--sidebar-width); 
            min-height: 100vh; 
            display: flex; 
            flex-direction: column; 
            transition: margin-left var(--transition-speed);
            background: radial-gradient(ellipse at top right, rgba(176,191,150,0.03) 0%, transparent 60%);
        }

        .top-bar {
            background: rgba(10,10,10,0.8); 
            backdrop-filter: blur(20px);
            padding: 16px 32px; 
            border-bottom: 1px solid var(--det-border);
            display: flex; justify-content: space-between; align-items: center; 
            position: sticky; top: 0; z-index: 1040;
        }
        .mobile-toggle { display: none; color: var(--det-green); font-size: 24px; cursor: pointer; background: none; border: none; padding: 8px; border-radius: 8px; transition: all var(--transition-speed); }
        .mobile-toggle:hover { background: rgba(176,191,150,0.1); }
        
        .nav-quick-btn {
            background: var(--det-card); border: 1px solid var(--det-border); 
            color: #94a3b8; padding: 8px 18px; border-radius: 10px; 
            font-size: 12.5px; font-weight: 500; text-decoration: none; 
            transition: all var(--transition-speed); display: inline-flex; align-items: center; gap: 7px;
        }
        .nav-quick-btn:hover { 
            background: rgba(176,191,150,0.1); 
            color: var(--det-green); 
            border-color: var(--det-border-active); 
            transform: translateY(-1px);
        }

        .dashboard-wrapper { padding: 32px; max-width: 1800px; width: 100%; margin: 0 auto; }
        
        /* =========================================
           GLASS CARDS & KPI
        ========================================= */
        .glass-card { 
            background: var(--det-card); 
            border: 1px solid var(--det-border); 
            border-radius: 16px; 
            box-shadow: 0 4px 24px rgba(0,0,0,0.3); 
            padding: 28px; 
            height: 100%;
            transition: all var(--transition-speed);
            position: relative;
            overflow: hidden;
        }
        .glass-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(176,191,150,0.1), transparent);
        }
        .glass-card:hover {
            border-color: var(--det-border-active);
            box-shadow: 0 8px 32px rgba(0,0,0,0.4);
        }

        .section-heading {
            display: flex; align-items: center; justify-content: space-between;
            margin: 40px 0 20px;
        }
        .section-heading:first-of-type { margin-top: 0; }
        .section-heading h6 {
            font-size: 11px; text-transform: uppercase; letter-spacing: 2px; font-weight: 700;
            color: #64748b !important; margin: 0; display: flex; align-items: center; gap: 10px;
        }
        .section-heading h6 i { color: var(--det-green); font-size: 16px; }

        /* KPI Cards */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 16px;
            margin-bottom: 32px;
        }
        .kpi-card {
            background: var(--det-card); 
            border: 1px solid var(--det-border); 
            border-radius: 16px;
            padding: 24px; 
            display: flex; 
            align-items: center; 
            gap: 16px; 
            transition: all var(--transition-speed);
            cursor: default;
        }
        .kpi-card:hover { 
            transform: translateY(-2px); 
            border-color: var(--det-border-active);
            box-shadow: 0 12px 40px rgba(0,0,0,0.3);
        }
        .kpi-icon {
            width: 52px; height: 52px; min-width: 52px; border-radius: 14px;
            display: flex; align-items: center; justify-content: center; font-size: 22px;
        }
        .kpi-content { flex: 1; min-width: 0; }
        .kpi-label { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: #64748b !important; font-weight: 600; margin-bottom: 4px; }
        .kpi-value { font-size: 26px; font-weight: 800; color: #fff !important; line-height: 1.1; margin-bottom: 2px; }
        .kpi-sub { font-size: 11px; color: #64748b !important; }

        /* =========================================
           TABLES & PAGINATION
        ========================================= */
        .table-container {
            border-radius: 12px;
            border: 1px solid var(--det-border);
            overflow: hidden;
            background: var(--det-dark);
        }
        .table-responsive {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        .table {
            margin-bottom: 0;
            color: #e2e8f0 !important;
            min-width: 900px;
            border-collapse: separate;
            border-spacing: 0;
        }
        .table thead th { 
            background: #0a0a0a; 
            color: #94a3b8 !important; 
            font-weight: 600; 
            font-size: 11px; 
            text-transform: uppercase; 
            letter-spacing: 1.5px; 
            border-bottom: 2px solid var(--det-border); 
            padding: 16px;
            white-space: nowrap;
            position: sticky;
            top: 0;
            z-index: 1;
        }
        .table tbody td { 
            padding: 16px; 
            border-bottom: 1px solid rgba(255,255,255,0.03); 
            vertical-align: middle; 
            background-color: transparent; 
            color: #e2e8f0 !important;
            font-size: 14px;
        }
        .table tbody tr { transition: all var(--transition-speed); }
        .table tbody tr:hover td { background-color: rgba(176, 191, 150, 0.03); }
        .table tbody tr.row-hidden { display: none; }

        /* Pagination */
        .pagination-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 20px;
            background: #0a0a0a;
            border-top: 1px solid var(--det-border);
            flex-wrap: wrap;
            gap: 12px;
        }
        .pagination-info {
            font-size: 13px;
            color: #94a3b8;
        }
        .pagination-controls {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .pagination {
            display: flex;
            gap: 4px;
            margin: 0;
            list-style: none;
            padding: 0;
        }
        .page-btn {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            border: 1px solid var(--det-border);
            background: var(--det-card);
            color: #94a3b8;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all var(--transition-speed);
            user-select: none;
        }
        .page-btn:hover:not(:disabled):not(.active) {
            border-color: var(--det-green);
            color: var(--det-green);
            background: rgba(176,191,150,0.05);
        }
        .page-btn.active {
            background: var(--det-green);
            color: var(--det-dark);
            border-color: var(--det-green);
            font-weight: 700;
        }
        .page-btn:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }
        .page-size-select {
            background: var(--det-card);
            border: 1px solid var(--det-border);
            color: #94a3b8;
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 13px;
            cursor: pointer;
            outline: none;
        }
        .page-size-select:focus {
            border-color: var(--det-green);
        }

        /* Status Badges */
        .status-badge {
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            display: inline-block;
        }
        .bg-det-green { background: rgba(176, 191, 150, 0.12); color: var(--det-green) !important; border: 1px solid rgba(176, 191, 150, 0.25); }
        .bg-det-red { background: rgba(239, 68, 68, 0.12); color: #ef4444 !important; border: 1px solid rgba(239, 68, 68, 0.25); }
        .bg-det-warn { background: rgba(245, 158, 11, 0.12); color: #f59e0b !important; border: 1px solid rgba(245, 158, 11, 0.25); }
        .bg-det-blue { background: rgba(56, 189, 248, 0.12); color: var(--det-blue) !important; border: 1px solid rgba(56, 189, 248, 0.25); }
        .bg-det-slate { background: rgba(100, 116, 139, 0.15); color: #94a3b8 !important; border: 1px solid rgba(100, 116, 139, 0.25); }

        .code-pill { 
            background: #0a0a0a; 
            border: 1px solid var(--det-border); 
            color: var(--det-green) !important; 
            padding: 5px 12px; 
            border-radius: 8px; 
            font-family: 'SF Mono', 'Fira Code', monospace; 
            font-size: 12px; 
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        /* Action Buttons */
        .btn-det { 
            background: linear-gradient(135deg, var(--det-green) 0%, var(--det-green-hover) 100%);
            color: var(--det-dark) !important; 
            font-weight: 600; 
            transition: all var(--transition-speed); 
            border: none;
            border-radius: 10px;
            padding: 10px 20px;
            font-size: 13px;
        }
        .btn-det:hover { 
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(176,191,150,0.3);
            color: #000 !important; 
        }
        
        .action-group {
            display: flex;
            gap: 6px;
            justify-content: flex-end;
        }
        .action-btn {
            width: 36px; 
            height: 36px; 
            border-radius: 10px; 
            border: 1px solid var(--det-border); 
            background: var(--det-card);
            color: #94a3b8; 
            display: inline-flex; 
            align-items: center; 
            justify-content: center; 
            transition: all var(--transition-speed); 
            cursor: pointer;
            font-size: 14px;
        }
        .action-btn:hover { transform: translateY(-1px); }
        .btn-manage:hover { border-color: var(--det-green); color: var(--det-green); background: rgba(176,191,150,0.08); }
        .btn-ban:hover { border-color: var(--det-amber); color: var(--det-amber); background: rgba(245,158,11,0.08); }
        .btn-delete:hover { border-color: var(--det-red); color: var(--det-red); background: rgba(239,68,68,0.08); }
        .btn-details:hover { border-color: var(--det-blue); color: var(--det-blue); background: rgba(56,189,248,0.08); }

        /* Terminal indicator */
        .terminal-active { color: var(--det-emerald) !important; }
        .terminal-inactive { color: #64748b !important; }

        /* Search */
        .search-box {
            position: relative;
            min-width: 280px;
        }
        .search-box i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 16px;
        }
        .search-input {
            background: #0a0a0a !important;
            border: 1px solid var(--det-border) !important;
            color: #e2e8f0 !important;
            padding: 10px 16px 10px 42px;
            border-radius: 10px;
            font-size: 14px;
            width: 100%;
            transition: all var(--transition-speed);
        }
        .search-input:focus {
            border-color: var(--det-green) !important;
            box-shadow: 0 0 0 3px rgba(176,191,150,0.1) !important;
            outline: none;
        }
        .search-input::placeholder { color: #64748b; }

        /* Empty states */
        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 48px 24px;
            color: #64748b;
        }
        .empty-state i { 
            font-size: 40px; 
            color: var(--det-border); 
            margin-bottom: 16px;
            opacity: 0.5;
        }
        .empty-state strong { color: #94a3b8; font-size: 15px; display: block; margin-bottom: 6px; }
        .empty-state span { font-size: 13px; max-width: 360px; line-height: 1.5; }

        /* Mini rows */
        .mini-row {
            display: flex; align-items: center; justify-content: space-between; gap: 12px;
            padding: 14px 16px; border-radius: 10px; background: #0a0a0a;
            border: 1px solid rgba(255,255,255,0.03); margin-bottom: 8px;
            transition: all var(--transition-speed);
        }
        .mini-row:hover { border-color: var(--det-border); background: var(--det-card); }
        .mini-row:last-child { margin-bottom: 0; }
        .rank-badge {
            width: 30px; height: 30px; border-radius: 8px; display: flex; align-items: center; justify-content: center;
            font-size: 12px; font-weight: 800; background: rgba(176,191,150,0.1); color: var(--det-green);
            flex-shrink: 0;
        }
        .rank-badge.rank-1 { background: linear-gradient(135deg, #f59e0b, #d97706); color: #000; }
        .rank-badge.rank-2 { background: linear-gradient(135deg, #94a3b8, #64748b); color: #000; }
        .rank-badge.rank-3 { background: linear-gradient(135deg, #cd853f, #8b6914); color: #000; }

        /* Modal */
        .modal-content { 
            background-color: var(--det-card) !important; 
            color: #e2e8f0 !important; 
            border: 1px solid var(--det-border); 
            border-radius: 16px; 
            box-shadow: 0 24px 80px rgba(0,0,0,0.6);
        }
        .modal-header { border-bottom: 1px solid rgba(255,255,255,0.05); padding: 24px 28px; }
        .modal-footer { border-top: 1px solid rgba(255,255,255,0.05); padding: 20px 28px; }
        .modal-body { padding: 24px 28px; }
        .form-control, .form-select { 
            background-color: #0a0a0a !important; 
            border: 1px solid var(--det-border) !important; 
            color: #e2e8f0 !important; 
            padding: 12px 16px; 
            border-radius: 10px;
            font-size: 14px;
            transition: all var(--transition-speed);
        }
        .form-control:focus, .form-select:focus { 
            border-color: var(--det-green) !important; 
            box-shadow: 0 0 0 3px rgba(176, 191, 150, 0.1) !important; 
        }
        .btn-close-white { filter: invert(1) grayscale(100%) brightness(200%); }

        /* Detail rows */
        .detail-row {
            display: flex; justify-content: space-between; align-items: center;
            padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,0.03);
        }
        .detail-row:last-child { border-bottom: none; }
        .detail-label { color: #64748b; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; }
        .detail-value { color: #e2e8f0; font-weight: 600; font-size: 14px; text-align: right; }

        /* Charts */
        .chart-wrap { position: relative; height: 280px; }
        .chart-wrap.short { height: 220px; }

        /* Responsive */
        @media (max-width: 1199px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.show { transform: translateX(0); }
            .main-content { margin-left: 0; }
            .mobile-toggle { display: block; }
            .dashboard-wrapper { padding: 20px 16px; }
            .kpi-grid { grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
        }
        @media (max-width: 767px) {
            .kpi-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
            .kpi-value { font-size: 22px; }
            .top-bar { padding: 12px 16px; }
            .nav-quick-btn { display: none; }
            .search-box { min-width: 100%; }
            .pagination-container { flex-direction: column; align-items: flex-start; }
        }

        .sidebar-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.6);
            z-index: 1049;
            backdrop-filter: blur(2px);
        }
        .sidebar-backdrop.show { display: block; }
    </style>
</head>
