<%- include('partials/header', { title: 'Affiliate Dashboard | D.E.T System', page: 'affiliate' }) %>

<style>
    .dashboard-card {
        background: var(--det-card);
        border: 1px solid var(--det-border);
        border-radius: 14px;
        padding: 25px;
        margin-bottom: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    }
    .stat-box {
        background: var(--det-dark);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 10px;
        padding: 20px;
        text-align: center;
    }
    .stat-value {
        font-size: 28px;
        font-weight: 800;
        color: var(--det-green);
    }
    .stat-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #94a3b8;
        margin-top: 4px;
    }
    .referral-link-box {
        background: var(--det-dark);
        border: 1px dashed var(--det-green);
        border-radius: 8px;
        padding: 14px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
    }
    .referral-link-box code {
        color: var(--det-green);
        font-size: 14px;
        word-break: break-all;
        font-family: 'Courier New', monospace;
    }
    .copy-btn {
        background: var(--det-green);
        color: var(--det-dark);
        border: none;
        padding: 8px 18px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        font-size: 13px;
        white-space: nowrap;
        transition: all 0.2s;
    }
    .copy-btn:hover { background: var(--det-green-hover); }
    .copy-btn:disabled { opacity: 0.5; cursor: not-allowed; background: #475569; color: #cbd5e1; }
    
    .table thead th { 
        background: #111 !important; 
        color: #cbd5e1 !important; 
        font-size: 11px; 
        text-transform: uppercase; 
        letter-spacing: 1px; 
        padding: 14px 15px; 
        border-bottom: 2px solid var(--det-border); 
        font-weight: 600;
        white-space: nowrap;
    }
    .table tbody td { 
        padding: 14px 15px; 
        border-bottom: 1px solid rgba(255,255,255,0.05); 
        vertical-align: middle; 
        background: transparent;
        color: #fff !important; 
        font-size: 13px;
    }
    .table tbody tr:hover td {
        background: rgba(176,191,150,0.03) !important;
    }

    /* =========================================
       PAYOUT METHOD TILES (NEW)
    ========================================= */
    .payout-method-tile {
        background: rgba(0,0,0,0.25);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 8px;
        padding: 12px 8px;
        text-align: center;
        cursor: pointer;
        font-size: 12px;
        font-weight: 600;
        color: #cbd5e1;
        transition: all 0.2s;
    }
    .payout-method-tile i { display:block; font-size:18px; margin-bottom:4px; color:#94a3b8; }
    .payout-method-tile:hover { border-color: rgba(176,191,150,0.4); color: #fff; }
    .payout-method-tile.active {
        background: rgba(176,191,150,0.12);
        border-color: var(--det-green);
        color: var(--det-green);
    }
    .payout-method-tile.active i { color: var(--det-green); }

    .payout-field-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--det-green);
        font-weight: 700;
        margin-bottom: 6px;
        display: block;
    }
    .payout-input {
        background: rgba(0,0,0,0.3);
        border: 1px solid rgba(255,255,255,0.1);
        color: #fff;
        padding: 10px 14px;
        border-radius: 8px;
        width: 100%;
        font-size: 14px;
        margin-bottom: 12px;
    }
    .payout-input:focus {
        outline: none;
        border-color: var(--det-green);
        box-shadow: 0 0 0 3px rgba(176,191,150,0.1);
    }
    
    @media (max-width: 768px) {
        .stat-value { font-size: 22px; }
        .referral-link-box { flex-direction: column; text-align: center; }
        .referral-link-box code { font-size: 12px; }
        .dashboard-card { padding: 18px; }
        .table thead th { padding: 10px; font-size: 10px; }
        .table tbody td { padding: 10px; font-size: 12px; }
    }
</style>

<div class="container" style="max-width: 900px; margin-top: 30px; margin-bottom: 60px;">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: #fff;">Affiliate Dashboard</h3>
            <p style="color: #94a3b8; font-size: 14px;">Welcome back, <%= affiliate.username %> 🎯</p>
        </div>
        <span style="background: rgba(176,191,150,0.15); color: var(--det-green); border: 1px solid rgba(176,191,150,0.3); padding: 6px 16px; border-radius: 20px; font-size: 12px; font-weight: 600;">
            <%= affiliate.isActive ? 'Active' : 'Inactive' %>
        </span>
    </div>

    <!-- Stats Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="stat-box">
                <div class="stat-value"><%= affiliate.totalClicks.toLocaleString() %></div>
                <div class="stat-label">Total Clicks</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-box">
                <div class="stat-value"><%= affiliate.totalReferrals %></div>
                <div class="stat-label">Referrals</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-box">
                <div class="stat-value">$<%= affiliate.pendingEarnings.toFixed(2) %></div>
                <div class="stat-label">Pending</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-box">
                <div class="stat-value">$<%= affiliate.paidEarnings.toFixed(2) %></div>
                <div class="stat-label">Paid Out</div>
            </div>
        </div>
    </div>

    <!-- Referral Link -->
    <div class="dashboard-card">
        <h5 class="fw-bold mb-3" style="color: #fff;"><i class="bi bi-link-45deg me-2" style="color: var(--det-green);"></i>Your Referral Link</h5>
        <div class="referral-link-box">
            <code id="refLink">https://bot-proj-2-1.onrender.com<%= affiliate.affiliateLink %></code>
            <button class="copy-btn" onclick="copyRefLink()">
                <i class="bi bi-clipboard me-1"></i> Copy Link
            </button>
        </div>
        <small style="color: #94a3b8; display: block; margin-top: 8px;">
            Share this link anywhere. You earn <strong style="color: var(--det-green);">20% commission</strong> when someone subscribes through it.
        </small>
    </div>

    <!-- Recent Referrals -->
    <div class="dashboard-card">
        <h5 class="fw-bold mb-3" style="color: #fff;"><i class="bi bi-people-fill me-2" style="color: var(--det-green);"></i>Recent Referrals</h5>
        
        <% if(recentReferrals && recentReferrals.length > 0) { %>
            <div class="table-responsive">
                <table class="table align-middle mb-0" style="background: var(--det-dark); border-radius: 8px; overflow: hidden;">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Tier</th>
                            <th>Amount</th>
                            <th>Commission</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentReferrals.forEach(ref => { %>
                            <tr>
                                <td>
                                    <div class="fw-bold" style="color: #fff !important; font-size: 13px;"><%= ref.username %></div>
                                    <small style="color: #94a3b8 !important; font-size: 11px;"><%= ref.email %></small>
                                </td>
                                <td>
                                    <span style="background: rgba(0,0,0,0.3); border: 1px solid var(--det-border); color: #cbd5e1 !important; padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: 500;"><%= ref.tier %></span>
                                </td>
                                <td style="color: #fff !important; font-size: 13px;">
                                    $<%= (ref.amountPaid || 0).toFixed(2) %>
                                </td>
                                <td style="color: var(--det-green) !important; font-weight: 600; font-size: 13px;">
                                    $<%= (ref.commissionEarned || 0).toFixed(2) %>
                                </td>
                                <td>
                                    <% if(ref.status === 'confirmed') { %>
                                        <span style="background: rgba(34,197,94,0.15); color: #22c55e !important; padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: 600; border: 1px solid rgba(34,197,94,0.3); white-space: nowrap;">
                                            <i class="bi bi-check-circle me-1"></i> Confirmed
                                        </span>
                                    <% } else if(ref.status === 'paid') { %>
                                        <span style="background: rgba(56,189,248,0.15); color: #38bdf8 !important; padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: 600; border: 1px solid rgba(56,189,248,0.3); white-space: nowrap;">
                                            <i class="bi bi-cash me-1"></i> Paid
                                        </span>
                                    <% } else { %>
                                        <span style="background: rgba(245,158,11,0.15); color: #f59e0b !important; padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: 600; border: 1px solid rgba(245,158,11,0.3); white-space: nowrap;">
                                            <i class="bi bi-hourglass-split me-1"></i> Pending
                                        </span>
                                    <% } %>
                                </td>
                                <td style="font-size: 12px; color: #94a3b8 !important;">
                                    <%= new Date(ref.referredAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div style="text-align: center; padding: 50px 20px; color: #94a3b8;">
                <i class="bi bi-people" style="font-size: 48px; display: block; margin-bottom: 15px; opacity: 0.5;"></i>
                <p class="fw-bold" style="color: #cbd5e1 !important; font-size: 16px; margin-bottom: 5px;">No referrals yet</p>
                <p style="font-size: 13px; color: #94a3b8 !important;">Share your link to start earning commissions!</p>
            </div>
        <% } %>
    </div>

    <!-- =========================================
         REQUEST PAYOUT (NEW — opens modal)
    ========================================= -->
    <div class="dashboard-card">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h5 class="fw-bold mb-1" style="color: #fff;">
                    <i class="bi bi-cash-stack me-2" style="color: var(--det-green);"></i>Request Payout
                </h5>
                <p style="color: #94a3b8; font-size: 13px;">
                    Minimum payout: <strong style="color: #fff;">$50.00</strong> ·
                    Available: <strong style="color: var(--det-green);">$<%= affiliate.pendingEarnings.toFixed(2) %></strong>
                </p>
            </div>
            <button type="button" class="copy-btn"
                    data-bs-toggle="modal" data-bs-target="#payoutModal"
                    <%= affiliate.pendingEarnings < 50 ? 'disabled' : '' %>>
                <i class="bi bi-wallet2 me-1"></i> Withdraw $<%= affiliate.pendingEarnings.toFixed(2) %>
            </button>
        </div>
        <% if(affiliate.pendingEarnings < 50) { %>
            <small style="color: #64748b; display: block; margin-top: 8px;">
                You need $<%= (50 - affiliate.pendingEarnings).toFixed(2) %> more to request a payout.
            </small>
        <% } %>
    </div>

</div>

<!-- =========================================
     PAYOUT MODAL (NEW)
========================================= -->
<div class="modal fade" id="payoutModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="background: var(--det-card); border: 1px solid var(--det-border); color:#fff; border-radius:14px;">
      <form action="/affiliate/request-payout" method="POST" id="payoutForm">
        <div class="modal-header" style="border-bottom:1px solid rgba(255,255,255,0.05);">
          <h5 class="modal-title fw-bold text-white">
            <i class="bi bi-cash-stack me-2" style="color: var(--det-green);"></i>
            Withdraw $<%= affiliate.pendingEarnings.toFixed(2) %>
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">

          <span class="payout-field-label">Choose Payout Method</span>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <div class="payout-method-tile active" data-method="ecocash" onclick="selectPayoutMethod('ecocash')">
                <i class="bi bi-phone-fill"></i> EcoCash
              </div>
            </div>
            <div class="col-6">
              <div class="payout-method-tile" data-method="onemoney" onclick="selectPayoutMethod('onemoney')">
                <i class="bi bi-phone-fill"></i> OneMoney
              </div>
            </div>
            <div class="col-6">
              <div class="payout-method-tile" data-method="innbucks" onclick="selectPayoutMethod('innbucks')">
                <i class="bi bi-wallet-fill"></i> InnBucks
              </div>
            </div>
            <div class="col-6">
              <div class="payout-method-tile" data-method="bank_transfer" onclick="selectPayoutMethod('bank_transfer')">
                <i class="bi bi-bank"></i> Bank / Paynow ZIPIT
              </div>
            </div>
          </div>

          <input type="hidden" name="method" id="payoutMethod" value="ecocash">

          <!-- Mobile money fields -->
          <div id="mobileFields">
            <label class="payout-field-label">Mobile Number (registered with EcoCash/OneMoney/InnBucks)</label>
            <input type="tel" name="payoutPhone" id="payoutPhone" class="payout-input"
                   placeholder="077XXXXXXX" maxlength="13"
                   value="<%= affiliate.payoutPhone || '' %>">
          </div>

          <!-- Bank fields -->
          <div id="bankFields" style="display:none;">
            <label class="payout-field-label">Bank Name</label>
            <input type="text" name="bankName" class="payout-input" placeholder="e.g. CBZ Bank"
                   value="<%= affiliate.payoutBank?.bankName || '' %>">

            <label class="payout-field-label">Account Holder Name</label>
            <input type="text" name="accountName" class="payout-input"
                   value="<%= affiliate.payoutBank?.accountName || '' %>">

            <div class="row g-2">
              <div class="col-8">
                <label class="payout-field-label">Account Number</label>
                <input type="text" name="accountNumber" class="payout-input"
                       value="<%= affiliate.payoutBank?.accountNumber || '' %>">
              </div>
              <div class="col-4">
                <label class="payout-field-label">Branch Code</label>
                <input type="text" name="branchCode" class="payout-input"
                       value="<%= affiliate.payoutBank?.branchCode || '' %>">
              </div>
            </div>
          </div>

          <div style="background: rgba(176,191,150,0.06); border:1px solid rgba(176,191,150,0.15); border-radius:8px; padding:10px 12px; font-size:11px; color:#cbd5e1;">
            <i class="bi bi-info-circle me-1" style="color: var(--det-green);"></i>
            Payouts are processed within <strong>3 business days</strong> after admin approval.
          </div>
        </div>
        <div class="modal-footer" style="border-top:1px solid rgba(255,255,255,0.05);">
          <button type="button" class="btn btn-outline-light btn-sm" data-bs-dismiss="modal" style="border-radius:8px;">Cancel</button>
          <button type="submit" class="copy-btn">
            <i class="bi bi-check-circle me-1"></i> Submit Request
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function copyRefLink() {
    const link = document.getElementById('refLink').innerText;
    navigator.clipboard.writeText(link).then(() => {
        const btn = document.querySelector('.copy-btn');
        const original = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Copied!';
        btn.style.background = '#22c55e';
        setTimeout(() => {
            btn.innerHTML = original;
            btn.style.background = '';
        }, 2000);
    }).catch(() => {
        alert('Link: ' + link);
    });
}

function selectPayoutMethod(method) {
    document.querySelectorAll('.payout-method-tile').forEach(t => t.classList.remove('active'));
    document.querySelector(`[data-method="${method}"]`).classList.add('active');
    document.getElementById('payoutMethod').value = method;

    const mobileFields = document.getElementById('mobileFields');
    const bankFields = document.getElementById('bankFields');
    const phoneInput = document.getElementById('payoutPhone');

    if (method === 'bank_transfer') {
        mobileFields.style.display = 'none';
        bankFields.style.display = 'block';
    } else {
        mobileFields.style.display = 'block';
        bankFields.style.display = 'none';
        if (method === 'ecocash')  phoneInput.placeholder = '077XXXXXXX';
        if (method === 'onemoney') phoneInput.placeholder = '071XXXXXXX';
        if (method === 'innbucks') phoneInput.placeholder = 'InnBucks number';
    }
}
</script>

<%- include('partials/footer') %>