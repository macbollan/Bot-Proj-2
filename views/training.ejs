<script>
// ============================================================
// TRAINING ENROLLMENT SYSTEM
// ============================================================

const trainingConfig = {
    ECD: { minStudents: 5, durationDays: 5, hoursPerDay: 3 },
    Beginner: { minStudents: 5, durationDays: 5, hoursPerDay: 2 },
    Advanced: { minStudents: 5, durationDays: 5, hoursPerDay: 2 },
    Specialized: { minStudents: 5, durationDays: 14, hoursPerDay: 1 }
};

const paidStudents = {
    ECD: [],
    Beginner: [],
    Advanced: [],
    Specialized: []
};

function generateSchedule(classKey, studentCount) {
    const config = trainingConfig[classKey];
    const now = new Date();
    const daysUntilMonday = (1 - now.getDay() + 7) % 7 || 7;
    const startDate = new Date(now);
    startDate.setDate(now.getDate() + daysUntilMonday);
    startDate.setHours(8, 0, 0, 0);
    
    return {
        startDate: startDate,
        isReady: studentCount >= config.minStudents
    };
}

function updateAllUI() {
    ['ECD', 'Beginner', 'Advanced', 'Specialized'].forEach(key => {
        const count = paidStudents[key].length;
        const config = trainingConfig[key];
        const schedule = generateSchedule(key, count);
        
        // Update count
        const countEl = document.getElementById(`${key.toLowerCase()}-count`);
        if (countEl) countEl.textContent = count;
        
        // Update status
        const statusEl = document.getElementById(`${key.toLowerCase()}-status`);
        if (statusEl) {
            if (count >= 10) {
                statusEl.textContent = 'FULL';
                statusEl.className = 'status-badge full';
            } else if (count >= config.minStudents) {
                statusEl.textContent = 'SCHEDULED';
                statusEl.className = 'status-badge scheduled';
            } else if (count > 0) {
                statusEl.textContent = `WAITING (${count}/${config.minStudents})`;
                statusEl.className = 'status-badge waiting';
            } else {
                statusEl.textContent = 'WAITING';
                statusEl.className = 'status-badge waiting';
            }
        }
        
        // Update date
        const dateEl = document.getElementById(`${key.toLowerCase()}-date`);
        if (dateEl && schedule) {
            dateEl.textContent = schedule.startDate.toLocaleDateString('en-US', {
                weekday: 'short', month: 'short', day: 'numeric'
            });
        }
    });
}

function handleEnroll(classKey, groupPrice, oneOnOnePrice, isOneOnOne = false) {
    const studentName = prompt('Enter your full name to enroll:', '');
    if (!studentName || !studentName.trim()) return;
    
    const price = isOneOnOne ? oneOnOnePrice : groupPrice;
    const type = isOneOnOne ? 'One-on-One' : 'Group';
    
    const confirmed = confirm(
        `📋 Enrollment Summary\n\n` +
        `Student: ${studentName}\n` +
        `Course: ${classKey} Training\n` +
        `Type: ${type}\n` +
        `Amount: $${price.toLocaleString()}\n\n` +
        `Proceed with enrollment?`
    );
    
    if (!confirmed) return;
    
    // Add student
    paidStudents[classKey].push({
        name: studentName.trim(),
        oneOnOne: isOneOnOne,
        price: price,
        enrolledAt: new Date().toISOString()
    });
    
    // Update UI
    updateAllUI();
    
    // Success message
    const schedule = generateSchedule(classKey, paidStudents[classKey].length);
    const startDate = schedule.startDate.toLocaleDateString('en-US', {
        weekday: 'long', month: 'long', day: 'numeric', year: 'numeric'
    });
    
    alert(
        `✅ Enrollment Successful!\n\n` +
        `Welcome to D.E.T Academy, ${studentName}!\n` +
        `Course: ${classKey} Training (${type})\n` +
        `Amount: $${price.toLocaleString()}\n` +
        `Estimated Start: ${startDate}\n\n` +
        `You will receive confirmation and schedule details shortly.`
    );
    
    // Simulate admin notification
    console.log(`🔔 ADMIN ALERT: ${studentName} enrolled in ${classKey} (${type}) - $${price}`);
}

// Initialize with demo data
document.addEventListener('DOMContentLoaded', () => {
    paidStudents.ECD = [
        { name: 'John D.', oneOnOne: false, price: 300 },
        { name: 'Sarah M.', oneOnOne: false, price: 300 }
    ];
    paidStudents.Beginner = [
        { name: 'Michael T.', oneOnOne: false, price: 500 }
    ];
    updateAllUI();
    
    // Refresh every 30 seconds
    setInterval(updateAllUI, 30000);
});

console.log('🎓 D.E.T Academy Training System Ready');
console.log('📋 Test: handleEnroll("ECD", 300, 600)');
</script>