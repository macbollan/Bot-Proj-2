<%- include('partials/header', { title: 'D.E.T Academy | Training & Education', page: 'training' }) %>

<style>
    /* =========================================
       TRAINING PAGE - PREMIUM UI/UX
    ========================================= */
    
    /* Hero Section */
    .training-hero {
        text-align: center;
        padding: 60px 0 40px;
        position: relative;
        overflow: hidden;
    }
    .training-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: radial-gradient(ellipse at center, rgba(176,191,150,0.05) 0%, transparent 70%);
        pointer-events: none;
    }
    .training-hero h1 {
        font-size: 48px;
        font-weight: 800;
        color: #fff;
        margin-bottom: 15px;
        position: relative;
    }
    .training-hero h1 span {
        color: var(--det-green);
    }
    .training-hero .hero-subtitle {
        font-size: 18px;
        color: #94a3b8;
        max-width: 700px;
        margin: 0 auto 30px;
        line-height: 1.7;
    }
    .hero-stats {
        display: flex;
        gap: 40px;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 30px;
    }
    .hero-stat {
        text-align: center;
        padding: 20px 30px;
        background: rgba(176,191,150,0.05);
        border: 1px solid rgba(176,191,150,0.15);
        border-radius: 12px;
        min-width: 150px;
    }
    .hero-stat .stat-number {
        font-size: 32px;
        font-weight: 800;
        color: var(--det-green);
        display: block;
    }
    .hero-stat .stat-label {
        font-size: 12px;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 5px;
    }

    /* Section Titles */
    .section-title {
        text-align: center;
        margin-bottom: 50px;
    }
    .section-title h2 {
        font-size: 36px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 10px;
    }
    .section-title h2 span {
        color: var(--det-green);
    }
    .section-title p {
        color: #94a3b8;
        font-size: 15px;
        max-width: 600px;
        margin: 0 auto;
    }
    .section-divider {
        width: 60px;
        height: 3px;
        background: var(--det-green);
        margin: 15px auto 0;
        border-radius: 2px;
    }

    /* =========================================
       PRICING CARDS - MOBILE FIRST
    ========================================= */
    .pricing-cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 25px;
        margin-bottom: 60px;
    }
    
    .pricing-card {
        background: var(--det-card);
        border: 1px solid var(--det-border);
        border-radius: 16px;
        overflow: hidden;
        transition: all 0.3s ease;
        position: relative;
    }
    .pricing-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        border-color: var(--det-green);
    }
    .pricing-card.featured {
        border-color: var(--det-green);
        box-shadow: 0 0 30px rgba(176,191,150,0.1);
    }
    .pricing-card.featured::before {
        content: 'POPULAR';
        position: absolute;
        top: 15px;
        right: 15px;
        background: var(--det-green);
        color: var(--det-dark);
        font-size: 10px;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 20px;
        letter-spacing: 1px;
    }
    
    .card-header {
        padding: 30px 25px 20px;
        text-align: center;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .card-level {
        font-size: 13px;
        color: var(--det-green);
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 700;
        margin-bottom: 5px;
    }
    .card-title {
        font-size: 24px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 5px;
    }
    .card-duration {
        font-size: 13px;
        color: #94a3b8;
    }
    
    .card-body {
        padding: 25px;
    }
    .card-price {
        text-align: center;
        margin-bottom: 20px;
    }
    .price-group {
        font-size: 36px;
        font-weight: 800;
        color: var(--det-green);
    }
    .price-oneonone {
        font-size: 14px;
        color: #f0c040;
        margin-top: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }
    .price-oneonone .price {
        font-weight: 700;
        color: #f0c040;
    }
    
    .card-details {
        list-style: none;
        padding: 0;
        margin: 0 0 20px;
    }
    .card-details li {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 10px 0;
        border-bottom: 1px solid rgba(255,255,255,0.03);
        font-size: 13px;
        color: #cbd5e1;
    }
    .card-details li:last-child {
        border-bottom: none;
    }
    .card-details li i {
        color: var(--det-green);
        font-size: 16px;
        margin-top: 2px;
        flex-shrink: 0;
    }
    
    .student-info {
        background: rgba(0,0,0,0.2);
        border-radius: 8px;
        padding: 15px;
        text-align: center;
        margin-bottom: 20px;
    }
    .student-count {
        font-size: 13px;
        color: #94a3b8;
    }
    .student-count strong {
        color: #fff;
    }
    .status-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 8px;
    }
    .status-badge.ready { background: rgba(176,191,150,0.2); color: var(--det-green); }
    .status-badge.waiting { background: rgba(240,192,64,0.15); color: #f0c040; }
    .status-badge.scheduled { background: rgba(52,152,219,0.15); color: #3498db; }
    .status-badge.full { background: rgba(255,107,107,0.15); color: #ff6b6b; }
    
    .next-class {
        font-size: 12px;
        color: #64748b;
        text-align: center;
        margin-bottom: 15px;
    }
    .next-class strong {
        color: #cbd5e1;
    }
    
    .card-btn {
        display: block;
        width: 100%;
        padding: 14px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 14px;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s;
        border: none;
        text-decoration: none;
    }
    .btn-subscribe {
        background: var(--det-green);
        color: var(--det-dark);
    }
    .btn-subscribe:hover {
        background: var(--det-green-hover);
        transform: translateY(-2px);
        color: var(--det-dark);
    }
    .btn-onetoone {
        background: transparent;
        border: 1px solid #f0c040;
        color: #f0c040;
        margin-top: 10px;
    }
    .btn-onetoone:hover {
        background: rgba(240,192,64,0.1);
        transform: translateY(-2px);
        color: #f0c040;
    }
    .card-terms {
        font-size: 10px;
        color: #64748b;
        text-align: center;
        margin-top: 10px;
    }

    /* =========================================
       ACADEMY INFO SECTION
    ========================================= */
    .academy-section {
        padding: 80px 0;
        background: rgba(176,191,150,0.03);
        border-top: 1px solid var(--det-border);
        border-bottom: 1px solid var(--det-border);
    }
    .academy-intro {
        max-width: 800px;
        margin: 0 auto 60px;
        text-align: center;
    }
    .academy-intro .quote-text {
        font-size: 18px;
        color: #cbd5e1;
        line-height: 1.8;
        margin-bottom: 30px;
    }
    .academy-intro .quote-text strong {
        color: #fff;
    }
    
    /* Module Grid */
    .modules-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 20px;
        margin-bottom: 60px;
    }
    .module-card {
        background: var(--det-card);
        border: 1px solid var(--det-border);
        border-radius: 12px;
        padding: 25px;
        transition: all 0.3s;
    }
    .module-card:hover {
        border-color: var(--det-green);
        transform: translateX(5px);
    }
    .module-number {
        font-size: 11px;
        color: var(--det-green);
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 700;
        margin-bottom: 10px;
    }
    .module-title {
        font-size: 18px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 15px;
    }
    .module-topics {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .module-topics li {
        padding: 6px 0;
        font-size: 13px;
        color: #94a3b8;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .module-topics li::before {
        content: '';
        width: 5px;
        height: 5px;
        background: var(--det-green);
        border-radius: 50%;
        flex-shrink: 0;
    }

    /* Experience Levels */
    .experience-section {
        text-align: center;
        padding: 60px 0;
    }
    .experience-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 25px;
        margin-top: 40px;
    }
    .exp-card {
        background: var(--det-card);
        border: 1px solid var(--det-border);
        border-radius: 12px;
        padding: 30px 25px;
        text-align: center;
        transition: all 0.3s;
    }
    .exp-card:hover {
        transform: translateY(-5px);
        border-color: var(--det-green);
    }
    .exp-icon {
        font-size: 40px;
        color: var(--det-green);
        margin-bottom: 15px;
    }
    .exp-title {
        font-size: 16px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 10px;
    }
    .exp-desc {
        font-size: 13px;
        color: #94a3b8;
        line-height: 1.6;
    }

    /* Continuous Learning */
    .continuous-section {
        text-align: center;
        padding: 60px 0;
    }
    .continuous-section .evolution-steps {
        display: flex;
        gap: 30px;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 30px;
    }
    .evolution-step {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        color: #cbd5e1;
    }
    .evolution-step i {
        color: var(--det-green);
        font-size: 20px;
    }

    /* CTA Section */
    .cta-section {
        padding: 80px 0;
        text-align: center;
        background: radial-gradient(ellipse at center, rgba(176,191,150,0.08) 0%, transparent 70%);
    }
    .cta-section h2 {
        font-size: 36px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 15px;
    }
    .cta-section .cta-quote {
        font-size: 18px;
        color: var(--det-green);
        font-style: italic;
        margin-bottom: 30px;
    }
    .cta-buttons {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
    }
    .btn-primary {
        background: var(--det-green);
        color: var(--det-dark);
        padding: 14px 30px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 15px;
        border: none;
        cursor: pointer;
        transition: all 0.3s;
        text-decoration: none;
        display: inline-block;
    }
    .btn-primary:hover {
        background: var(--det-green-hover);
        transform: translateY(-2px);
        color: var(--det-dark);
    }
    .btn-secondary {
        background: transparent;
        color: #fff;
        padding: 14px 30px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 15px;
        border: 1px solid rgba(255,255,255,0.2);
        cursor: pointer;
        transition: all 0.3s;
        text-decoration: none;
        display: inline-block;
    }
    .btn-secondary:hover {
        border-color: var(--det-green);
        color: var(--det-green);
        transform: translateY(-2px);
    }

    /* Policy Alert */
    .policy-alert {
        background: rgba(52,152,219,0.08);
        border: 1px solid rgba(52,152,219,0.15);
        border-radius: 12px;
        padding: 20px 25px;
        text-align: center;
        margin-bottom: 40px;
    }
    .policy-alert i {
        color: #3498db;
        font-size: 20px;
        margin-bottom: 10px;
    }
    .policy-alert p {
        color: #cbd5e1;
        font-size: 14px;
        margin: 5px 0;
    }
    .policy-alert strong {
        color: #fff;
    }
    .schedule-note {
        color: var(--det-green);
        font-size: 13px;
        margin-top: 8px;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .training-hero h1 {
            font-size: 32px;
        }
        .hero-stats {
            gap: 15px;
        }
        .hero-stat {
            min-width: 120px;
            padding: 15px 20px;
        }
        .hero-stat .stat-number {
            font-size: 24px;
        }
        .pricing-cards-grid {
            grid-template-columns: 1fr;
            gap: 20px;
        }
        .modules-grid {
            grid-template-columns: 1fr;
        }
        .section-title h2 {
            font-size: 28px;
        }
    }
</style>

<!-- =========================================
     HERO SECTION
========================================= -->
