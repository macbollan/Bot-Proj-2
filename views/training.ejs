<script>
// ============================================================
// SMART TRAINING SCHEDULING ENGINE (Client-Side Simulation)
// ============================================================

// Training class configurations
const trainingClasses = {
    ECD: { 
        name: 'ECD Level', 
        minStudents: 5, 
        durationDays: 5, 
        hoursPerDay: 3,
        price: 300,
        oneOnOnePrice: 600
    },
    Beginner: { 
        name: 'Beginner Level', 
        minStudents: 5, 
        durationDays: 5, 
        hoursPerDay: 2,
        price: 500,
        oneOnOnePrice: 1000
    },
    Advanced: { 
        name: 'Advanced Level', 
        minStudents: 5, 
        durationDays: 5, 
        hoursPerDay: 2,
        price: 300,
        oneOnOnePrice: 600
    },
    Specialized: { 
        name: 'Specialized Class', 
        minStudents: 5, 
        durationDays: 14, 
        hoursPerDay: 1,
        price: 1000,
        oneOnOnePrice: 2000
    }
};

// Track paid students per class (simulated - would come from DB in production)
const paidStudents = {
    ECD: [],
    Beginner: [],
    Advanced: [],
    Specialized: []
};

// Track class schedules (Monday-Friday, 8-5)
const classSchedules = {};

// ============================================================
// SCHEDULING ENGINE
// ============================================================

function generateSchedule(classKey, studentCount) {
    const config = trainingClasses[classKey];
    if (!config) return null;

    // Start from next Monday
    const now = new Date();
    const daysUntilMonday = (1 - now.getDay() + 7) % 7 || 7; // Monday
    const startDate = new Date(now);
    startDate.setDate(now.getDate() + daysUntilMonday);
    startDate.setHours(8, 0, 0, 0);

    // Calculate end date (durationDays, weekdays only)
    let endDate = new Date(startDate);
    let daysAdded = 0;
    while (daysAdded < config.durationDays) {
        if (endDate.getDay() >= 1 && endDate.getDay() <= 5) { // Mon-Fri
            daysAdded++;
        }
        if (daysAdded < config.durationDays) {
            endDate.setDate(endDate.getDate() + 1);
        }
    }
    endDate.setHours(17, 0, 0, 0);

    // Generate daily schedule
    const sessions = [];
    let currentDate = new Date(startDate);
    let sessionCount = 0;
    while (sessionCount < config.durationDays) {
        if (currentDate.getDay() >= 1 && currentDate.getDay() <= 5) {
            const start = new Date(currentDate);
            start.setHours(8, 0, 0, 0);
            const end = new Date(currentDate);
            end.setHours(8 + config.hoursPerDay, 0, 0, 0);
            
            // Check for conflicts with other classes
            const conflict = checkConflict(classKey, start, end);
            
            sessions.push({
                date: new Date(currentDate),
                start: start,
                end: end,
                conflict: conflict
            });
            sessionCount++;
        }
        currentDate.setDate(currentDate.getDate() + 1);
    }

    return {
        startDate: startDate,
        endDate: endDate,
        sessions: sessions,
        studentCount: studentCount,
        isReady: studentCount >= config.minStudents,
        isFull: studentCount >= 10 // max capacity
    };
}

function checkConflict(classKey, start, end) {
    // Check against existing schedules for other classes
    for (const [key, schedule] of Object.entries(classSchedules)) {
        if (key === classKey) continue;
        if (!schedule || !schedule.sessions) continue;
        
        for (const session of schedule.sessions) {
            const existingStart = new Date(session.start);
            const existingEnd = new Date(session.end);
            
            // Check if time overlaps (same day)
            if (start.toDateString() === existingStart.toDateString()) {
                if ((start < existingEnd && end > existingStart)) {
                    return true; // Conflict!
                }
            }
        }
    }
    return false;
}

// ============================================================
// NOTIFICATION SYSTEM
// ============================================================

function sendHighFlagAlert(classKey, studentName) {
    console.log(`🔴 HIGH FLAG ALERT: ${studentName} paid for ${classKey} training!`);
    console.log(`📧 Email notification sent to admin@det.com`);
    console.log(`📱 WhatsApp notification sent to +263...`);
    
    // In production, this would send real notifications
    const alertData = {
        type: 'HIGH_FLAG',
        class: classKey,
        student: studentName,
        timestamp: new Date().toISOString(),
        message: `⚠️ ${studentName} has just enrolled in ${classKey} Training. Current enrollment: ${paidStudents[classKey].length}/5`
    };
    
    // Store alert for admin panel
    const alerts = JSON.parse(localStorage.getItem('det_alerts') || '[]');
    alerts.push(alertData);
    localStorage.setItem('det_alerts', JSON.stringify(alerts));
    
    return alertData;
}

function sendLessonNotifications(classKey, schedule) {
    if (!schedule || !schedule.sessions) return;
    
    schedule.sessions.forEach((session, index) => {
        const date = new Date(session.start);
        const dateStr = date.toLocaleDateString('en-US', { 
            weekday: 'short', 
            month: 'short', 
            day: 'numeric' 
        });
        const timeStr = date.toLocaleTimeString('en-US', { 
            hour: '2-digit', 
            minute: '2-digit' 
        });
        
        // Day before notification
        const dayBefore = new Date(date);
        dayBefore.setDate(dayBefore.getDate() - 1);
        console.log(`📅 [SCHEDULED] ${classKey} - Session ${index+1}: ${dateStr} at ${timeStr}`);
        
        // In production, these would be actual notifications:
        // - 1 day before: "Reminder: Your ${classKey} training starts tomorrow at 8:00 AM"
        // - 1 hour before: "Your ${classKey} training starts in 1 hour"
        // - 15 minutes before: "Your ${classKey} training starts in 15 minutes"
        // - Start: "Your ${classKey} training is starting now!"
        // - End: "Your ${classKey} training session has ended"
    });
}

// ============================================================
// UI UPDATE FUNCTIONS
// ============================================================

function updateUI() {
    const classes = ['ECD', 'Beginner', 'Advanced', 'Specialized'];
    
    classes.forEach(key => {
        const count = paidStudents[key].length;
        const config = trainingClasses[key];
        const schedule = generateSchedule(key, count);
        classSchedules[key] = schedule;
        
        // Update count
        document.getElementById(`${key.toLowerCase()}-count`).textContent = count;
        
        // Update status
        const statusEl = document.getElementById(`${key.toLowerCase()}-status`);
        if (count >= 10) {
            statusEl.textContent = 'Full';
            statusEl.className = 'status-badge full';
        } else if (count >= config.minStudents) {
            statusEl.textContent = 'Scheduled';
            statusEl.className = 'status-badge scheduled';
        } else if (count > 0) {
            statusEl.textContent = `Waiting (${count}/${config.minStudents})`;
            statusEl.className = 'status-badge waiting';
        } else {
            statusEl.textContent = 'Waiting';
            statusEl.className = 'status-badge waiting';
        }
        
        // Update next date
        const dateEl = document.getElementById(`${key.toLowerCase()}-date`);
        if (schedule) {
            const startDate = new Date(schedule.startDate);
            const dateStr = startDate.toLocaleDateString('en-US', { 
                weekday: 'short', 
                month: 'short', 
                day: 'numeric' 
            });
            dateEl.textContent = dateStr;
        } else {
            dateEl.textContent = 'Pending';
        }
        
        // Send notifications if class is now ready
        if (schedule && schedule.isReady && !schedule._notified) {
            schedule._notified = true;
            sendLessonNotifications(key, schedule);
            // Send class ready alert
            console.log(`🎓 CLASS READY: ${key} has reached ${count} students!`);
        }
    });
}

function handleTrainingPayment(classKey) {
    // Simulate student enrollment
    const studentName = prompt('Enter your name to enroll:', 'Student');
    if (!studentName) return;
    
    // Check if one-on-one or group
    const isOneOnOne = confirm(`Click OK for One-on-One ($${trainingClasses[classKey].oneOnOnePrice}) or Cancel for Group ($${trainingClasses[classKey].price})`);
    const price = isOneOnOne ? trainingClasses[classKey].oneOnOnePrice : trainingClasses[classKey].price;
    
    // Add student
    paidStudents[classKey].push({ name: studentName, oneOnOne: isOneOnOne, price: price });
    
    // Send high flag alert
    sendHighFlagAlert(classKey, studentName);
    
    // Update UI
    updateUI();
    
    alert(`✅ ${studentName} enrolled in ${classKey} training!\n💰 Amount: $${price}${isOneOnOne ? ' (One-on-One)' : ' (Group)'}\n📧 Notifications will be sent to admin and tutor.`);
}

// ============================================================
// INITIALIZATION
// ============================================================

// Simulate some existing students for demo
// In production, this would come from the database
window.addEventListener('DOMContentLoaded', function() {
    // Add some demo students
    paidStudents.ECD = [
        { name: 'John D.', oneOnOne: false, price: 300 },
        { name: 'Sarah M.', oneOnOne: false, price: 300 }
    ];
    paidStudents.Beginner = [
        { name: 'Michael T.', oneOnOne: false, price: 500 }
    ];
    
    updateUI();
    
    // Auto-refresh every 30 seconds (simulate real-time updates)
    setInterval(updateUI, 30000);
});

// Expose for console testing
window.trainingSystem = {
    paidStudents,
    trainingClasses,
    classSchedules,
    updateUI,
    handleTrainingPayment,
    sendHighFlagAlert
};

console.log('🎓 D.E.T Training System initialized!');
console.log('📋 Test with: window.trainingSystem.handleTrainingPayment("ECD")');
console.log('📊 Current enrollment:', paidStudents);
</script>