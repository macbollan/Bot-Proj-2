<%- include('partials/header', { title: 'Client Access | D.E.T System', page: 'login' }) %>

<style>
    .page-heading { text-align: center; padding: 40px 0 20px; }
    .page-heading h2 { color: var(--det-green); font-size: 36px; font-weight: 700; margin-bottom: 15px; }
    .page-heading p { color: #aaa; font-size: 16px; max-width: 600px; margin: 0 auto; line-height: 1.6; }

    .login-card { background: var(--det-card); border: 1px solid var(--det-border); border-radius: 12px; padding: 40px; width: 100%; max-width: 450px; margin: 0 auto 60px; box-shadow: 0 15px 35px rgba(0,0,0,0.3); }
    
    .form-label { color: var(--det-green) !important; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; }
    .form-control { background: rgba(0,0,0,0.2) !important; border: 1px solid rgba(255,255,255,0.1) !important; color: white !important; padding: 12px 15px; border-radius: 6px; margin-bottom: 25px; font-size: 15px; }
    .form-control:focus { background: rgba(0,0,0,0.3) !important; border-color: var(--det-green) !important; box-shadow: 0 0 0 0.25rem rgba(176, 191, 150, 0.15) !important; }
    
    .btn-secure { background: var(--det-green); color: var(--det-dark) !important; border: none; border-radius: 6px; padding: 14px 20px; font-weight: 700; font-size: 16px; width: 100%; transition: all 0.3s; cursor: pointer; }
    .btn-secure:hover { background: var(--det-green-hover); transform: translateY(-2px); }

    .ux-safety-net { margin-top: 25px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,0.05); text-align: center; font-size: 14px; color: #cbd5e1 !important; }
    .ux-safety-net a { color: var(--det-green) !important; text-decoration: none; font-weight: 700; transition: color 0.3s; display: inline-block; margin-top: 5px;}
    .ux-safety-net a:hover { color: #ffffff !important; text-decoration: underline; }
</style>

<div class="container flex-grow-1">
    <div class="page-heading">
        <h2>Client Access</h2>
        <p>Access your D.E.T dashboard to manage your trading environment and institutional modules.</p>
    </div>

    <div class="login-card">
        <% if(error && error.length > 0) { %> 
            <div class="alert alert-danger" style="background: rgba(239,68,68,0.1); border-color: #ef4444; color: #fca5a5; text-align: center; font-size: 14px; border-radius: 8px;">
                <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
            </div> 
        <% } %>

        <form action="/login" method="POST">
            <div class="mb-3">
                <label class="form-label">Username</label>
                <input type="text" class="form-control" name="username" placeholder="Enter your username" required>
            </div>
            
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label mb-0">Secure Password</label>
                    <a href="#" style="font-size: 12px; color: #888; text-decoration: none;">Forgot?</a>
                </div>
                <input type="password" class="form-control" name="password" placeholder="Enter your password" required>
            </div>

            <button type="submit" class="btn-secure">Secure Access</button>
        </form>

        <div class="ux-safety-net">
            Don't have a D.E.T Profile? <br>
            <a href="/register">Start Your Journey Here</a>
        </div>
    </div>
</div>

<footer role="contentinfo" style="background: var(--det-card); padding: 30px 0; border-top: 1px solid var(--det-border); text-align: center; margin-top: auto;">
    <div class="container">
        <p style="color: #cbd5e1 !important; font-size: 14px; margin: 0;">Copyright © 2026 D.E.T System. All Rights Reserved.</p>
    </div>
</footer>

<script>
    document.getElementById('mobile-toggle').addEventListener('click', function() {
        document.getElementById('nav-menu').classList.toggle('active');
    });
</script>
</body>
</html>