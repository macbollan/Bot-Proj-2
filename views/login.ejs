<%- include('partials/header', { title: 'Login | D.E.T System', page: 'login' }) %>

<style>
    .auth-container {
        min-height: calc(100vh - 300px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }
    .auth-card {
        background: var(--det-card);
        border: 1px solid var(--det-border);
        border-radius: 12px;
        padding: 40px;
        width: 100%;
        max-width: 450px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
    }
    .auth-card h2 {
        color: var(--det-green);
        font-weight: 700;
        text-align: center;
        margin-bottom: 10px;
    }
    .auth-subtitle {
        color: #94a3b8;
        font-size: 14px;
        text-align: center;
        margin-bottom: 30px;
    }
    .form-label {
        color: var(--det-green);
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
        display: block;
    }
    .form-control {
        background: rgba(0,0,0,0.3);
        border: 1px solid rgba(255,255,255,0.1);
        color: white;
        padding: 14px;
        border-radius: 6px;
        font-size: 16px;
        width: 100%;
        margin-bottom: 20px;
    }
    .form-control:focus {
        border-color: var(--det-green);
        box-shadow: 0 0 0 0.25rem rgba(176,191,150,0.15);
        outline: none;
    }
    .btn-auth {
        background: var(--det-green);
        color: var(--det-dark);
        border: none;
        border-radius: 6px;
        padding: 14px;
        font-weight: 700;
        font-size: 16px;
        width: 100%;
        cursor: pointer;
        transition: all 0.3s;
    }
    .btn-auth:hover {
        background: var(--det-green-hover);
        transform: translateY(-2px);
    }
    .auth-link {
        color: #64748b;
        font-size: 14px;
        text-align: center;
        margin-top: 20px;
    }
    .auth-link a {
        color: var(--det-green);
        font-weight: 600;
        text-decoration: none;
    }
    .auth-link a:hover {
        text-decoration: underline;
    }
    .forgot-link {
        text-align: right;
        margin-top: -10px;
        margin-bottom: 20px;
    }
    .forgot-link a {
        color: #94a3b8;
        font-size: 12px;
        text-decoration: none;
        transition: color 0.2s;
    }
    .forgot-link a:hover {
        color: var(--det-green);
    }
    .alert-danger {
        background: rgba(239,68,68,0.1);
        border: 1px solid #ef4444;
        color: #fca5a5;
        padding: 12px;
        border-radius: 6px;
        margin-bottom: 20px;
        font-size: 14px;
        text-align: center;
    }
    .alert-success {
        background: rgba(34,197,94,0.1);
        border: 1px solid #22c55e;
        color: #86efac;
        padding: 12px;
        border-radius: 6px;
        margin-bottom: 20px;
        font-size: 14px;
        text-align: center;
    }
    .purchase-banner {
        background: rgba(176,191,150,0.1);
        border: 1px solid var(--det-green);
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 25px;
        text-align: center;
    }
    .purchase-banner p {
        color: var(--det-green);
        font-size: 13px;
        margin: 0;
        font-weight: 600;
    }
    .affiliate-banner {
        background: rgba(245,158,11,0.1);
        border: 1px solid #f59e0b;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 25px;
        text-align: center;
    }
    .affiliate-banner p {
        color: #f59e0b;
        font-size: 13px;
        margin: 0;
        font-weight: 600;
    }
    .back-to-login {
        text-align: center;
        margin-top: 15px;
    }
    .back-to-login a {
        color: #94a3b8;
        font-size: 13px;
        text-decoration: none;
    }
    .back-to-login a:hover {
        color: var(--det-green);
    }
</style>

<div class="auth-container">
    <div class="auth-card">
        
        <% if (typeof showForgot !== 'undefined' && showForgot) { %>
            <!-- ===== FORGOT PASSWORD VIEW ===== -->
            <h2>Reset Password</h2>
            <p class="auth-subtitle">Enter your email or username to receive a reset code</p>

            <% if (locals.error && locals.error.length > 0) { %>
                <div class="alert-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i><%= error[0] %>
                </div>
            <% } %>
            <% if (locals.success && locals.success.length > 0) { %>
                <div class="alert-success">
                    <i class="bi bi-check-circle me-2"></i><%= success[0] %>
                </div>
            <% } %>

            <form action="/forgot-password" method="POST">
                <label class="form-label">Email or Username</label>
                <input type="text" name="identifier" class="form-control" placeholder="Enter your email or username" required>
                
                <label class="form-label">Reset Method</label>
                <select name="resetMethod" class="form-control" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); color: white; padding: 14px; border-radius: 6px; font-size: 16px; width: 100%; margin-bottom: 20px;">

                    <option value="email">Send via Email</option>
                </select>
                
                <button type="submit" class="btn-auth">
                    <i class="bi bi-send me-2"></i>Send Reset Code
                </button>
            </form>
            
            <div class="back-to-login">
                <a href="/login"><i class="bi bi-arrow-left me-1"></i>Back to Login</a>
            </div>

        <% } else if (typeof showReset !== 'undefined' && showReset) { %>
            <!-- ===== RESET PASSWORD VIEW ===== -->
            <h2>Set New Password</h2>
            <p class="auth-subtitle">Enter the code sent to you and your new password</p>

            <% if (locals.error && locals.error.length > 0) { %>
                <div class="alert-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i><%= error[0] %>
                </div>
            <% } %>

            <form action="/reset-password" method="POST">
                <input type="hidden" name="resetToken" value="<%= resetToken %>">
                <input type="hidden" name="userId" value="<%= userId %>">
                
                <label class="form-label">Reset Code</label>
                <input type="text" name="resetCode" class="form-control" placeholder="Enter the 6-digit code" maxlength="6" required>
                
                <label class="form-label">New Password</label>
                <input type="password" name="newPassword" id="newPassword" class="form-control" placeholder="Minimum 8 characters" minlength="8" required oninput="checkPasswordStrength()">
                
                <div id="passwordStrength" style="margin-bottom: 15px; font-size: 11px;"></div>
                
                <label class="form-label">Confirm New Password</label>
                <input type="password" name="confirmPassword" class="form-control" placeholder="Re-enter your password" required>
                
                <button type="submit" class="btn-auth">
                    <i class="bi bi-shield-check me-2"></i>Reset Password
                </button>
            </form>
            
            <div class="back-to-login">
                <a href="/login"><i class="bi bi-arrow-left me-1"></i>Back to Login</a>
            </div>

        <% } else { %>
            <!-- ===== NORMAL LOGIN VIEW ===== -->
            <h2>Welcome Back</h2>
            <p class="auth-subtitle">Login to your D.E.T account</p>

            <% if (locals.pendingTier) { %>
                <div class="purchase-banner">
                    <p><i class="bi bi-cart-check me-2"></i>Login to continue with <strong><%= pendingTier %></strong> subscription</p>
                </div>
            <% } %>

            <% if (typeof redirect !== 'undefined' && redirect === 'affiliate') { %>
                <div class="affiliate-banner">
                    <p><i class="bi bi-diagram-3 me-2"></i>Login to join the <strong>Affiliate Program</strong></p>
                </div>
            <% } %>



            <% if (typeof redirect !== 'undefined' && redirect) { %>
                <input type="hidden" name="redirect" value="<%= redirect %>">
            <% } %>
            <% if (typeof course !== 'undefined' && course) { %>
                <input type="hidden" name="course" value="<%= course %>">
            <% } %>
            <% if (typeof type !== 'undefined' && type) { %>
                <input type="hidden" name="type" value="<%= type %>">
            <% } %>

            <% if (locals.error && locals.error.length > 0) { %>
                <div class="alert-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i><%= error[0] %>
                </div>
            <% } %>
            <% if (locals.success && locals.success.length > 0) { %>
                <div class="alert-success">
                    <i class="bi bi-check-circle me-2"></i><%= success[0] %>
                </div>
            <% } %>

            
<form action="/login" method="POST">
                <% if (locals.pendingTier) { %>
                    <input type="hidden" name="pendingTier" value="<%= pendingTier %>">
                <% } %>
                <% if (typeof redirect !== 'undefined' && redirect) { %>
                    <input type="hidden" name="redirect" value="<%= redirect %>">
                <% } %>
                
                <!-- Updated Label and Placeholder -->
                <label class="form-label">Email or Username</label>
                <input type="text" name="username" class="form-control" placeholder="Enter your email or username" required>
                
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" placeholder="Enter your password" required>
                
                <div class="forgot-link">
                    <a href="/login?forgot=true">Forgot password?</a>
                </div>
                
                <button type="submit" class="btn-auth">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Login
                </button>
            </form>

            <p class="auth-link">Don't have an account? <a href="/register<%= typeof redirect !== 'undefined' && redirect ? '?redirect=' + redirect : '' %>">Create one here</a></p>
        <% } %>
    </div>
</div>

<script>
    function checkPasswordStrength() {
        const password = document.getElementById('newPassword').value;
        const strengthDiv = document.getElementById('passwordStrength');
        
        let strength = 0;
        let message = '';
        let color = '#ef4444';
        
        if (password.length >= 8) strength++;
        if (password.match(/[a-z]/) && password.match(/[A-Z]/)) strength++;
        if (password.match(/\d/)) strength++;
        if (password.match(/[^a-zA-Z\d]/)) strength++;
        
        switch(strength) {
            case 0:
            case 1:
                message = 'Weak — use 8+ chars, mix of letters, numbers & symbols';
                color = '#ef4444';
                break;
            case 2:
                message = 'Fair — add numbers or symbols';
                color = '#f59e0b';
                break;
            case 3:
                message = 'Good — almost there';
                color = '#38bdf8';
                break;
            case 4:
                message = 'Strong password ✓';
                color = '#22c55e';
                break;
        }
        
        strengthDiv.innerHTML = '<span style="color: ' + color + ';">' + message + '</span>';
    }
</script>

<%- include('partials/footer') %>