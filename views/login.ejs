<%- include('partials/header', { title: 'Login | D.E.T System', page: 'login' }) %>

<style>
    .auth-container {
        min-height: calc(100vh - 300px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }
    .auth-card {
        background: var(--det-card);
        border: 1px solid var(--det-border);
        border-radius: 12px;
        padding: 40px;
        width: 100%;
        max-width: 450px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
    }
    .auth-card h2 {
        color: var(--det-green);
        font-weight: 700;
        text-align: center;
        margin-bottom: 10px;
    }
    .auth-subtitle {
        color: #94a3b8;
        font-size: 14px;
        text-align: center;
        margin-bottom: 30px;
    }
    .form-label {
        color: var(--det-green);
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
        display: block;
    }
    .form-control {
        background: rgba(0,0,0,0.3);
        border: 1px solid rgba(255,255,255,0.1);
        color: white;
        padding: 14px;
        border-radius: 6px;
        font-size: 16px;
        width: 100%;
        margin-bottom: 20px;
    }
    .form-control:focus {
        border-color: var(--det-green);
        box-shadow: 0 0 0 0.25rem rgba(176,191,150,0.15);
        outline: none;
    }
    .btn-auth {
        background: var(--det-green);
        color: var(--det-dark);
        border: none;
        border-radius: 6px;
        padding: 14px;
        font-weight: 700;
        font-size: 16px;
        width: 100%;
        cursor: pointer;
        transition: all 0.3s;
    }
    .btn-auth:hover {
        background: var(--det-green-hover);
        transform: translateY(-2px);
    }
    .auth-link {
        color: #64748b;
        font-size: 14px;
        text-align: center;
        margin-top: 20px;
    }
    .auth-link a {
        color: var(--det-green);
        font-weight: 600;
        text-decoration: none;
    }
    .auth-link a:hover {
        text-decoration: underline;
    }
    .alert-danger {
        background: rgba(239,68,68,0.1);
        border: 1px solid #ef4444;
        color: #fca5a5;
        padding: 12px;
        border-radius: 6px;
        margin-bottom: 20px;
        font-size: 14px;
        text-align: center;
    }
    .purchase-banner {
        background: rgba(176,191,150,0.1);
        border: 1px solid var(--det-green);
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 25px;
        text-align: center;
    }
    .purchase-banner p {
        color: var(--det-green);
        font-size: 13px;
        margin: 0;
        font-weight: 600;
    }
</style>

<div class="auth-container">
    <div class="auth-card">
        <h2>Welcome Back</h2>
        <p class="auth-subtitle">Login to your D.E.T account</p>

        <% if (locals.pendingTier) { %>
            <div class="purchase-banner">
                <p><i class="bi bi-cart-check me-2"></i>Login to continue with <strong><%= pendingTier %></strong> subscription</p>
            </div>
        <% } %>

        <% if (locals.error && locals.error.length > 0) { %>
            <div class="alert-danger">
                <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
            </div>
        <% } %>

        <form action="/login" method="POST">
            <% if (locals.pendingTier) { %>
                <input type="hidden" name="pendingTier" value="<%= pendingTier %>">
            <% } %>
            
            <label class="form-label">Username</label>
            <input type="text" name="username" class="form-control" placeholder="Enter your username" required>
            
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-control" placeholder="Enter your password" required>
            
            <button type="submit" class="btn-auth">
                <i class="bi bi-box-arrow-in-right me-2"></i>Login
            </button>
        </form>

        <p class="auth-link">Don't have an account? <a href="/register">Create one here</a></p>
    </div>
</div>

<%- include('partials/footer') %>