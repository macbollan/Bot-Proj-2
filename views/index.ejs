<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>D.E.T System | The System That Buys Money</title>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Bootstrap core CSS -->
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/fontawesome.css">

    <style>
        /* =========================================
           GLOBAL DARK THEME
        ========================================= */
        body {
            background-color: #1a1818;
            font-family: 'Poppins', sans-serif;
            color: #ffffff;
            padding-top: 80px; 
            margin: 0;
            overflow-x: hidden;
        }
        a { text-decoration: none; }
        
        /* =========================================
           CUSTOM NEUTRAL NAVBAR
        ========================================= */
        .custom-navbar {
            background-color: #322C2C;
            position: fixed; top: 0; left: 0; width: 100%;
            z-index: 1000; box-shadow: 0 2px 15px rgba(0,0,0,0.5);
            padding: 18px 0;
        }
        .nav-container {
            display: flex; justify-content: space-between; align-items: center;
            max-width: 1200px; margin: 0 auto; padding: 0 20px;
        }
        .text-logo {
            color: #B0BF96; font-size: 26px; font-weight: 800; 
            letter-spacing: 1.5px; text-transform: uppercase;
        }
        .text-logo span { color: #ffffff; font-weight: 300; }
        .text-logo:hover { color: #ffffff; }
        
        .nav-menu { display: flex; list-style: none; margin: 0; padding: 0; gap: 30px; align-items: center; }
        .nav-menu li a {
            color: #ffffff; font-size: 14px; font-weight: 500;
            transition: color 0.3s; text-transform: uppercase; letter-spacing: 0.5px;
        }
        .nav-menu li a:hover, .nav-menu li a.active { color: #B0BF96; }
        
        .nav-btn {
            background: #B0BF96; color: #322C2C !important; padding: 10px 20px;
            border-radius: 6px; font-weight: 700 !important; transition: all 0.3s ease;
        }
        .nav-btn:hover { background: #96a67c; transform: translateY(-2px); }
        
        .mobile-toggle { display: none; color: #ffffff; font-size: 28px; cursor: pointer; }

        @media (max-width: 991px) {
            .nav-menu {
                display: none; flex-direction: column; position: absolute;
                top: 100%; left: 0; width: 100%; background-color: #322C2C;
                padding: 20px 0; box-shadow: 0 10px 15px rgba(0,0,0,0.5); text-align: center;
            }
            .nav-menu.active { display: flex; }
            .nav-menu li { padding: 10px 0; }
            .mobile-toggle { display: block; }
        }

        /* =========================================
           HERO SECTION
        ========================================= */
        .hero-section {
            padding: 100px 20px;
            text-align: center;
            background: radial-gradient(circle at center, #2a2525 0%, #1a1818 100%);
            border-bottom: 1px solid rgba(176, 191, 150, 0.1);
        }
        .hero-title {
            font-size: 56px;
            font-weight: 800;
            line-height: 1.2;
            margin-bottom: 25px;
        }
        .hero-title span { color: #B0BF96; }
        .hero-subtitle {
            font-size: 18px;
            color: #aaa;
            max-width: 800px;
            margin: 0 auto 40px;
            line-height: 1.8;
        }

        /* Institutional Security Badge */
        .security-badge {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(176, 191, 150, 0.2);
            border-radius: 12px;
            padding: 25px 40px;
            display: inline-block;
            margin-bottom: 40px;
            text-align: left;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }
        .badge-row { display: flex; align-items: center; gap: 15px; margin-bottom: 10px; }
        .badge-row:last-child { margin-bottom: 0; }
        .badge-icon { color: #B0BF96; font-size: 20px; }
        .badge-text-old { color: #666; text-decoration: line-through; font-size: 14px; margin-right: 15px; }
        .badge-text-new { color: #fff; font-weight: 600; font-size: 16px; }

        .btn-primary-custom {
            background: #B0BF96;
            color: #1a1818;
            padding: 16px 40px;
            border-radius: 8px;
            font-size: 18px;
            font-weight: 700;
            display: inline-block;
            transition: all 0.3s ease;
            box-shadow: 0 8px 20px rgba(176, 191, 150, 0.2);
        }
        .btn-primary-custom:hover { transform: translateY(-3px); background: #96a67c; color: #000; }

        /* =========================================
           CONTENT SECTIONS (Dark Cards)
        ========================================= */
        .section-padding { padding: 100px 20px; }
        .section-title { font-size: 36px; font-weight: 700; margin-bottom: 20px; text-align: center; }
        .section-title span { color: #B0BF96; }
        
        .dark-card {
            background: #322C2C;
            border: 1px solid rgba(176, 191, 150, 0.15);
            border-radius: 16px;
            padding: 40px;
            height: 100%;
            transition: transform 0.3s ease;
        }
        .dark-card:hover { transform: translateY(-5px); border-color: rgba(176, 191, 150, 0.4); }
        .card-icon { font-size: 40px; color: #B0BF96; margin-bottom: 20px; }
        .card-title { font-size: 22px; font-weight: 600; margin-bottom: 15px; color: #fff; }
        .card-text { font-size: 15px; color: #aaa; line-height: 1.7; }

        /* Trader Types Grid */
        .trader-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 40px;
        }
        .trader-box {
            background: rgba(0,0,0,0.3);
            border: 1px solid rgba(255,255,255,0.05);
            padding: 25px;
            border-radius: 12px;
            text-align: center;
        }
        .trader-box h6 { color: #B0BF96; font-size: 18px; font-weight: 700; margin-bottom: 10px; }
        .trader-box p { color: #888; font-size: 13px; margin: 0; }

        /* Footer CTA */
        .cta-section {
            background: linear-gradient(135deg, #322C2C 0%, #1a1818 100%);
            border-top: 2px solid #B0BF96;
            padding: 80px 20px;
            text-align: center;
        }
        
        @media (max-width: 768px) {
            .hero-title { font-size: 40px; }
            .security-badge { padding: 20px; }
            .badge-row { flex-direction: column; align-items: flex-start; gap: 5px; margin-bottom: 20px; }
        }
    </style>
</head>
<body>

    <!-- ***** Custom Navbar ***** -->
    <header class="custom-navbar">
        <div class="nav-container">
            <a href="/" class="text-logo">D.E.T <span>SYSTEM</span></a>
            <div class="mobile-toggle" id="mobile-toggle">☰</div>
            <ul class="nav-menu" id="nav-menu">
                <li><a href="/" class="active">Home</a></li>
                <li><a href="/pricing">Trading Levels</a></li>
                <li><a href="/login">Client Access</a></li>
                <li><a href="/pricing" class="nav-btn">Start Your Journey</a></li>
            </ul>
        </div>
    </header>

    <!-- ***** Hero Section ***** -->
    <section class="hero-section">
        <div class="container">
            <h1 class="hero-title">Tha System That <br><span>Buys Money</span></h1>
            <p class="hero-subtitle">
                Introducing D.E.T — Disruptive Exousia Thermostat. A sophisticated, real-time, high-speed Data-Analytics Trading System. Instant market insights delivered with quantum-speed precision.
            </p>

            <div class="security-badge">
                <div class="badge-row">
                    <i class="fas fa-shield-alt badge-icon"></i>
                    <span class="badge-text-old">"Your money is safe with us"</span>
                    <span class="badge-text-new">Your money never leaves your custody</span>
                </div>
                <div class="badge-row">
                    <i class="fas fa-key badge-icon"></i>
                    <span class="badge-text-old">"Give us your login details"</span>
                    <span class="badge-text-new">We never login to your account</span>
                </div>
            </div>

            <br>
            <a href="/pricing" class="btn-primary-custom">Choose Your D.E.T Plan</a>
        </div>
    </section>

    <!-- ***** The Top 1% Advantage ***** -->
    <section class="section-padding">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-4">
                    <h2 class="section-title" style="text-align: left;">The <span>Top 1%</span> Advantage</h2>
                    <p style="color: #aaa; font-size: 18px; line-height: 1.8; margin-bottom: 30px;">
                        D.E.T levels the playing field. It gives the 99% of traders something that has always been reserved for the top 1% of the Financial World: ACCESS to sophisticated, real-time, high-speed data analytics.
                    </p>
                    <p style="color: #fff; font-size: 16px; line-height: 1.8; font-weight: 500;">
                        Not delayed. Not filtered. Not "after the fact." But Access In the precise moment, because in markets, timing is everything.
                    </p>
                </div>
                <div class="col-lg-6">
                    <div class="dark-card">
                        <i class="fas fa-brain card-icon"></i>
                        <h3 class="card-title">Pure Market Logic</h3>
                        <p class="card-text">
                            D.E.T is not magic. It's pure Mathematics, Holy Intelligence (H.I) mixed with Algorithmic Engineering, and Brutal Market Logic—delivered through a system designed for you, not just for quants.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ***** CornerStore Interface ***** -->
    <section class="section-padding" style="background-color: #221f1f;">
        <div class="container">
            <h2 class="section-title">The <span>CornerStore</span> Interface</h2>
            <p style="text-align: center; color: #aaa; max-width: 800px; margin: 0 auto 50px;">
                1:5 Human-Trader Ratio. Supporting five trader types simultaneously & instantaneously with precision. Running predictive models across multiple markets.
            </p>

            <div class="trader-grid">
                <div class="trader-box">
                    <h6>ScalpaTrader</h6>
                    <p>Ultra-short-term precision</p>
                </div>
                <div class="trader-box">
                    <h6>IntraTrader</h6>
                    <p>Within-day opportunities</p>
                </div>
                <div class="trader-box">
                    <h6>DayTrader</h6>
                    <p>Full-day strategies</p>
                </div>
                <div class="trader-box">
                    <h6>SwingTrader</h6>
                    <p>Multi-day positions</p>
                </div>
                <div class="trader-box">
                    <h6>LongTrader</h6>
                    <p>Extended positions</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ***** CTA / Prophecy ***** -->
    <section class="cta-section">
        <div class="container">
            <h2 style="font-size: 42px; font-weight: 800; color: #fff; margin-bottom: 20px;">
                This Is Not Just a Pitch. <span style="color: #B0BF96;">This Is a Prophecy.</span>
            </h2>
            <p style="font-size: 20px; color: #aaa; max-width: 800px; margin: 0 auto 40px; line-height: 1.8;">
                The question is no longer whether technology will transform trading. It already has. The world HAS already automated <strong>without you</strong>. 
            </p>
            <a href="/pricing" class="btn-primary-custom">Start Your D.E.T Journey</a>
        </div>
    </section>

    <!-- ***** Footer ***** -->
    <footer style="background: #111; padding: 30px 0; border-top: 1px solid rgba(255,255,255,0.05); text-align: center;">
        <div class="container">
            <p style="color: #666; font-size: 14px; margin: 0;">
                Copyright © 2026 Shaun Clarence Micro Bank. All Rights Reserved.<br>
            </p>
        </div>
    </footer>

    <!-- Scripts -->
    <script>
        // Mobile Menu Toggle Logic
        document.getElementById('mobile-toggle').addEventListener('click', function() {
            document.getElementById('nav-menu').classList.toggle('active');
        });
    </script>
</body>
</html>