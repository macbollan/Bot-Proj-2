<%- include('partials/header', { title: 'What is D.E.T? | D.E.T System', page: 'home' }) %>

<style>
    /* ==========================================
       PAGE‑SPECIFIC STYLES
    ========================================== */
    .det-hero {
        padding: 80px 20px 60px;
        text-align: center;
        background: radial-gradient(circle at 50% 0%, rgba(176,191,150,0.15) 0%, transparent 70%);
        border-bottom: 1px solid var(--det-border);
    }
    .det-hero h1 {
        font-size: clamp(36px, 8vw, 64px);
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 16px;
    }
    .det-hero h1 span {
        color: var(--det-green);
    }
    .det-hero .hero-subtitle {
        font-size: 18px;
        color: #94a3b8;
        max-width: 700px;
        margin: 0 auto 30px;
    }
    .det-hero .hero-definition {
        background: rgba(176,191,150,0.05);
        border: 1px solid var(--det-border);
        border-radius: 12px;
        padding: 24px;
        max-width: 800px;
        margin: 0 auto;
        font-size: 16px;
        color: #cbd5e1;
        line-height: 1.7;
    }

    .det-section {
        padding: 80px 20px;
    }
    .det-section:nth-child(even) {
        background-color: rgba(176,191,150,0.02);
    }
    .section-heading {
        font-size: 32px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 40px;
        text-align: center;
    }
    .section-heading span {
        color: var(--det-green);
    }
    .det-flow {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 20px 0;
    }
    .flow-step {
        background: var(--det-card);
        border: 1px solid var(--det-border);
        border-radius: 8px;
        padding: 12px 28px;
        color: #e2e8f0;
        font-weight: 500;
        text-align: center;
        min-width: 220px;
    }
    .flow-arrow {
        color: var(--det-green);
        font-size: 20px;
    }
    .det-card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 24px;
    }
    .det-card {
        background: var(--det-card);
        border: 1px solid var(--det-border);
        border-radius: 16px;
        padding: 32px;
        transition: border-color 0.3s, transform 0.3s;
    }
    .det-card:hover {
        border-color: var(--det-border-active);
        transform: translateY(-4px);
    }
    .det-card i {
        font-size: 32px;
        color: var(--det-green);
        margin-bottom: 16px;
    }
    .det-card h3 {
        font-size: 20px;
        font-weight: 600;
        color: #fff;
        margin-bottom: 12px;
    }
    .det-card p {
        color: #94a3b8;
        line-height: 1.7;
        margin: 0;
    }
    .principle-flow {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        margin: 30px 0;
    }
    .principle-step {
        background: rgba(176,191,150,0.08);
        border: 1px solid var(--det-border);
        border-radius: 8px;
        padding: 14px 20px;
        color: #e2e8f0;
        font-weight: 600;
        font-size: 14px;
    }
    .principle-arrow {
        align-self: center;
        color: var(--det-green);
        font-size: 18px;
    }
    .highlight-box {
        background: rgba(176,191,150,0.05);
        border-left: 4px solid var(--det-green);
        border-radius: 0 12px 12px 0;
        padding: 24px;
        margin: 30px 0;
    }
    .highlight-box p {
        color: #cbd5e1;
        margin: 0;
    }
    .cta-bottom {
        text-align: center;
        padding: 60px 20px;
        background: linear-gradient(135deg, rgba(176,191,150,0.08) 0%, transparent 100%);
    }
    @media (max-width: 768px) {
        .det-section { padding: 60px 16px; }
        .section-heading { font-size: 28px; }
    }
</style>

<div class="flex-grow-1">
    <!-- Hero -->
    <section class="det-hero">
        <div class="container">
            <h1>WHAT IS <span>D.E.T</span>?</h1>
            <p class="hero-subtitle">Disruptive Exousia Thermostat</p>
            <div class="hero-definition">
                D.E.T is a Data Analytics and Market Intelligence System designed to help you understand markets, manage risk and make more informed trading decisions.<br><br>
                D.E.T continuously analyses market data and transforms it into actionable intelligence, bringing together market analysis, trend intelligence, risk management, money management, portfolio management and trading functionality within one integrated system.
            </div>
        </div>
    </section>

    <!-- CornerStore Experience -->
    <section class="det-section">
        <div class="container">
            <h2 class="section-heading">Your D.E.T Experience Starts with <span>CornerStore</span></h2>
            <div class="row align-items-center">
                <div class="col-lg-6 mb-4">
                    <p style="font-size: 17px; color: #cbd5e1; line-height: 1.7;">
                        CornerStore is the professional trading dashboard you download and install on your laptop or desktop computer.
                        Once installed, CornerStore becomes your working interface with D.E.T, designed to appear within your trading environment alongside your MT5 workspace.
                    </p>
                    <div class="highlight-box">
                        <p><strong>CornerStore is what you see. <span style="color: var(--det-green);">D.E.T is the intelligence working behind it.</span></strong></p>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="det-card">
                        <i class="bi bi-display"></i>
                        <h3>Through CornerStore, you can see:</h3>
                        <ul class="list-unstyled" style="color:#94a3b8; line-height:2;">
                            <li><i class="bi bi-check2-circle text-success me-2"></i> Market analytics & movements</li>
                            <li><i class="bi bi-check2-circle text-success me-2"></i> Trend information & trading signals</li>
                            <li><i class="bi bi-check2-circle text-success me-2"></i> TIP signals, BUY/SELL opportunities</li>
                            <li><i class="bi bi-check2-circle text-success me-2"></i> Risk & trade-management information</li>
                            <li><i class="bi bi-check2-circle text-success me-2"></i> Alerts, notifications & decision support</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- How CornerStore Fits -->
    <section class="det-section">
        <div class="container">
            <h2 class="section-heading">How CornerStore <span>Fits Into Your Trading Environment</span></h2>
            <div class="det-flow">
                <div class="flow-step">Your MT5 Trading Environment</div>
                <i class="bi bi-arrow-down flow-arrow"></i>
                <div class="flow-step">CornerStore</div>
                <i class="bi bi-arrow-down flow-arrow"></i>
                <div class="flow-step" style="background:rgba(176,191,150,0.1);">D.E.T Cloud / D.E.T Engine</div>
                <i class="bi bi-arrow-down flow-arrow"></i>
                <div class="flow-step">Market Analytics + Intelligence + Risk + Money Management + Execution</div>
                <i class="bi bi-arrow-down flow-arrow"></i>
                <div class="flow-step" style="border:2px solid var(--det-green);">Your Connected Trading Account</div>
            </div>
            <p class="text-center mt-4" style="color:#94a3b8;">A single practical interface – no need to jump between systems.</p>
        </div>
    </section>

    <!-- Why Thermostat -->
    <section class="det-section">
        <div class="container">
            <h2 class="section-heading">Why "Disruptive Exousia <span>Thermostat</span>"?</h2>
            <div class="row">
                <div class="col-lg-6 mb-4">
                    <p style="font-size:17px; color:#cbd5e1; line-height:1.7;">
                        Think about a modern microwave. You select what you want to heat and start the process.
                        You don't continually tell the thermostat what to do every second.
                        The thermostat continuously monitors conditions and regulates the process according to its programmed operating parameters.
                    </p>
                </div>
                <div class="col-lg-6">
                    <div class="highlight-box">
                        <p><strong>D.E.T works on a similar principle:</strong> You choose the markets. D.E.T continuously observes them, analyses changing conditions, applies its proprietary rules, responds, and continues monitoring.</p>
                    </div>
                </div>
            </div>
            <div class="principle-flow">
                <span class="principle-step">Sense</span>
                <i class="bi bi-arrow-right principle-arrow"></i>
                <span class="principle-step">Analyse</span>
                <i class="bi bi-arrow-right principle-arrow"></i>
                <span class="principle-step">Determine</span>
                <i class="bi bi-arrow-right principle-arrow"></i>
                <span class="principle-step">Respond</span>
                <i class="bi bi-arrow-right principle-arrow"></i>
                <span class="principle-step">Monitor</span>
                <i class="bi bi-arrow-right principle-arrow"></i>
                <span class="principle-step">Adjust</span>
            </div>
        </div>
    </section>

    <!-- What D.E.T Does -->
    <section class="det-section">
        <div class="container">
            <h2 class="section-heading">What Does <span>D.E.T Do</span> For You?</h2>
            <div class="det-flow mb-5">
                <div class="flow-step">Market Data</div><i class="bi bi-arrow-down flow-arrow"></i>
                <div class="flow-step">D.E.T Analytics</div><i class="bi bi-arrow-down flow-arrow"></i>
                <div class="flow-step">Market Intelligence</div><i class="bi bi-arrow-down flow-arrow"></i>
                <div class="flow-step" style="background:rgba(176,191,150,0.1);">CornerStore displays the intelligence</div><i class="bi bi-arrow-down flow-arrow"></i>
                <div class="flow-step">You decide or D.E.T operates automatically</div><i class="bi bi-arrow-down flow-arrow"></i>
                <div class="flow-step">Risk & Money Management</div><i class="bi bi-arrow-down flow-arrow"></i>
                <div class="flow-step" style="border:2px solid var(--det-green);">Trade Execution & Management</div>
            </div>
            <div class="det-card-grid">
                <div class="det-card"><i class="bi bi-graph-up"></i><h3>Analyse markets</h3></div>
                <div class="det-card"><i class="bi bi-bar-chart"></i><h3>Identify trends & conditions</h3></div>
                <div class="det-card"><i class="bi bi-lightbulb"></i><h3>Interpret intelligence</h3></div>
                <div class="det-card"><i class="bi bi-shield-check"></i><h3>Manage risk & position sizing</h3></div>
                <div class="det-card"><i class="bi bi-cash-stack"></i><h3>Money & portfolio management</h3></div>
                <div class="det-card"><i class="bi bi-robot"></i><h3>Automate selected activities</h3></div>
            </div>
        </div>
    </section>

    <!-- You Choose the Markets -->
    <section class="det-section">
        <div class="container text-center">
            <h2 class="section-heading">You Choose <span>the Markets</span></h2>
            <p style="font-size:18px; color:#cbd5e1; max-width:800px; margin:0 auto 30px;">
                You decide which markets D.E.T operates on – currencies, commodities, indices, synthetics, and more.
                You are not required to follow someone else's portfolio. <strong>You choose where D.E.T looks.</strong>
            </p>
            <div class="highlight-box d-inline-block text-start">
                <p><i class="bi bi-info-circle-fill text-success me-2"></i> The markets available to you depend on your connected broker, account and supported market infrastructure.</p>
            </div>
        </div>
    </section>

    <!-- Trading Through CornerStore -->
    <section class="det-section">
        <div class="container">
            <h2 class="section-heading">When You Trade Through <span>CornerStore</span></h2>
            <div class="row">
                <div class="col-lg-6 mb-4">
                    <p style="font-size:17px; color:#cbd5e1; line-height:1.7;">
                        See a BUY or SELL opportunity → Press the button → D.E.T handles the complexity:
                    </p>
                    <ul class="list-unstyled" style="color:#94a3b8;">
                        <li><i class="bi bi-check text-success me-2"></i> Lot size calculation</li>
                        <li><i class="bi bi-check text-success me-2"></i> Float allocation</li>
                        <li><i class="bi bi-check text-success me-2"></i> Risk & money-management rules</li>
                        <li><i class="bi bi-check text-success me-2"></i> Stop Loss / Take Profit</li>
                        <li><i class="bi bi-check text-success me-2"></i> Trader-type rules</li>
                    </ul>
                </div>
                <div class="col-lg-6">
                    <div class="highlight-box">
                        <p><strong>See → Decide → Press → D.E.T handles the complexity.</strong></p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- D.E.T Disagrees -->
    <section class="det-section">
        <div class="container">
            <h2 class="section-heading">What If D.E.T <span>Disagrees</span> With Your Manual Trade?</h2>
            <div class="det-flow">
                <div class="flow-step">Your instruction</div><i class="bi bi-arrow-down flow-arrow"></i>
                <div class="flow-step">D.E.T validation</div><i class="bi bi-arrow-down flow-arrow"></i>
                <div class="flow-step">Trading condition checked</div><i class="bi bi-arrow-down flow-arrow"></i>
                <div class="flow-step" style="color:#ef4444; border-color:rgba(239,68,68,0.5);">If incompatible: trade blocked</div><i class="bi bi-arrow-down flow-arrow"></i>
                <div class="flow-step">CornerStore alert with reason</div>
            </div>
            <p class="text-center mt-4" style="color:#94a3b8;">This discipline is built into D.E.T – you can request a trade, but D.E.T will prevent instructions that conflict with its operating conditions.</p>
        </div>
    </section>

    <!-- MT5 Override -->
    <section class="det-section">
        <div class="container">
            <h2 class="section-heading">Trading Directly Through <span>MT5</span></h2>
            <p class="text-center" style="font-size:17px; color:#cbd5e1; max-width:800px; margin:0 auto;">
                If you place a trade through the native MT5 interface, D.E.T treats it as a participant override.
                It can manage the position (Stop Loss, Take Profit) but does not retroactively determine lot size or float allocation.
                <strong>For the full D.E.T workflow, use CornerStore.</strong>
            </p>
        </div>
    </section>

    <!-- Manual / Assisted / Automated -->
    <section class="det-section">
        <div class="container">
            <h2 class="section-heading">Trading Modes</h2>
            <div class="det-card-grid">
                <div class="det-card">
                    <i class="bi bi-hand-index"></i>
                    <h3>Manual Trading</h3>
                    <p>You see the signal, make the decision. Press BUY/SELL through CornerStore – D.E.T handles the processing and management.</p>
                </div>
                <div class="det-card">
                    <i class="bi bi-life-preserver"></i>
                    <h3>Assisted Trading</h3>
                    <p>You remain actively involved while D.E.T provides intelligence, analysis, alerts, risk management and trade-management functions.</p>
                </div>
                <div class="det-card">
                    <i class="bi bi-cpu"></i>
                    <h3>Automated Trading</h3>
                    <p>You select the markets. D.E.T continuously analyses and can execute authorised trading automatically according to its proprietary rules.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Cloud Architecture -->
    <section class="det-section">
        <div class="container">
            <h2 class="section-heading">Your Laptop Doesn't Have to Run <span>Your D.E.T Environment</span></h2>
            <div class="row">
                <div class="col-lg-6 mb-4">
                    <div class="det-flow">
                        <div class="flow-step">Your laptop</div><i class="bi bi-arrow-down flow-arrow"></i>
                        <div class="flow-step">CornerStore</div><i class="bi bi-arrow-down flow-arrow"></i>
                        <div class="flow-step" style="background:rgba(176,191,150,0.1);">D.E.T Cloud</div><i class="bi bi-arrow-down flow-arrow"></i>
                        <div class="flow-step">D.E.T Intelligence</div><i class="bi bi-arrow-down flow-arrow"></i>
                        <div class="flow-step" style="border:2px solid var(--det-green);">Your selected trading environment</div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <p style="color:#cbd5e1; line-height:1.7;">
                        Once deployed to the cloud, your laptop can be off. D.E.T continues analysing, managing, and executing according to your selected markets.
                        When you reconnect, CornerStore displays the current state.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- For Everyone -->
    <section class="det-section">
        <div class="container">
            <h2 class="section-heading">Designed for <span>Every Trader</span></h2>
            <div class="det-card-grid">
                <div class="det-card"><i class="bi bi-person"></i><h3>Newer Traders</h3><p>Structured intelligence and discipline around risk and trade management.</p></div>
                <div class="det-card"><i class="bi bi-person-check"></i><h3>Experienced Traders</h3><p>Enhance your workflow with analysis, intelligence and trade management.</p></div>
                <div class="det-card"><i class="bi bi-briefcase"></i><h3>Professional Traders</h3><p>Broader market analysis, multi-market intelligence, risk management and automation.</p></div>
            </div>
        </div>
    </section>

    <!-- The D.E.T Principle -->
    <section class="det-section">
        <div class="container text-center">
            <h2 class="section-heading">The <span>D.E.T Principle</span></h2>
            <div class="principle-flow">
                <span class="principle-step">Sense</span>
                <i class="bi bi-arrow-right principle-arrow"></i>
                <span class="principle-step">Analyse</span>
                <i class="bi bi-arrow-right principle-arrow"></i>
                <span class="principle-step">Determine</span>
                <i class="bi bi-arrow-right principle-arrow"></i>
                <span class="principle-step">Respond</span>
                <i class="bi bi-arrow-right principle-arrow"></i>
                <span class="principle-step">Monitor</span>
                <i class="bi bi-arrow-right principle-arrow"></i>
                <span class="principle-step">Adjust</span>
            </div>
            <p style="color:#cbd5e1; max-width:700px; margin:0 auto;">That is the principle behind Disruptive Exousia Thermostat.</p>
        </div>
    </section>

    <!-- CTA -->
    <div class="cta-bottom">
        <h2 class="section-heading">Welcome to <span>D.E.T</span></h2>
        <p style="font-size:18px; color:#cbd5e1; max-width:800px; margin:0 auto 30px;">
            Choose your markets. Install CornerStore. Let D.E.T handle the complexity behind the scenes.
        </p>
        <a href="/pricing" class="btn-primary-custom" style="font-size:18px; padding:16px 40px; border-radius:8px; background:var(--det-green); color:#0a0a0a; font-weight:700; text-decoration:none; display:inline-block; transition:0.3s;">
            Start Your D.E.T Journey
        </a>
    </div>
</div>

<%- include('partials/footer') %>