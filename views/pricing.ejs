                    <input type="hidden" name="selectedTier" id="modalTierInput" value="">
                    
                    <div class="d-flex justify-content-between align-items-center mb-3 p-3 rounded" style="background: rgba(176, 191, 150, 0.1); border: 1px solid var(--det-border);">
                        <span class="text-uppercase fw-bold" style="font-size: 12px; color: #cbd5e1;">Selected Level</span>
                        <span class="fw-bold text-accent fs-5" id="modalTierDisplay">--</span>
                    </div>

                    <p class="small fw-bold text-white mb-2 text-start">Terms & Risk Disclosure</p>
                    <div class="terms-box">
                        <p style="color: inherit;">1. D.E.T System is NOT an Investment Institution, nor an Investment Advisor.</p>
                        <p style="color: inherit;">2. Caveat Subscriptor: There are NO guarantees of profit. Trading carries a high level of risk.</p>
                        <p style="color: inherit;">3. Zero-Hedge Protocol: If your account reaches 100% gain, the D.E.T connection will suspend.</p>
                        <p style="color: inherit;">4. Diverted Account Warning: Account may be diverted to lower grade if prepaid subscription differs from trading float.</p>
                    </div>

                    <div class="form-check mt-3 d-flex align-items-center gap-2 text-start">
                        <input class="form-check-input mt-0" type="checkbox" id="finalTermsCheck" required>
                        <label class="form-check-label text-white small" for="finalTermsCheck" style="cursor: pointer;">
                            I confirm I have read and agree to the Risk Disclosure.
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-det-modal" id="proceedBtn" disabled>Continue to Setup <i class="bi bi-arrow-right ms-1"></i></button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===== SCRIPT ===== -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize all modals
        const termsModalEl = document.getElementById('termsModal');
        const checkoutModalEl = document.getElementById('checkoutModal');
        
        const termsModal = termsModalEl ? new bootstrap.Modal(termsModalEl) : null;
        const checkoutModal = checkoutModalEl ? new bootstrap.Modal(checkoutModalEl) : null;
        
        // Terms modal elements
        const termsCheck = document.getElementById('termsCheck');
        const agreeBtn = document.getElementById('agreeBtn');
        
        // Checkout modal elements
        const finalTermsCheck = document.getElementById('finalTermsCheck');
        const proceedBtn = document.getElementById('proceedBtn');
        
        let selectedTierName = '';

        // Toggle full terms expand/collapse
        window.toggleFullTerms = function() {
            const fullTerms = document.getElementById('fullTermsContent');
            const expandLink = document.getElementById('expandLink');
            
            if (fullTerms.style.display === 'none') {
                fullTerms.style.display = 'block';
                expandLink.innerHTML = '<i class="bi bi-arrows-collapse me-1"></i>Hide Complete Terms & Conditions';
                fullTerms.scrollIntoView({ behavior: 'smooth', block: 'start' });
            } else {
                fullTerms.style.display = 'none';
                expandLink.innerHTML = '<i class="bi bi-arrows-expand me-1"></i>View Complete Terms & Conditions';
            }
        };

        // Global function called from tier cards - opens terms modal
        window.openTermsModal = function(tierName) {
            if (!termsModal) return;
            
            // Reset state
            if (termsCheck) termsCheck.checked = false;
            if (agreeBtn) agreeBtn.disabled = true;


            // Show full terms expanded by default
            const fullTerms = document.getElementById('fullTermsContent');
            if (fullTerms) fullTerms.style.display = 'block';
            const expandLink = document.getElementById('expandLink');
            if (expandLink) expandLink.innerHTML = '<i class="bi bi-arrows-collapse me-1"></i>Hide Complete Terms & Conditions';


            // Store selected tier
            selectedTierName = tierName;
            document.getElementById('termsTierDisplay').innerText = tierName;
            
            // Show terms modal
            termsModal.show();
        };

        // Enable/disable agree button based on terms checkbox
        if (termsCheck && agreeBtn) {
            termsCheck.addEventListener('change', function() {
                agreeBtn.disabled = !this.checked;
            });
        }

        // Proceed from terms to checkout
        window.proceedToCheckout = function() {
            if (!termsModal || !checkoutModal) return;
            
            // Hide terms modal
            termsModal.hide();
            
            // Reset checkout modal
            if (finalTermsCheck) finalTermsCheck.checked = false;
            if (proceedBtn) proceedBtn.disabled = true;
            
            // Set tier in checkout modal
            document.getElementById('modalTierDisplay').innerText = selectedTierName;
            document.getElementById('modalTierInput').value = selectedTierName;
            
            // Show checkout modal with smooth delay
            setTimeout(function() {
                checkoutModal.show();
            }, 300);
        };

        // Enable/disable proceed button in checkout modal
        if (finalTermsCheck && proceedBtn) {
            finalTermsCheck.addEventListener('change', function() {
                proceedBtn.disabled = !this.checked;
            });
        }
    });
</script>

