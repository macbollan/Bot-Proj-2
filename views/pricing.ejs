<script>
    document.addEventListener('DOMContentLoaded', function() {
        const termsModalEl = document.getElementById('termsModal');
        const termsModal = termsModalEl ? new bootstrap.Modal(termsModalEl) : null;
        
        const termsCheck = document.getElementById('termsCheck');
        const agreeBtn = document.getElementById('agreeBtn');
        
        let selectedTierName = '';

        window.openTermsModal = function(tierName) {
            if (!termsModal) return;
            
            if (termsCheck) termsCheck.checked = false;
            if (agreeBtn) agreeBtn.disabled = true;
            
            selectedTierName = tierName;
            document.getElementById('termsTierDisplay').innerText = tierName;
            
            termsModal.show();
        };

        if (termsCheck && agreeBtn) {
            termsCheck.addEventListener('change', function() {
                agreeBtn.disabled = !this.checked;
            });
        }

        window.proceedToCheckout = function() {
            if (!termsModal) return;
            
            termsModal.hide();
            
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/checkout/initialize';
            
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'selectedTier';
            input.value = selectedTierName;
            
            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        };
    });
</script>

