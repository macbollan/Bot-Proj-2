<%- include('partials/header', { title: 'How It Works | D.E.T System', page: 'how-it-works' }) %>

<style>
    /* Hero Section */
    .how-hero {
        background: linear-gradient(135deg, rgba(176,191,150,0.05) 0%, rgba(50,44,44,0.3) 100%);
        padding: 80px 0 60px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .how-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle at center, rgba(176,191,150,0.03) 0%, transparent 70%);
        animation: heroPulse 8s ease-in-out infinite;
    }
    @keyframes heroPulse {
        0%, 100% { transform: scale(1); opacity: 0.5; }
        50% { transform: scale(1.1); opacity: 0.8; }
    }
    .how-hero-content {
        position: relative;
        z-index: 1;
    }
    .how-hero-badge {
        display: inline-block;
        background: rgba(176,191,150,0.15);
        border: 1px solid var(--det-border);
        border-radius: 50px;
        padding: 8px 24px;
        color: var(--det-green);
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 24px;
    }
    .how-hero h1 {
        font-size: 48px;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 20px;
        line-height: 1.2;
    }
    .how-hero h1 span {
        background: linear-gradient(135deg, var(--det-green) 0%, #d4e4b0 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .how-hero-subtitle {
        font-size: 18px;
        color: #94a3b8;
        max-width: 600px;
        margin: 0 auto 40px;
        line-height: 1.6;
    }
    .hero-stats {
        display: flex;
        justify-content: center;
        gap: 60px;
        margin-top: 40px;
    }
    .hero-stat {
        text-align: center;
    }
    .hero-stat-number {
        font-size: 36px;
        font-weight: 800;
        color: var(--det-green);
        display: block;
    }
    .hero-stat-label {
        font-size: 13px;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 4px;
    }

    /* Process Timeline */
    .process-section {
        padding: 80px 0;
        position: relative;
    }
    .section-header {
        text-align: center;
        margin-bottom: 60px;
    }
    .section-header h2 {
        font-size: 36px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 12px;
    }
    .section-header p {
        color: #94a3b8;
        font-size: 16px;
        max-width: 500px;
        margin: 0 auto;
    }
    
    .timeline {
        position: relative;
        max-width: 900px;
        margin: 0 auto;
        padding: 0 20px;
    }
    .timeline::before {
        content: '';
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        width: 2px;
        height: calc(100% - 100px);
        background: linear-gradient(to bottom, var(--det-green), rgba(176,191,150,0.1));
        top: 50px;
    }
    .timeline-step {
        display: flex;
        align-items: flex-start;
        margin-bottom: 80px;
        position: relative;
    }
    .timeline-step:nth-child(odd) {
        flex-direction: row;
    }
    .timeline-step:nth-child(even) {
        flex-direction: row-reverse;
    }
    .timeline-step:last-child {
        margin-bottom: 0;
    }
    
    .step-number-container {
        flex-shrink: 0;
        width: 60px;
        height: 60px;
        position: relative;
        z-index: 2;
    }
    .step-number {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: var(--det-card);
        border: 2px solid var(--det-green);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        font-weight: 800;
        color: var(--det-green);
        position: sticky;
        top: 50%;
        box-shadow: 0 0 30px rgba(176,191,150,0.2);
    }
    
    .step-content {
        flex: 1;
        max-width: 380px;
        background: var(--det-card);
        border: 1px solid var(--det-border);
        border-radius: 16px;
        padding: 30px;
        transition: all 0.3s ease;
        position: relative;
    }
    .step-content:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.3);
        border-color: var(--det-green);
    }
    .timeline-step:nth-child(odd) .step-content {
        margin-left: 40px;
    }
    .timeline-step:nth-child(even) .step-content {
        margin-right: 40px;
    }
    
    .step-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: rgba(176,191,150,0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        color: var(--det-green);
        margin-bottom: 20px;
    }
    .step-content h3 {
        font-size: 20px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 12px;
    }
    .step-content p {
        color: #94a3b8;
        font-size: 14px;
        line-height: 1.7;
        margin-bottom: 16px;
    }
    .step-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    .step-tag {
        background: rgba(176,191,150,0.1);
        border: 1px solid rgba(176,191,150,0.2);
        border-radius: 20px;
        padding: 5px 14px;
        font-size: 11px;
        color: var(--det-green);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .step-image-placeholder {
        width: 100%;
        height: 160px;
        background: rgba(0,0,0,0.3);
        border: 2px dashed var(--det-border);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #64748b;
        font-size: 12px;
        margin-top: 16px;
        transition: all 0.3s;
    }
    .step-image-placeholder:hover {
        border-color: var(--det-green);
        color: var(--det-green);
        background: rgba(176,191,150,0.05);
    }
    .step-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--det-green);
        font-weight: 600;
        font-size: 13px;
        text-decoration: none;
        margin-top: 12px;
        transition: gap 0.3s;
    }
    .step-link:hover {
        gap: 12px;
        color: var(--det-green-hover);
    }

    /* Tiers Quick View */
    .tiers-mini-section {
        padding: 60px 0;
        background: rgba(176,191,150,0.02);
    }
    .tiers-scroll {
        display: flex;
        gap: 20px;
        overflow-x: auto;
        padding: 20px 0;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
    }
    .tiers-scroll::-webkit-scrollbar {
        height: 4px;
    }
    .tiers-scroll::-webkit-scrollbar-track {
        background: rgba(255,255,255,0.05);
        border-radius: 2px;
    }
    .tiers-scroll::-webkit-scrollbar-thumb {
        background: var(--det-green);
        border-radius: 2px;
    }
    .tier-mini-card {
        flex-shrink: 0;
        width: 240px;
        background: var(--det-card);
        border: 1px solid var(--det-border);
        border-radius: 12px;
        padding: 24px;
        scroll-snap-align: start;
        transition: all 0.3s;
        text-decoration: none;
        display: block;
    }
    .tier-mini-card:hover {
        border-color: var(--det-green);
        transform: translateY(-4px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
    .tier-mini-card.highlight {
        border-color: var(--det-green);
        background: rgba(176,191,150,0.05);
    }
    .tier-mini-name {
        font-size: 18px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 4px;
    }
    .tier-mini-float {
        font-size: 12px;
        color: #94a3b8;
        margin-bottom: 12px;
    }
    .tier-mini-pct {
        font-size: 28px;
        font-weight: 800;
        color: var(--det-green);
    }
    .tier-mini-period {
        font-size: 11px;
        color: #64748b;
        margin-top: 2px;
    }
    .tier-mini-arrow {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: var(--det-green);
        font-size: 13px;
        font-weight: 600;
        margin-top: 16px;
    }

    /* CTA Section */
    .cta-section {
        padding: 80px 0;
        text-align: center;
        background: linear-gradient(135deg, rgba(176,191,150,0.05) 0%, transparent 100%);
    }
    .cta-card {
        background: var(--det-card);
        border: 1px solid var(--det-border);
        border-radius: 20px;
        padding: 60px 40px;
        max-width: 700px;
        margin: 0 auto;
        position: relative;
        overflow: hidden;
    }
    .cta-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--det-green), transparent);
    }
    .cta-card h2 {
        font-size: 32px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 16px;
    }
    .cta-card p {
        color: #94a3b8;
        font-size: 16px;
        margin-bottom: 30px;
        line-height: 1.6;
    }
    .cta-buttons {
        display: flex;
        gap: 16px;
        justify-content: center;
        flex-wrap: wrap;
    }
    .btn-cta-primary {
        background: var(--det-green);
        color: var(--det-dark);
        padding: 14px 32px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 15px;
        text-decoration: none;
        transition: all 0.3s;
    }
    .btn-cta-primary:hover {
        background: var(--det-green-hover);
        transform: translateY(-2px);
        color: var(--det-dark);
    }
    .btn-cta-secondary {
        background: transparent;
        color: var(--det-green);
        padding: 14px 32px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 15px;
        text-decoration: none;
        border: 1px solid var(--det-green);
        transition: all 0.3s;
    }
    .btn-cta-secondary:hover {
        background: rgba(176,191,150,0.1);
        color: var(--det-green);
    }

    /* FAQ Mini */
    .faq-mini {
        max-width: 800px;
        margin: 60px auto 0;
        padding: 0 20px;
    }
    .faq-mini h3 {
        text-align: center;
        font-size: 24px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 30px;
    }
    .faq-item {
        background: var(--det-card);
        border: 1px solid var(--det-border);
        border-radius: 10px;
        margin-bottom: 12px;
        overflow: hidden;
    }
    .faq-question {
        padding: 18px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        font-weight: 600;
        font-size: 14px;
        color: #ffffff;
        user-select: none;
    }
    .faq-question i {
        color: var(--det-green);
        transition: transform 0.3s;
        font-size: 12px;
    }
    .faq-item.open .faq-question i {
        transform: rotate(180deg);
    }
    .faq-answer {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease, padding 0.3s ease;
        padding: 0 24px;
        color: #94a3b8;
        font-size: 13px;
        line-height: 1.7;
    }
    .faq-item.open .faq-answer {
        max-height: 200px;
        padding: 0 24px 18px;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .how-hero h1 {
            font-size: 32px;
        }
        .hero-stats {
            gap: 30px;
        }
        .hero-stat-number {
            font-size: 28px;
        }
        .timeline::before {
            left: 30px;
        }
        .timeline-step,
        .timeline-step:nth-child(even) {
            flex-direction: row !important;
        }
        .timeline-step:nth-child(odd) .step-content,
        .timeline-step:nth-child(even) .step-content {
            margin-left: 30px;
            margin-right: 0;
            max-width: 100%;
        }
        .step-number-container {
            width: 50px;
            height: 50px;
        }
        .step-number {
            width: 50px;
            height: 50px;
            font-size: 18px;
        }
        .cta-card {
            padding: 40px 20px;
        }
        .cta-card h2 {
            font-size: 24px;
        }
    }
</style>

