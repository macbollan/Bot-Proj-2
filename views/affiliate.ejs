<%- include('partials/header', { title: 'Affiliate Program | D.E.T System', page: 'affiliate' }) %>

<style>
    .affiliate-hero {
        background: linear-gradient(135deg, rgba(176,191,150,0.1) 0%, rgba(50,44,44,0.5) 100%);
        border: 1px solid var(--det-border);
        border-radius: 16px;
        padding: 50px 30px;
        text-align: center;
        margin-bottom: 40px;
    }
    .commission-card {
        background: var(--det-card);
        border: 1px solid var(--det-border);
        border-radius: 12px;
        padding: 30px;
        text-align: center;
        height: 100%;
    }
    .commission-badge {
        font-size: 48px;
        font-weight: 800;
        color: var(--det-green);
    }
    .step-card {
        background: var(--det-card);
        border: 1px solid var(--det-border);
        border-radius: 12px;
        padding: 25px;
        text-align: center;
        height: 100%;
        position: relative;
    }
    .step-number {
        width: 40px;
        height: 40px;
        background: var(--det-green);
        color: var(--det-dark);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 18px;
        margin: 0 auto 15px;
    }
    .btn-affiliate {
        background: var(--det-green);
        color: var(--det-dark);
        font-weight: 700;
        padding: 14px 30px;
        border-radius: 10px;
        font-size: 16px;
        transition: all 0.3s;
        border: none;
        display: inline-block;
        text-decoration: none;
        cursor: pointer;
    }
    .btn-affiliate:hover {
        background: var(--det-green-hover);
        transform: translateY(-2px);
        color: #000;
    }
    .tier-payout {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .tier-payout:last-child {
        border-bottom: none;
    }
    
    .already-affiliate {
        background: rgba(176,191,150,0.08);
        border: 1px solid rgba(176,191,150,0.25);
        border-radius: 14px;
        padding: 40px;
        text-align: center;
    }

    .agreement-check-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 14px 16px;
        background: rgba(0,0,0,0.2);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 10px;
        margin-bottom: 10px;
        transition: all 0.2s;
        cursor: pointer;
    }
    .agreement-check-item:hover {
        border-color: rgba(176,191,150,0.3);
        background: rgba(176,191,150,0.03);
    }
    .agreement-check-item.checked {
        border-color: rgba(176,191,150,0.4);
        background: rgba(176,191,150,0.06);
    }
    .agreement-check-item input[type="checkbox"] {
        margin-top: 2px;
        width: 18px;
        height: 18px;
        accent-color: var(--det-green);
        flex-shrink: 0;
    }
    .agreement-check-item label {
        font-size: 13px;
        color: #cbd5e1;
        cursor: pointer;
        line-height: 1.5;
        user-select: none;
    }
    .agreement-check-item.checked label {
        color: #fff;
    }
    
    .affiliate-agreement-box {
        background: var(--det-dark);
        border: 1px solid var(--det-border);
        border-radius: 10px;
        padding: 20px;
        height: 350px;
        overflow-y: auto;
        font-size: 11px;
        color: #cbd5e1;
        line-height: 1.7;
        margin-bottom: 20px;
        text-align: left;
    }
    .affiliate-agreement-box::-webkit-scrollbar {
        width: 5px;
    }
    .affiliate-agreement-box::-webkit-scrollbar-thumb {
        background: var(--det-border);
        border-radius: 4px;
    }
    .affiliate-agreement-box h6 {
        color: var(--det-green);
        font-weight: 700;
        font-size: 12px;
        margin-top: 14px;
        margin-bottom: 6px;
    }
    .affiliate-agreement-box h6:first-child {
        margin-top: 0;
    }
    .affiliate-agreement-box strong {
        color: #fff;
    }
    .affiliate-agreement-box .section-title-agreement {
        color: var(--det-green);
        font-weight: 700;
        font-size: 13px;
        text-align: center;
        margin: 15px 0 10px;
        padding-top: 15px;
        border-top: 1px solid rgba(176,191,150,0.15);
    }

    .agreement-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 20px 0;
        color: #64748b;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
    }
    .agreement-divider::before,
    .agreement-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--det-border);
    }

    .progress-steps {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-bottom: 20px;
    }
    .progress-step {
        width: 30px;
        height: 4px;
        border-radius: 2px;
        background: #475569;
        transition: background 0.3s;
    }
    .progress-step.active {
        background: var(--det-green);
    }
    .progress-step.done {
        background: var(--det-green);
    }
</style>

<div class="container" style="max-width: 1000px; margin-top: 30px; margin-bottom: 60px;">

    <% if(isAffiliate && affiliate) { %>
        <div class="already-affiliate mb-5">
            <div style="font-size: 50px; margin-bottom: 15px;">🎯</div>
            <h2 class="fw-bold mb-2">You're Already an Affiliate!</h2>
            <p style="color: #cbd5e1; font-size: 16px; margin-bottom: 20px;">
                You joined on <%= new Date(affiliate.joinedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
            </p>
            
            <div class="row g-3 mb-4">
                <div class="col-4">
                    <div style="background: var(--det-dark); border-radius: 8px; padding: 15px;">
                        <div style="font-size: 22px; font-weight: 800; color: var(--det-green);"><%= affiliate.totalClicks.toLocaleString() %></div>
                        <div style="font-size: 11px; color: #94a3b8; text-transform: uppercase;">Clicks</div>
                    </div>
                </div>
                <div class="col-4">
                    <div style="background: var(--det-dark); border-radius: 8px; padding: 15px;">
                        <div style="font-size: 22px; font-weight: 800; color: var(--det-green);"><%= affiliate.totalReferrals %></div>
                        <div style="font-size: 11px; color: #94a3b8; text-transform: uppercase;">Referrals</div>
                    </div>
                </div>
                <div class="col-4">
                    <div style="background: var(--det-dark); border-radius: 8px; padding: 15px;">
                        <div style="font-size: 22px; font-weight: 800; color: var(--det-green);">$<%= affiliate.totalEarnings.toFixed(2) %></div>
                        <div style="font-size: 11px; color: #94a3b8; text-transform: uppercase;">Earned</div>
                    </div>
                </div>
            </div>
            
            <a href="/affiliate/dashboard" class="btn-affiliate">
                <i class="bi bi-speedometer2 me-2"></i> Go to Your Affiliate Dashboard
            </a>
        </div>
        
    <% } else { %>
        <div class="affiliate-hero">
            <span style="background: rgba(176,191,150,0.15); color: var(--det-green); padding: 6px 18px; border-radius: 20px; font-size: 12px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase;">D.E.T Affiliate Program</span>
            <h1 class="fw-bold mt-3 mb-2" style="font-size: 36px;">Earn 20% Commission<br>on Every Referral</h1>
            <p style="color: #cbd5e1; font-size: 16px; max-width: 600px; margin: 0 auto 25px;">
                Share your unique affiliate link and earn passive income when anyone subscribes to D.E.T through you. Ends 2 April 2030.
            </p>
            
            <% if(currentUser) { %>
                <form action="/affiliate/join" method="POST">
                    <button type="submit" class="btn-affiliate">
                        <i class="bi bi-rocket-takeoff me-2"></i> Join Affiliate Program Now
                    </button>
                </form>
                <p class="mt-2" style="font-size: 12px; color: #94a3b8;">Instant activation · Start earning today</p>
            <% } else { %>
                <button type="button" class="btn-affiliate" data-bs-toggle="modal" data-bs-target="#affiliateAgreementModal">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Login to Join
                </button>
                <p class="mt-2" style="font-size: 12px; color: #94a3b8;">Don't have an account? <a href="/register?redirect=affiliate" style="color: var(--det-green);">Register here</a></p>
            <% } %>
        </div>
    <% } %>

    <h3 class="fw-bold text-center mb-4">How It Works</h3>
    <div class="row g-3 mb-5">
        <div class="col-md-4">
            <div class="step-card">
                <div class="step-number">1</div>
                <i class="bi bi-link-45deg" style="font-size: 30px; color: var(--det-green); display: block; margin-bottom: 10px;"></i>
                <h5 class="fw-bold">Get Your Link</h5>
                <p style="color: #94a3b8; font-size: 13px;">Join the program and receive your unique referral link instantly.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="step-card">
                <div class="step-number">2</div>
                <i class="bi bi-share" style="font-size: 30px; color: var(--det-green); display: block; margin-bottom: 10px;"></i>
                <h5 class="fw-bold">Share Everywhere</h5>
                <p style="color: #94a3b8; font-size: 13px;">Share on WhatsApp, Facebook, Telegram — anywhere traders are.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="step-card">
                <div class="step-number">3</div>
                <i class="bi bi-cash-stack" style="font-size: 30px; color: var(--det-green); display: block; margin-bottom: 10px;"></i>
                <h5 class="fw-bold">Earn 20%</h5>
                <p style="color: #94a3b8; font-size: 13px;">Get 20% of every subscription payment your referrals make. Forever.</p>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-lg-6">
            <div class="commission-card">
                <h5 class="fw-bold mb-3">Commission Breakdown</h5>
                <p style="color: #94a3b8; font-size: 13px; margin-bottom: 20px;">Example earnings per tier when someone subscribes:</p>
                
                <div class="tier-payout">
                    <span style="color: #cbd5e1;">Topaz ($200 subscription)</span>
                    <span class="fw-bold" style="color: var(--det-green);">$40 commission</span>
                </div>
                <div class="tier-payout">
                    <span style="color: #cbd5e1;">Tanzanite ($1,000 subscription)</span>
                    <span class="fw-bold" style="color: var(--det-green);">$200 commission</span>
                </div>
                <div class="tier-payout">
                    <span style="color: #cbd5e1;">Sapphire ($5,000 subscription)</span>
                    <span class="fw-bold" style="color: var(--det-green);">$1,000 commission</span>
                </div>
                <div class="tier-payout">
                    <span style="color: #cbd5e1;">Diamond ($70,000 subscription)</span>
                    <span class="fw-bold" style="color: var(--det-green);">$14,000 commission</span>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="commission-card">
                <h5 class="fw-bold mb-3">Why Join?</h5>
                <ul class="text-start" style="list-style: none; padding: 0;">
                    <li style="color: #cbd5e1; margin-bottom: 12px; font-size: 14px;">
                        <i class="bi bi-check-circle-fill me-2" style="color: var(--det-green);"></i>
                        <strong>Instant Activation</strong> — Start earning immediately
                    </li>
                    <li style="color: #cbd5e1; margin-bottom: 12px; font-size: 14px;">
                        <i class="bi bi-check-circle-fill me-2" style="color: var(--det-green);"></i>
                        <strong>Real-Time Tracking</strong> — See clicks and conversions instantly
                    </li>
                    <li style="color: #cbd5e1; margin-bottom: 12px; font-size: 14px;">
                        <i class="bi bi-check-circle-fill me-2" style="color: var(--det-green);"></i>
                        <strong>Weekly Payouts</strong> — Request payout anytime above $50
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- =========================================
     AFFILIATE AGREEMENT MODAL
========================================= -->
<div class="modal fade" id="affiliateAgreementModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="background-color: var(--det-card) !important; color: #fff !important; border: 1px solid var(--det-border); border-radius: 16px;">
            <div class="modal-header" style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                <div>
                    <h5 class="modal-title fw-bold text-white">
                        <i class="bi bi-file-earmark-check text-accent me-2"></i>D.E.T Affiliate Agreement
                    </h5>
                    <small style="color: #94a3b8;">You must agree to all clauses before proceeding</small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                
                <div class="progress-steps">
                    <span class="progress-step active" id="step1"></span>
                    <span class="progress-step" id="step2"></span>
                </div>
                <p class="text-center text-muted small mb-4" id="stepLabel">Step 1: Accept Affiliate Clauses</p>

                <!-- ===== STEP 1: MANDATORY CLAUSES ===== -->
                <div id="clausesSection">
                    <p class="fw-bold text-white mb-3" style="font-size: 13px;">
                        <i class="bi bi-check2-square me-2" style="color: var(--det-green);"></i>Please confirm each of the following:
                    </p>

                    <div class="agreement-check-item" onclick="toggleCheck(this, 'check1')">
                        <input type="checkbox" id="check1" onclick="event.stopPropagation(); toggleCheck(document.getElementById('check1').closest('.agreement-check-item'), 'check1')">
                        <label for="check1">As an Affiliate I will <strong>not</strong> offer "Any Guarantees".</label>
                    </div>

                    <div class="agreement-check-item" onclick="toggleCheck(this, 'check2')">
                        <input type="checkbox" id="check2" onclick="event.stopPropagation(); toggleCheck(document.getElementById('check2').closest('.agreement-check-item'), 'check2')">
                        <label for="check2">As an Affiliate if I offer guarantees my commission will be <strong>suspended</strong> pending investigation, <strong>blocked instantly</strong>, or <strong>banned permanently</strong> at D.E.T discretion.</label>
                    </div>

                    <div class="agreement-check-item" onclick="toggleCheck(this, 'check3')">
                        <input type="checkbox" id="check3" onclick="event.stopPropagation(); toggleCheck(document.getElementById('check3').closest('.agreement-check-item'), 'check3')">
                        <label for="check3">As an Affiliate it is <strong>D.E.T results</strong> that I shall be marketing.</label>
                    </div>

                    <div class="agreement-check-item" onclick="toggleCheck(this, 'check4')">
                        <input type="checkbox" id="check4" onclick="event.stopPropagation(); toggleCheck(document.getElementById('check4').closest('.agreement-check-item'), 'check4')">
                        <label for="check4">I agree that <strong>D.E.T is not liable</strong> for my individual guarantees, false promises, or false hope that I may make to potential participants, or any such promises to get commissions.</label>
                    </div>

                    <div class="agreement-check-item" onclick="toggleCheck(this, 'check5')">
                        <input type="checkbox" id="check5" onclick="event.stopPropagation(); toggleCheck(document.getElementById('check5').closest('.agreement-check-item'), 'check5')">
                        <label for="check5"><strong>D.E.T is result oriented</strong>, so it is its results ONLY that I am assigned to market as an affiliate.</label>
                    </div>

                    <div class="agreement-check-item" onclick="toggleCheck(this, 'check6')">
                        <input type="checkbox" id="check6" onclick="event.stopPropagation(); toggleCheck(document.getElementById('check6').closest('.agreement-check-item'), 'check6')">
                        <label for="check6">D.E.T is <strong>"NOT an Advisory Institution"</strong>.</label>
                    </div>

                    <div class="agreement-check-item" onclick="toggleCheck(this, 'check7')">
                        <input type="checkbox" id="check7" onclick="event.stopPropagation(); toggleCheck(document.getElementById('check7').closest('.agreement-check-item'), 'check7')">
                        <label for="check7">D.E.T is <strong>"NOT an Investment Institution"</strong>.</label>
                    </div>

                    <div class="agreement-check-item" onclick="toggleCheck(this, 'check8')">
                        <input type="checkbox" id="check8" onclick="event.stopPropagation(); toggleCheck(document.getElementById('check8').closest('.agreement-check-item'), 'check8')">
                        <label for="check8">D.E.T is <strong>"NOT an Investment Advisor"</strong>.</label>
                    </div>

                    <div class="agreement-check-item" onclick="toggleCheck(this, 'check9')">
                        <input type="checkbox" id="check9" onclick="event.stopPropagation(); toggleCheck(document.getElementById('check9').closest('.agreement-check-item'), 'check9')">
                        <label for="check9">D.E.T offers <strong>"NO Guarantees"</strong> — and as an affiliate I will do the same.</label>
                    </div>
                </div>

                <!-- ===== STEP 2: FULL AFFILIATE AGREEMENT ===== -->
                <div id="agreementSection" style="display: none;">
                    <p class="fw-bold text-white mb-3" style="font-size: 13px;">
                        <i class="bi bi-journal-text me-2" style="color: var(--det-green);"></i>D.E.T Affiliate Agreement — Version 1.0
                    </p>

                    <div class="affiliate-agreement-box">
                        <h6>D.E.T AFFILIATE AGREEMENT</h6>
                        <p><strong>Version 1.0 — LOCKED</strong></p>
                        <p><strong>Effective Date:</strong> Upon Acceptance</p>
                        
                        <h6>1. Introduction</h6>
                        <p>Welcome to the D.E.T Affiliate Programme. This Agreement governs your participation as an authorised D.E.T Affiliate. By accepting this Agreement and activating your affiliate account, you agree to comply with all terms contained herein.</p>
                        
                        <h6>2. Affiliate Appointment</h6>
                        <p>Upon approval, D.E.T grants you a non-exclusive, revocable licence to promote D.E.T using your assigned affiliate link. Participation does not create employment, partnership, agency or ownership in D.E.T.</p>
                        
                        <h6>3. Marketing Standards</h6>
                        <p>Affiliates shall promote D.E.T truthfully, professionally and ethically. You may explain D.E.T's features, philosophy and publicly available information. You shall not alter, distort or misrepresent official D.E.T material.</p>
                        
                        <h6>4. Prohibited Conduct</h6>
                        <p>The following are strictly prohibited:</p>
                        <p>• Guaranteeing profits<br>• Guaranteeing returns<br>• Promising risk-free trading<br>• Claiming D.E.T cannot lose<br>• Making false or misleading statements<br>• Using fake testimonials<br>• Using manipulated screenshots<br>• Impersonating D.E.T employees<br>• Claiming to represent D.E.T without authorisation<br>• Publishing defamatory or illegal content<br>• Spamming<br>• Misleading advertising<br>• Creating fake urgency<br>• Using deceptive sales tactics<br>• Purchasing referrals using fraudulent methods</p>
                        
                        <h6>5. No Guarantees</h6>
                        <p>D.E.T does not guarantee profits. D.E.T does not guarantee financial success. Trading involves substantial risk. Past performance does not guarantee future results. Affiliates shall never communicate otherwise.</p>
                        
                        <h6>6. Independent Responsibility</h6>
                        <p>Affiliates act independently. Statements made by affiliates are their own responsibility. D.E.T shall not be liable for unauthorised promises, guarantees or representations made by affiliates.</p>
                        
                        <h6>7. Intellectual Property</h6>
                        <p>The D.E.T name, logo, branding, posters, website content, videos and marketing materials remain the exclusive property of D.E.T. Affiliates may use approved materials only. Modification of official branding requires written approval.</p>
                        
                        <h6>8. Affiliate Commissions</h6>
                        <p>Commission is earned only from valid qualifying registrations and successful payments recorded by D.E.T. Commission is calculated solely from official D.E.T records. D.E.T reserves the right to investigate suspicious referrals before releasing commission.</p>
                        
                        <h6>9. Commission Suspension & Enforcement</h6>
                        <p>Where this Agreement is breached, D.E.T may apply one or more of the following actions:</p>
                        <p><strong>Level 1 — Warning:</strong> Written warning. Education provided. Affiliate remains active.</p>
                        <p><strong>Level 2 — Temporary Commission Hold:</strong> Affiliate remains active. Commission payments temporarily suspended pending investigation.</p>
                        <p><strong>Level 3 — Temporary Suspension:</strong> Affiliate account suspended. Affiliate links disabled. Commission frozen until investigation concludes.</p>
                        <p><strong>Level 4 — Suspension With Commission Preserved:</strong> Affiliate account suspended. Affiliate links disabled. Previously earned legitimate commissions remain payable after investigation. No new commissions accumulate during suspension.</p>
                        <p><strong>Level 5 — Suspension Without Commission:</strong> Affiliate suspended. Affiliate links disabled. Pending commission forfeited where obtained through misconduct.</p>
                        <p><strong>Level 6 — Permanent Ban:</strong> Affiliate account permanently terminated. Affiliate links revoked. Future participation prohibited.</p>
                        <p><strong>Level 7 — Permanent Ban With Commission Revocation:</strong> Affiliate account terminated. Affiliate links permanently disabled. Pending commissions cancelled. Future commissions forfeited. Where fraud is involved, D.E.T reserves the right to recover amounts already paid where permitted by law.</p>
                        
                        <h6>10. Fraud</h6>
                        <p>Fraud includes, but is not limited to: Fake registrations. Self-referrals intended to manipulate commissions. Identity fraud. Payment fraud. Artificial traffic. Automated registrations. Document falsification. Commission manipulation. Fraud may result in immediate termination.</p>
                        
                        <h6>11. Affiliate Link Validity</h6>
                        <p>Affiliate links issued under this Agreement shall expire automatically on 2 April 2030. Following expiry, D.E.T shall communicate future affiliate programme arrangements in due course.</p>
                        
                        <h6>12. Limitation of Liability</h6>
                        <p>D.E.T shall not be responsible for: Trading losses. Investment decisions. Affiliate business expenses. Loss of income. Indirect or consequential damages arising from affiliate activities.</p>
                        
                        <h6>13. Compliance</h6>
                        <p>Affiliates agree to comply with all applicable laws, regulations and advertising standards within their respective jurisdictions.</p>
                        
                        <h6>14. Modification</h6>
                        <p>D.E.T reserves the right to amend this Agreement where necessary. Updated terms become effective upon publication. Continued participation constitutes acceptance of revised terms.</p>
                        
                        <h6>15. Termination</h6>
                        <p>Either party may terminate participation at any time. Termination does not affect rights or obligations accrued before termination.</p>
                        
                        <h6>16. Governing Principle</h6>
                        <p>D.E.T grows through integrity—not exaggerated promises. Our reputation is built on results, transparency and responsible representation.</p>
                        
                        <div class="section-title-agreement">AFFILIATE DECLARATION</div>
                        <p>By accepting this Agreement, I confirm that:</p>
                        <p>• I have read and understood these terms.<br>• I will not make guarantees or false promises.<br>• I will market D.E.T honestly and professionally.<br>• I understand that breaches may result in suspension, commission withholding or permanent removal from the Affiliate Programme.</p>
                        
                        <div class="section-title-agreement">D.E.T AFFILIATE CODE OF CONDUCT</div>
                        <p>Every D.E.T Affiliate represents not only themselves, but also the reputation of the D.E.T brand. Affiliates are therefore expected to conduct themselves with professionalism, honesty and integrity at all times.</p>
                        <p>As a D.E.T Affiliate, you agree to:</p>
                        <p><strong>1. Represent D.E.T Truthfully</strong> — Present D.E.T accurately and only use information officially published or approved by D.E.T.</p>
                        <p><strong>2. Never Make Guarantees</strong> — Never promise profits, guaranteed returns, risk-free trading, fixed income, or any outcome that D.E.T has not expressly stated.</p>
                        <p><strong>3. Market with Integrity</strong> — Avoid misleading, deceptive, aggressive or unethical marketing practices. Allow prospective participants to make informed decisions without pressure.</p>
                        <p><strong>4. Respect Applicable Laws</strong> — Comply with all applicable advertising, consumer protection, financial promotion and data privacy laws within your country or region.</p>
                        <p><strong>5. Protect the D.E.T Brand</strong> — Use only authorised logos, branding, marketing materials and affiliate resources. Do not alter or misuse D.E.T intellectual property without written approval.</p>
                        <p><strong>6. Respect Others</strong> — Do not make false, defamatory or misleading statements about competitors, brokers, exchanges, institutions or other affiliates.</p>
                        <p><strong>7. Maintain Professional Communication</strong> — Conduct yourself respectfully in all online and offline communications, including social media, messaging platforms, seminars and public presentations.</p>
                        <p><strong>8. Protect Confidential Information</strong> — Do not disclose confidential business information, internal documents, pricing strategies, technical information or non-public developments without written authorisation.</p>
                        <p><strong>9. Report Misconduct</strong> — Promptly report any suspected fraud, misuse of the affiliate programme, unauthorised representations or activities that could damage the integrity of D.E.T.</p>
                        <p><strong>10. Protect the Reputation of D.E.T</strong> — Every action you take reflects upon the D.E.T community. Affiliates are expected to uphold the highest standards of professionalism, ethics and responsible conduct.</p>
                        
                        <div class="section-title-agreement">GUIDING PRINCIPLE</div>
                        <p style="text-align: center;"><strong>Our marketing is built on credibility—not exaggeration.<br>Our reputation is built on RESULTS—not promises.</strong></p>
                        <p style="text-align: center; color: #ef4444;">Failure to comply with this Code of Conduct may result in warnings, suspension, withholding of commissions, termination of affiliate status, or any other enforcement action provided for under the D.E.T Affiliate Agreement.</p>
                    </div>

                    <div class="form-check mt-3 d-flex align-items-start gap-2 text-start">
                        <input class="form-check-input mt-1" type="checkbox" id="finalAgreementCheck">
                        <label class="form-check-label text-white small" for="finalAgreementCheck" style="cursor: pointer;">
                            <strong>☐ I ACCEPT THE D.E.T AFFILIATE AGREEMENT</strong>
                        </label>
                    </div>
                </div>

            </div>
            <div class="modal-footer" style="border-top: 1px solid rgba(255,255,255,0.05);">
                <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn-det-modal" id="agreeProceedBtn" disabled onclick="handleAgreementProceed()">
                    Review All Clauses <i class="bi bi-arrow-right ms-1"></i>
                </button>
                <a href="/login?redirect=affiliate" id="finalLoginLink" class="btn-det-modal" style="display: none; text-decoration: none;">
                    <i class="bi bi-check-circle me-1"></i> I Agree — Proceed to Login
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    const allChecks = ['check1', 'check2', 'check3', 'check4', 'check5', 'check6', 'check7', 'check8', 'check9'];
    let currentStep = 1;

    function toggleCheck(element, checkId) {
        const checkbox = document.getElementById(checkId);
        checkbox.checked = !checkbox.checked;
        
        if (checkbox.checked) {
            element.classList.add('checked');
        } else {
            element.classList.remove('checked');
        }
        
        updateProceedButton();
    }

    function updateProceedButton() {
        const allChecked = allChecks.every(id => document.getElementById(id).checked);
        const btn = document.getElementById('agreeProceedBtn');
        const finalCheck = document.getElementById('finalAgreementCheck');
        
        if (currentStep === 1) {
            btn.disabled = !allChecked;
            btn.innerHTML = allChecked ? 
                'Continue to Agreement <i class="bi bi-arrow-right ms-1"></i>' : 
                'Review All Clauses <i class="bi bi-arrow-right ms-1"></i>';
        } else {
            btn.style.display = 'none';
            const finalLink = document.getElementById('finalLoginLink');
            if (finalCheck) {
                finalCheck.addEventListener('change', function() {
                    finalLink.style.display = this.checked ? 'inline-block' : 'none';
                });
            }
        }
    }

    function handleAgreementProceed() {
        if (currentStep === 1) {
            document.getElementById('clausesSection').style.display = 'none';
            document.getElementById('agreementSection').style.display = 'block';
            document.getElementById('step1').classList.add('done');
            document.getElementById('step2').classList.add('active');
            document.getElementById('stepLabel').innerText = 'Step 2: Review Full Agreement';
            
            document.getElementById('agreeProceedBtn').style.display = 'none';
            document.getElementById('finalLoginLink').style.display = 'none';
            
            currentStep = 2;
            
            const finalCheck = document.getElementById('finalAgreementCheck');
            finalCheck.addEventListener('change', function() {
                document.getElementById('finalLoginLink').style.display = this.checked ? 'inline-block' : 'none';
            });
        }
    }

    document.getElementById('affiliateAgreementModal').addEventListener('show.bs.modal', function() {
        allChecks.forEach(id => {
            document.getElementById(id).checked = false;
            document.getElementById(id).closest('.agreement-check-item').classList.remove('checked');
        });
        document.getElementById('finalAgreementCheck').checked = false;
        document.getElementById('clausesSection').style.display = 'block';
        document.getElementById('agreementSection').style.display = 'none';
        document.getElementById('agreeProceedBtn').style.display = 'inline-block';
        document.getElementById('agreeProceedBtn').disabled = true;
        document.getElementById('finalLoginLink').style.display = 'none';
        document.getElementById('step1').classList.add('active');
        document.getElementById('step1').classList.remove('done');
        document.getElementById('step2').classList.remove('active');
        document.getElementById('stepLabel').innerText = 'Step 1: Accept Affiliate Clauses';
        currentStep = 1;
    });
</script>

