<%- include('partials/header', { title: 'Affiliate Program | D.E.T System', page: 'affiliate' }) %>

<style>
    .affiliate-hero {
        background: linear-gradient(135deg, rgba(176,191,150,0.1) 0%, rgba(50,44,44,0.5) 100%);
        border: 1px solid var(--det-border);
        border-radius: 16px;
        padding: 50px 30px;
        text-align: center;
        margin-bottom: 40px;
    }
    .commission-card {
        background: var(--det-card);
        border: 1px solid var(--det-border);
        border-radius: 12px;
        padding: 30px;
        text-align: center;
        height: 100%;
    }
    .commission-badge {
        font-size: 48px;
        font-weight: 800;
        color: var(--det-green);
    }
    .step-card {
        background: var(--det-card);
        border: 1px solid var(--det-border);
        border-radius: 12px;
        padding: 25px;
        text-align: center;
        height: 100%;
        position: relative;
    }
    .step-number {
        width: 40px;
        height: 40px;
        background: var(--det-green);
        color: var(--det-dark);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 18px;
        margin: 0 auto 15px;
    }
    .btn-affiliate {
        background: var(--det-green);
        color: var(--det-dark);
        font-weight: 700;
        padding: 14px 30px;
        border-radius: 10px;
        font-size: 16px;
        transition: all 0.3s;
        border: none;
        display: inline-block;
        text-decoration: none;
        cursor: pointer;
    }
    .btn-affiliate:hover {
        background: var(--det-green-hover);
        transform: translateY(-2px);
        color: #000;
    }
    .tier-payout {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .tier-payout:last-child {
        border-bottom: none;
    }
    
    /* Already Affiliate Card */
    .already-affiliate {
        background: rgba(176,191,150,0.08);
        border: 1px solid rgba(176,191,150,0.25);
        border-radius: 14px;
        padding: 40px;
        text-align: center;
    }

    /* Agreement Modal Styles */
    .agreement-check-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 14px 16px;
        background: rgba(0,0,0,0.2);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 10px;
        margin-bottom: 10px;
        transition: all 0.2s;
        cursor: pointer;
    }
    .agreement-check-item:hover {
        border-color: rgba(176,191,150,0.3);
        background: rgba(176,191,150,0.03);
    }
    .agreement-check-item.checked {
        border-color: rgba(176,191,150,0.4);
        background: rgba(176,191,150,0.06);
    }
    .agreement-check-item input[type="checkbox"] {
        margin-top: 2px;
        width: 18px;
        height: 18px;
        accent-color: var(--det-green);
        flex-shrink: 0;
    }
    .agreement-check-item label {
        font-size: 13px;
        color: #cbd5e1;
        cursor: pointer;
        line-height: 1.5;
        user-select: none;
    }
    .agreement-check-item.checked label {
        color: #fff;
    }
    
    .affiliate-agreement-box {
        background: var(--det-dark);
        border: 1px solid var(--det-border);
        border-radius: 10px;
        padding: 20px;
        height: 200px;
        overflow-y: auto;
        font-size: 12px;
        color: #cbd5e1;
        line-height: 1.7;
        margin-bottom: 20px;
        text-align: left;
    }
    .affiliate-agreement-box::-webkit-scrollbar {
        width: 5px;
    }
    .affiliate-agreement-box::-webkit-scrollbar-thumb {
        background: var(--det-border);
        border-radius: 4px;
    }
    .affiliate-agreement-box h6 {
        color: var(--det-green);
        font-weight: 700;
        font-size: 13px;
        margin-top: 12px;
        margin-bottom: 6px;
    }
    .affiliate-agreement-box h6:first-child {
        margin-top: 0;
    }

    .agreement-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 20px 0;
        color: #64748b;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
    }
    .agreement-divider::before,
    .agreement-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--det-border);
    }

    .progress-steps {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-bottom: 20px;
    }
    .progress-step {
        width: 30px;
        height: 4px;
        border-radius: 2px;
        background: #475569;
        transition: background 0.3s;
    }
    .progress-step.active {
        background: var(--det-green);
    }
    .progress-step.done {
        background: var(--det-green);
    }
</style>

<div class="container" style="max-width: 1000px; margin-top: 30px; margin-bottom: 60px;">

    <% if(isAffiliate && affiliate) { %>
        <!-- ===== ALREADY AN AFFILIATE ===== -->
        <div class="already-affiliate mb-5">
            <div style="font-size: 50px; margin-bottom: 15px;">🎯</div>
            <h2 class="fw-bold mb-2">You're Already an Affiliate!</h2>
            <p style="color: #cbd5e1; font-size: 16px; margin-bottom: 20px;">
                You joined on <%= new Date(affiliate.joinedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
            </p>
            
            <div class="row g-3 mb-4">
                <div class="col-4">
                    <div style="background: var(--det-dark); border-radius: 8px; padding: 15px;">
                        <div style="font-size: 22px; font-weight: 800; color: var(--det-green);"><%= affiliate.totalClicks.toLocaleString() %></div>
                        <div style="font-size: 11px; color: #94a3b8; text-transform: uppercase;">Clicks</div>
                    </div>
                </div>
                <div class="col-4">
                    <div style="background: var(--det-dark); border-radius: 8px; padding: 15px;">
                        <div style="font-size: 22px; font-weight: 800; color: var(--det-green);"><%= affiliate.totalReferrals %></div>
                        <div style="font-size: 11px; color: #94a3b8; text-transform: uppercase;">Referrals</div>
                    </div>
                </div>
                <div class="col-4">
                    <div style="background: var(--det-dark); border-radius: 8px; padding: 15px;">
