<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <!-- Intelligent Title Injection -->
    <title><%= typeof title !== 'undefined' ? title : 'D.E.T System | Institutional Trading' %></title>
    
    <!-- Global Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* =========================================
           GLOBAL CSS VARIABLES & BASE STYLES
        ========================================= */
        :root { 
            --det-green: #B0BF96; 
            --det-green-hover: #96a67c; 
            --det-dark: #1a1818; 
            --det-card: #322C2C; 
            --det-border: rgba(176, 191, 150, 0.25); 
        }
        body { 
            background-color: var(--det-dark); 
            font-family: 'Poppins', sans-serif; 
            color: #ffffff; 
            padding-top: 100px; 
            margin: 0; 
            min-height: 100vh; 
            display: flex; 
            flex-direction: column; 
            overflow-x: hidden; 
        }
        p, span, div, h1, h2, h3, h4, h5, h6, label { color: #f8fafc; }
        .text-muted { color: #cbd5e1 !important; } 
        .text-secondary { color: #e2e8f0 !important; } 
        .text-accent { color: var(--det-green) !important; }
        a { text-decoration: none; }
        
        /* =========================================
           INTELLIGENT NAVBAR
        ========================================= */
        .custom-navbar { 
            background-color: var(--det-card); position: fixed; top: 0; left: 0; width: 100%; 
            z-index: 1000; box-shadow: 0 2px 15px rgba(0,0,0,0.5); padding: 12px 0; border-bottom: 1px solid var(--det-border); 
        }
        .nav-container { display: flex; justify-content: space-between; align-items: center; max-width: 1200px; margin: 0 auto; padding: 0 20px; }
        
        /* The Perfect Logo Crop Fix */
        .nav-logo-img { 
            height: 75px; 
            width: 150px; 
            object-fit: cover; 
            object-position: center 44%; 
            border-radius: 4px; 
            transition: transform 0.3s; 
        }
        .nav-logo-img:hover { transform: scale(1.05); }
        
        .nav-menu { display: flex; list-style: none; margin: 0; padding: 0; gap: 25px; align-items: center; }
        .nav-menu li a { 
            color: #ffffff !important; text-decoration: none; font-size: 13px; font-weight: 500; 
            transition: color 0.3s; text-transform: uppercase; letter-spacing: 0.5px; 
        }
        
        /* Active Page Indicator */
        .nav-menu li a:hover, .nav-menu li a.active { color: var(--det-green) !important; }
        
        .nav-btn { 
            background: var(--det-green); color: var(--det-dark) !important; padding: 8px 18px; 
            border-radius: 6px; font-weight: 700 !important; transition: all 0.3s ease; border: none; 
        }
        .nav-btn:hover { background: var(--det-green-hover); transform: translateY(-2px); color: #000 !important; }
        
        .mobile-toggle { display: none; color: #ffffff; font-size: 28px; cursor: pointer; user-select: none; }
        @media (max-width: 991px) {
            .nav-menu { 
                display: none; flex-direction: column; position: absolute; top: 100%; left: 0; width: 100%; 
                background-color: var(--det-card); padding: 20px 0; box-shadow: 0 10px 15px rgba(0,0,0,0.5); text-align: center; 
            }
            .nav-menu.active { display: flex; }
            .nav-menu li { padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
            .mobile-toggle { display: block; }
        }
    </style>
</head>
<body>
<% if(typeof hideNav === 'undefined' || !hideNav) { %>
<header class="custom-navbar">
    <div class="nav-container">
        <a href="/" class="logo-link">
            <img src="/images/WhatsApp Image 2026-07-06 at 10.05.15.jpeg" alt="D.E.T System" class="nav-logo-img">
        </a>
        <div class="mobile-toggle" id="mobile-toggle">☰</div>
        <ul class="nav-menu" id="nav-menu">
            <li><a href="/training" class="<%= typeof page !== 'undefined' && page === 'training' ? 'active' : '' %>">D.E.T Training</a></li>
            <li><a href="/pricing" class="<%= typeof page !== 'undefined' && page === 'pricing' ? 'active' : '' %>">Activation Pricing</a></li>
            <li><a href="/affiliate" class="<%= typeof page !== 'undefined' && page === 'affiliate' ? 'active' : '' %>">Become an Affiliate</a></li>
            <li><a href="/download/ea-client" download="DET_Smart_Client_v2.ex5" style="color: var(--det-green) !important;"><i class="bi bi-download me-1"></i> Download EA</a></li>
            <% if(typeof currentUser !== 'undefined' && currentUser) { %>
                <li><a href="/dashboard" class="nav-btn">Client Portal</a></li>
            <% } else { %>
                <li><a href="/login" class="nav-btn">Client Login</a></li>
            <% } %>
        </ul>
    </div>
</header>
<% } %>