<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><%= typeof title !== 'undefined' ? title : 'D.E.T System | Institutional Trading' %></title>
    
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root { 
            --det-green: #B0BF96; 
            --det-green-hover: #96a67c; 
            --det-dark: #1a1818; 
            --det-card: #322C2C; 
            --det-border: rgba(176, 191, 150, 0.25); 
        }
        body { 
            background-color: var(--det-dark); 
            font-family: 'Poppins', sans-serif; 
            color: #ffffff; 
            padding-top: 100px; 
            margin: 0; 
            min-height: 100vh; 
            display: flex; 
            flex-direction: column; 
            overflow-x: hidden; 
        }
        p, span, div, h1, h2, h3, h4, h5, h6, label { color: #f8fafc; }
        .text-muted { color: #cbd5e1 !important; } 
        .text-accent { color: var(--det-green) !important; }
        a { text-decoration: none; }
        
        /* Flash Messages */
        .flash-messages-container {
            position: fixed;
            top: 110px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 9999;
            width: 90%;
            max-width: 600px;
        }
        .flash-alert {
            padding: 15px 20px;
            border-radius: 8px;
            margin-bottom: 10px;
            font-size: 14px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            animation: slideDown 0.3s ease-out;
            background: var(--det-card);
        }
        .flash-alert i { font-size: 18px; flex-shrink: 0; }
        .flash-success { border: 1px solid var(--det-green); color: var(--det-green); }
        .flash-success i { color: var(--det-green); }
        .flash-error { border: 1px solid #ef4444; color: #fca5a5; }
        .flash-error i { color: #ef4444; }
        @keyframes slideDown {
            from { opacity: 0; transform: translateX(-50%) translateY(-20px); }
            to { opacity: 1; transform: translateX(-50%) translateY(0); }
        }
        .flash-close {
            margin-left: auto;
            cursor: pointer;
            opacity: 0.7;
            background: none;
            border: none;
            color: inherit;
            font-size: 18px;
            padding: 0 5px;
        }
        .flash-close:hover { opacity: 1; }
        
        /* Navbar */
        .custom-navbar { 
            background-color: var(--det-card); 
            position: fixed; 
            top: 0; 
            left: 0; 
            width: 100%; 
            z-index: 1000; 
            box-shadow: 0 2px 15px rgba(0,0,0,0.5); 
            padding: 12px 0; 
            border-bottom: 1px solid var(--det-border); 
        }
        .nav-container { 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            max-width: 1200px; 
            margin: 0 auto; 
            padding: 0 20px;
            position: relative;
        }
        .nav-logo-img { 
            height: 75px; 
            width: 300px; 
            object-fit: cover; 
            object-position: center 44%; 
            border-radius: 4px; 
        }
        .nav-logo-img:hover { transform: scale(1.05); }
        
        /* Desktop Nav */
        .nav-menu { 
            display: flex; 
            list-style: none; 
            margin: 0; 
            padding: 0; 
            gap: 25px; 
            align-items: center; 
        }
        .nav-menu li { list-style: none; }
        .nav-menu li a { 
            color: #ffffff; 
            text-decoration: none; 
            font-size: 13px; 
            font-weight: 500; 
            transition: color 0.3s; 
            text-transform: uppercase; 
            letter-spacing: 0.5px; 
            white-space: nowrap;
            display: block;
        }
        .nav-menu li a:hover, 
        .nav-menu li a.active { color: var(--det-green) !important; }
        
        .nav-btn { 
            background: var(--det-green) !important; 
            color: var(--det-dark) !important; 
            padding: 8px 18px !important; 
            border-radius: 6px; 
            font-weight: 700 !important; 
            transition: all 0.3s ease; 
        }
        .nav-btn:hover { 
            background: var(--det-green-hover) !important; 
            transform: translateY(-2px); 
        }
        
        /* User Dropdown */
        .user-dropdown { position: relative; }
        .user-dropdown-toggle {
            color: #ffffff !important;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
            font-size: 13px;
            text-transform: none !important;
        }
        .dropdown-arrow {
            font-size: 10px;
            transition: transform 0.2s;
            display: inline-block;
        }
        .user-dropdown.open .dropdown-arrow {
            transform: rotate(180deg);
        }
        .user-dropdown-menu {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            margin-top: 10px;
            background: var(--det-card);
            border: 1px solid var(--det-border);
            border-radius: 8px;
            min-width: 200px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            z-index: 1000;
            padding: 5px 0;
        }
        .user-dropdown.open .user-dropdown-menu {
            display: block;
        }
        .user-dropdown-menu a {
            display: flex !important;
            align-items: center;
            gap: 10px;
            padding: 12px 18px !important;
            color: #cbd5e1 !important;
            font-size: 13px !important;
            transition: all 0.2s;
            text-transform: none !important;
            letter-spacing: normal !important;
        }
        .user-dropdown-menu a:hover {
            background: rgba(176, 191, 150, 0.1);
            color: #fff !important;
        }
        .dropdown-divider {
            border-top: 1px solid rgba(255,255,255,0.05);
            margin: 5px 0;
        }
        
        /* Mobile Toggle Button */
        .mobile-toggle { 
            display: none; 
            color: #ffffff; 
            font-size: 28px; 
            cursor: pointer; 
            background: none;
            border: none;
            padding: 10px;
            z-index: 1001;
            line-height: 1;
        }
        
        /* Mobile Styles */
        @media (max-width: 991px) {
            .mobile-toggle { display: block; }
            
            .nav-menu { 
                display: none; 
                flex-direction: column; 
                position: absolute; 
                top: 100%; 
                left: 0; 
                width: 100%; 
                background-color: var(--det-card); 
                padding: 10px 0 20px; 
                box-shadow: 0 10px 15px rgba(0,0,0,0.5); 
                text-align: center;
                border-bottom: 2px solid var(--det-border);
                margin-top: 12px;
                z-index: 1000;
                max-height: 80vh;
                overflow-y: auto;
            }
            .nav-menu.show { display: flex !important; }
            .nav-menu li { 
                padding: 12px 20px; 
                border-bottom: 1px solid rgba(255,255,255,0.05);
                width: 100%;
            }
            .nav-menu li:last-child { border-bottom: none; }
            
            /* Mobile Dropdown */
            .user-dropdown { width: 100%; }
            .user-dropdown-toggle {
                justify-content: center;
                padding: 12px 20px;
            }
            .user-dropdown-menu {
                position: static;
                border: none;
                box-shadow: none;
                margin-top: 0;
                background: rgba(0,0,0,0.2);
                border-radius: 0;
            }
            .user-dropdown-menu a {
                justify-content: center;
                padding: 14px 18px !important;
            }
        }
    </style>
</head>
<body>

<% if(typeof hideNav === 'undefined' || !hideNav) { %>
<header class="custom-navbar">
    <div class="nav-container">
        <a href="/pricing" class="logo-link">
            <img src="/images/WhatsApp Image 2026-07-28 at 15.45.03.jpeg" alt="D.E.T System" class="nav-logo-img">
        </a>
        
        <!-- Hamburger Button -->
        <button class="mobile-toggle" id="mobileToggle" aria-label="Menu">☰</button>
        
        <ul class="nav-menu" id="navMenu">
            <li><a href="/how-it-works" class="<%= typeof page !== 'undefined' && page === 'how-it-works' ? 'active' : '' %>">How D.E.T Works</a></li>
            <li><a href="/training" class="<%= typeof page !== 'undefined' && page === 'training' ? 'active' : '' %>">D.E.T Training</a></li>
            <li><a href="/pricing" class="<%= typeof page !== 'undefined' && page === 'pricing' ? 'active' : '' %>">D.E.T Payment Tiers</a></li>
            <li><a href="/affiliate" class="<%= typeof page !== 'undefined' && page === 'affiliate' ? 'active' : '' %>">Become an Affiliate</a></li>
          
            
            <% if(typeof currentUser !== 'undefined' && currentUser) { %>
                <li class="user-dropdown" id="userDropdown">
                    <a href="javascript:void(0)" class="user-dropdown-toggle" id="dropdownToggle">
                        <i class="bi bi-person-circle"></i>
                        <%= currentUser.username %>
                        <span class="dropdown-arrow">▼</span>
                    </a>
             

                    <!-- In the user dropdown menu, add this link -->
                    <div class="user-dropdown-menu">
                        <a href="/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
                        <a href="/affiliate/dashboard"><i class="bi bi-diagram-3"></i> Affiliate Hub</a>  <!-- ADD THIS LINE -->
                        <a href="/pricing"><i class="bi bi-cart-plus"></i> Upgrade Plan</a>
                        <div class="dropdown-divider"></div>
                        <a href="/logout" style="color: #fca5a5 !important;"><i class="bi bi-box-arrow-right"></i> Logout</a>
                    </div>
                </li>
            <% } else { %>
                <li><a href="/login" class="<%= typeof page !== 'undefined' && page === 'login' ? 'active' : '' %>">Login</a></li>
                <li><a href="/register" class="nav-btn">Register</a></li>
            <% } %>
        </ul>
    </div>
</header>

<!-- Flash Messages -->
<!-- Flash Messages -->
<div class="flash-messages-container">
    <% if(typeof success !== 'undefined' && success && success.length > 0) { %>
        <% success.forEach(function(msg) { %>
        <div class="flash-alert flash-success">
            <i class="bi bi-check-circle-fill"></i>
            <span><%= msg %></span>
            <button class="flash-close" onclick="this.parentElement.remove()">×</button>
        </div>
        <% }); %>
    <% } %>
    <% if(typeof error !== 'undefined' && error && error.length > 0) { %>
        <% error.forEach(function(msg) { %>
        <div class="flash-alert flash-error">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span><%= msg %></span>
            <button class="flash-close" onclick="this.parentElement.remove()">×</button>
        </div>
        <% }); %>
    <% } %>
</div>

<!-- SIMPLE INLINE SCRIPT - NO CONFLICTS -->
<script>
// Simple, clean mobile menu - no IIFE, no conflicts
var mobileToggle = document.getElementById('mobileToggle');
var navMenu = document.getElementById('navMenu');
var userDropdown = document.getElementById('userDropdown');
var dropdownToggle = document.getElementById('dropdownToggle');

// 1. HAMBURGER TOGGLE
if (mobileToggle && navMenu) {
    mobileToggle.onclick = function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        if (navMenu.classList.contains('show')) {
            navMenu.classList.remove('show');
            mobileToggle.innerHTML = '☰';
        } else {
            navMenu.classList.add('show');
            mobileToggle.innerHTML = '✕';
        }
    };
}

// 2. CLOSE MENU WHEN CLICKING OUTSIDE
document.onclick = function(e) {
    if (navMenu && mobileToggle) {
        if (!navMenu.contains(e.target) && e.target !== mobileToggle) {
            navMenu.classList.remove('show');
            mobileToggle.innerHTML = '☰';
        }
    }
    // Also close dropdown
    if (userDropdown) {
        if (!userDropdown.contains(e.target)) {
            userDropdown.classList.remove('open');
        }
    }
};

// 3. USER DROPDOWN TOGGLE
if (dropdownToggle && userDropdown) {
    dropdownToggle.onclick = function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        if (userDropdown.classList.contains('open')) {
            userDropdown.classList.remove('open');
        } else {
            userDropdown.classList.add('open');
        }
    };
}

// 4. AUTO-DISMISS FLASH MESSAGES
var flashes = document.querySelectorAll('.flash-alert');
for (var i = 0; i < flashes.length; i++) {
    (function(flash) {
        setTimeout(function() {
            flash.style.opacity = '0';
            flash.style.transition = 'opacity 0.5s';
            setTimeout(function() {
                if (flash.parentNode) flash.remove();
            }, 500);
        }, 5000);
    })(flashes[i]);
}
</script>

<% } %>